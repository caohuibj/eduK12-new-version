{
  "name": "Huisurvey Phase 0 Performance Lab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/grafana/devcontainer-features/k6:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    3000,
    5173
  ],
  "portsAttributes": {
    "3000": {
      "label": "Huisurvey API",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "Huisurvey frontend",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "PERF_CAPACITY_QUALIFIED": "0"
  },
  "postCreateCommand": "node --version && npm --version && k6 version && docker version"
}
