{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pretypecheck": "npm run inventory:product-ui:check && node ../e2e/validate-session-auth-gates.cjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.cognitive.json --noEmit",
    "test": "vitest run --maxWorkers=2",
    "test:cognitive": "vitest run src/modules/cognitive src/modules/reporting src/modules/composite src/pages/teacher",
    "test:composite": "vitest run src/modules/composite src/pages/teacher src/pages/student",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "bash /opt/ptool/scripts/deploy.sh frontend",
    "inventory:product-ui": "node scripts/product-route-inventory.mjs",
    "inventory:product-ui:check": "node scripts/product-route-inventory.mjs --check",
    "cognitive:manifest:generate": "node ../scripts/cognitive/manifests.cjs",
    "cognitive:manifest:check": "node ../scripts/cognitive/manifests.cjs --check"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@types/hls.js": "^0.13.3",
    "antd": "^6.2.3",
    "axios": "^1.20.0",
    "dompurify": "^3.4.14",
    "echarts": "^5.6.0",
    "echarts-wordcloud": "^2.1.0",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.563.0",
    "pdfjs-dist": "^5.5.207",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "ws": "8.21.3",
    "engine.io-client": "6.6.6",
    "socket.io-parser": "4.2.7",
    "brace-expansion@^1.1.0": "1.1.21",
    "brace-expansion@^2.0.1": "2.1.7",
    "@humanfs/node": "0.16.8"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
