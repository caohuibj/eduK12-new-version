# ==========================================
# PTool 后端环境变量配置
# ==========================================

# 服务器配置
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/ptool?schema=public
# Prisma runtime pool settings; explicit DATABASE_URL query parameters take precedence.
PRISMA_CONNECTION_POOL_SIZE=10
PRISMA_POOL_TIMEOUT=30

# JWT 配置 (生产环境必须设置强密钥，至少32位)
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
# Must be a separate random secret from JWT_SECRET.
ASSET_SIGNING_SECRET=

# 数据加密配置 (生产环境必须设置，64个十六进制字符)
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# AssessmentContext 快照指纹密钥（可选；建议使用独立的 64 位十六进制密钥）。
# 未设置时使用 DATA_ENCRYPTION_KEY 派生域隔离 HMAC 密钥；不会把人口学内容直接做裸 SHA-256。
ASSESSMENT_CONTEXT_HASH_KEY=

# Cognitive 模块开关（严格 true/false；Release v1 默认开启）。
# 设为 true 时生产环境必须同时配置 DATA_PSEUDONYM_KEY；legacy-only 环境可显式设为 false。
# 路由级网关在 D3+ 接入。
COGNITIVE_MODULE_ENABLED=true
# 不可变测评制品缓存（进程内有界缓存；内容寻址键，无失效问题）。
# 开启后 START 链路复用已编译量表运行时/冻结制品与规范化哈希，省去每个学生
# 重复的编译与哈希 CPU（实测 −25% CPU/START，12 并发墙钟 −50%；发布时制品
# (#632) 落地后与 START 消费发布制品互补，仍省 −40% CPU）。
# 仅缓存按版本/摘要约束的不可变编译内容；准入结论、Attempt 字段永远不进缓存。
# 默认关闭；容量验收通过后在压测与生产环境配置开启。
ASSESSMENT_COMPILED_ARTIFACT_CACHE_ENABLED=false
ASSESSMENT_FROZEN_ARTIFACT_CACHE_ENABLED=false
# 测评存储压缩与共享（仅新问卷/新量表；系统未实际部署，无旧数据迁移）。
# ASSESSMENT_COMPACT_FACTS_ENABLED=true 后，大段 JSON 密文改用紧凑编码
#（ekc1：base64 + gzip，替代十六进制 iv:authTag:data，体积约减半且可压缩）；
# 覆盖冻结 Runtime、整卷答案、量表原始事实、Cognitive 与组合报告等写入点。
# 读侧已兼容两种格式（safeDecrypt/decryptField 先识别 ekc1 再回退十六进制），
# 关闭开关只停止新的压缩写入，不影响已写入数据的读取。
# ASSESSMENT_SHARED_RUNTIME_STORAGE_ENABLED=true 后，相同量表定义的冻结
# Runtime 只存一份到 assessment_runtime_artifacts（gzip + 哈希引用），每个
# Assessment 行只存一个约 200 字节的引用，不再为每个学生重复保存完整副本。
# 该表已有 migration（20261016090000），无需新 migration；不启用
# ASSESSMENT_SHARED_CONTROL_ENABLED（控制记录共享不在本次范围）。
ASSESSMENT_COMPACT_FACTS_ENABLED=false
ASSESSMENT_SHARED_RUNTIME_STORAGE_ENABLED=false
# Training 已登录 START 的有界准入（c150 实测：150 人×200 条目全部成功）。
# MAX_CONCURRENT 为本实例同时在飞的 START 事务数。未显式配置时默认从有效
# 连接池派生（DATABASE_URL connection_limit 优先于 PRISMA_CONNECTION_POOL_SIZE，
# 默认 10）：取池的 3/4，为其他业务预留连接；多实例部署时各实例上限之和
# 不得超过共享池容量。排队不占用数据库连接；排队满或超过 MAX_WAIT_MS
# 返回既有可重试 503 语义。下面三行是显式覆盖示例（压测验收用 24）。
# TRAINING_START_MAX_CONCURRENT=24
# TRAINING_START_MAX_QUEUE=300
# TRAINING_START_MAX_WAIT_MS=10000
# 匿名 Study join 的有界准入（2026-11-12）。单份问卷总作答不超过 500，
# 500 人同 NAT 突发时全部排进门里放行，不再当场 503。默认值：并发 8（受
# scrypt 门容量限制）、队列 500、等候 30000ms；join 排空约 6–10 秒。
# 未显式配置时，若 TRAINING_START_* 已设则继承（队列/等候分别封顶 500/30000），
# 否则用默认值。join 限流（500 次/15 分钟/IP）只豁免可重试的 STUDY_JOIN_BUSY
# 503，其他 4xx/5xx 仍占额度。下面三行是显式覆盖示例。
# STUDY_JOIN_ADMISSION_MAX_CONCURRENT=8
# STUDY_JOIN_ADMISSION_MAX_QUEUE=500
# STUDY_JOIN_ADMISSION_MAX_WAIT_MS=30000
# 匿名 START 细粒度诊断观测（2026-11-12）。默认关闭。
# 开启后记录事务连接/BEGIN 获取成功耗时（tx_acquisition_wait_ms）、
# 尚未进入事务 callback 就失败的耗时（tx_acquisition_failed_ms），以及
# Composite 准入锁获取往返耗时（composite_admission_lock_ms /
# composite_admission_lock_failed_ms：SHARE + 每参与者 advisory 锁）。
# SQL 往返不等于纯 PostgreSQL 锁等待；
# 判断真实锁竞争需结合 PG wait_event 采样。仅用于短期排障，不产生逐条
# SQL 日志，且不记录 Attempt ID、用户标识、Token、答案或数据库参数。
# 常规 5 段计时（pre_gate / gate_wait / gate_slot / tx_wall / post_gate）
# 始终开启，不受本开关影响。gate_wait 仅记录实际拿到槽位的请求；
# 等待超时和队列拒绝请配合 ptool_bounded_admission_* 计数分析。
# 匿名 START 的阶段直方图单独细分 2.5–4.5 秒，不影响其他指标分桶。
# ANONYMOUS_START_DIAGNOSTIC_ENABLED=false
# Optional 4C4G capacity-test profile (2026-11-09, #682; NOT production defaults).
# Validated only for the stated isolated 4C4G test environment and workload:
# age-free 300-item questionnaire, 200 VU including login: 199/200 completed,
# zero login 503s (baseline #680: 129/200, 71 login 503s).
# The numbers below are a coupled profile, not individually proven safe limits.
# Explicitly opt in by copying the complete set into the deployment's controlled
# environment configuration after checking DB connection budgets across replicas,
# login bcrypt CPU saturation, START/UNIT latency, report-worker load, and
# workload equivalence. Do not uncomment them in this shared .env.example.
# Pool 25 is required by the tested START 24 package; DATABASE_URL's explicit
# connection_limit takes precedence. Restart services after changing values.
# START wait was 15000ms in the full test (20000ms was prelogin-only X-07).
# PRISMA_CONNECTION_POOL_SIZE=25
# TRAINING_START_MAX_CONCURRENT=24
# TRAINING_START_MAX_QUEUE=300
# TRAINING_START_MAX_WAIT_MS=15000
# UNIT_SUBMIT_ADMISSION_LIMIT=7
# UNIT_SUBMIT_ADMISSION_QUEUE=32
# UNIT_SUBMIT_ADMISSION_TIMEOUT_MS=1500
# LOGIN_PASSWORD_MAX_CONCURRENT=8
# LOGIN_PASSWORD_WORKERS=4
# ASSESSMENT_REPORT_WORKER_CONCURRENCY=12
# ASSESSMENT_REPORT_POLL_MS=400
# 新家长关联/报告入口：验收通过后在隔离环境单独开启，默认关闭。
PARENT_PORTAL_ENABLED=false
# 材料授权。默认 true：grant 表为空时行为等于 creatorId 隔离。false 时忽略已有 grant。
MATERIAL_GRANTS_ENABLED=true
# Cognitive 参与者假名化密钥：64 位十六进制（32 字节），独立于 DATA_ENCRYPTION_KEY。
# participantKey = HMAC-SHA256(userId, DATA_PSEUDONYM_KEY)；加密密钥轮换不会改变参与者身份。
# 生成方式: openssl rand -hex 32
DATA_PSEUDONYM_KEY=

# Huischool 校园心理健康版（仅准备配置，本 PR 不开启生产入口）
# 两个密钥必须各自独立生成并放在受控的服务端环境变量中。
# 例如：openssl rand -hex 32；不要提交实际值到代码仓库或 CI。
# 学号 HMAC 索引需要稳定密钥。更换前必须先设计版本化迁移，
# 否则已有名册无法匹配；无密钥时相关注册接口应拒绝服务。
CAMPUS_ELIGIBILITY_HMAC_KEY=
# RFC6238/TOTP 密钥的 AES-256-GCM 服务端加密密钥。
# 不等同于 JWT_SECRET、DATA_ENCRYPTION_KEY 或上方学生 HMAC 密钥。
CAMPUS_MFA_ENCRYPTION_KEY=
# 仅供已经获授权的离线管理命令启用，不开启 Web 自注册管理员。
CAMPUS_BOOTSTRAP_ENABLED=false
CAMPUS_BOOTSTRAP_PRODUCTION_APPROVED=false

# 文件上传配置
UPLOAD_DIR=./uploads
ASSET_STORAGE_PROVIDER=local
# Set true only after the maintenance migration and reference/hash checks pass.
ASSET_MIGRATION_COMPLETE=false
CREDENTIAL_HANDOFF_TTL_HOURS=24
MAX_FILE_SIZE=52428800

# Anonymous check-in rate limits (each uses a 15-minute window).
# Token limits are shared by the class link; IP limits are wider for school NATs.
PUBLIC_CHECKIN_UPLOAD_IP_LIMIT=1800
PUBLIC_CHECKIN_UPLOAD_TOKEN_LIMIT=600
PUBLIC_CHECKIN_SUBMIT_IP_LIMIT=600
PUBLIC_CHECKIN_SUBMIT_TOKEN_LIMIT=120

# 管理员账号（仅由 seed 读取；创建首个管理员时必须显式设置）
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ==========================================
# COS + CDN 配置 (强烈推荐，用于视频/图片存储和加速)
# ==========================================
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
COS_BUCKET=your-bucket-name
COS_REGION=ap-guangzhou
COS_DOMAIN=https://your-cdn-domain.com

# Redis 配置 (用于视频处理队列 / Socket.IO Adapter / Bull)
# Docker 环境只使用 REDIS_URL（不再解析 REDIS_HOST/PORT，见 KI-001）
REDIS_URL=redis://localhost:6379
# Required by default in production; false is only for local/test single-process development.
SOCKET_REDIS_REQUIRED=true

# 生产环境必须显式设置为实际前端 origin（不要使用 *）
CORS_ORIGIN=https://your-frontend.example.com

# 反向代理层数：Docker/Nginx 生产拓扑通常为 1；直连后端时设为 0
TRUST_PROXY_HOPS=1

# 导出资源限制
EXPORT_MAX_RECORDS=10000
EXPORT_MAX_TRIALS=100000
EXPORT_MAX_FIELDS=2000
EXPORT_MAX_BYTES=52428800
EXPORT_RETENTION_HOURS=24
EXPORT_DIR=/app/exports

# ==========================================
# 视频处理配置 (低配服务器优化)
# ==========================================
# 硬件负担最小模式
VIDEO_LOW_POWER_MODE=true

# 视频分辨率: 480p (低配推荐) / 720p (标准) / 1080p (高清)
VIDEO_RESOLUTION=480p

# 编码速度: ultrafast(最快) / superfast / veryfast / faster / fast
VIDEO_PRESET=ultrafast

# 视频质量: 18-28，越大质量越低速度越快
VIDEO_CRF=28

# 视频码率: 800k(480p推荐) / 1200k(720p) / 2500k(1080p)
VIDEO_BITRATE=800k

# 每个 backend 进程的视频转码并发数（默认2，应用层有安全硬上限）
VIDEO_CONCURRENCY=2
# Standalone `npm start` keeps consumers in this process (dev/prod default true).
# Set false only when also running `npm run start:worker`.
# Canonical Compose API injects false; ptool-worker injects true.
# NODE_ENV=test defaults false unless this is set explicitly.
BACKGROUND_WORKERS_ENABLED=true

# 视频下载配置 (用于URL下载模式)
# 临时目录
TEMP_DIR=/tmp/videos

# 最大下载文件大小 (2GB = 2147483648)
MAX_DOWNLOAD_SIZE=2147483648

# 下载超时时间 (15分钟 = 900000毫秒)
DOWNLOAD_TIMEOUT=900000

# New REST classroom adapter; enable only after shared-runtime acceptance.
MINI_CLASSROOM_ENABLED=false

# Native FINAL_ONLY adapters; enable only in isolated acceptance until device gates pass.
MINI_ASSESSMENT_ENABLED=false

# Survey researcher realm stays off until its schema, key and tests are verified.
SURVEY_WORKSPACE_ENABLED=false
# PR3 public study mode; keep disabled until PR4 unified CI and explicit deployment approval.
SURVEY_PUBLICATION_ENABLED=false
# Dedicated Survey MFA key: exactly 64 hex digits, supplied securely in production.
SURVEY_MFA_ENCRYPTION_KEY=

# Stage PR4: researcher-only data analysis and bounded exports (off until acceptance).
SURVEY_ANALYTICS_ENABLED=false
# Simple NAT-friendly public research limit (IP-shared; Redis fail-closed).
SURVEY_PUBLIC_IP_LIMIT=5000
SURVEY_PUBLIC_WINDOW_SECONDS=900

# Huiteacher independent education identity and feature gates (default OFF).
# Only enable after current production Host/TLS, product ACL and database
# migrations pass their own reviewed and authorized release checks.
HUITEACHER_WORKSPACE_ENABLED=false
HUITEACHER_STUDENT_FEEDBACK_ENABLED=false
HUITEACHER_IMPROVEMENT_ENABLED=false

# PR1: report privacy preferences storage/UI only. Report consumers remain legacy strict.
REPORT_PRIVACY_PREFERENCES_V1_ENABLED=false

# Teacher V2 aggregate policy consumer: OFF by default and independent of Survey/School.
REPORT_PRIVACY_TEACHER_V2_ENABLED=false
# No School general resources are trusted by default; never authorize psychology by label.
REPORT_PRIVACY_SCHOOL_V2_ENABLED=false
CAMPUS_GENERAL_REPORT_APPROVED_RESOURCES=[]

# 管理入口强认证：仅示例，不自动修改真实配置或登记凭据。
ADMIN_WEBAUTHN_RP_ID=training.eduk12.top
ADMIN_WEBAUTHN_ORIGIN=https://training.eduk12.top
# Admin Authenticator: separate AES-256-GCM key (64 hex characters), never reuse Survey/data keys.
ADMIN_AUTH_ORIGIN=https://training.eduk12.top
ADMIN_MFA_ENCRYPTION_KEY=
# 后台操作开关默认关闭，只在另行授权的单次受控 CLI 进程中启用。
ADMIN_SECURITY_BOOTSTRAP_ENABLED=false
ADMIN_SECURITY_PRODUCTION_APPROVED=false
ADMIN_SECURITY_HANDOFF_FILE=
