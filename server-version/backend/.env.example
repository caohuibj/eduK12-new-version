# ==========================================
# PTool 后端环境变量配置
# ==========================================

# 服务器配置
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/ptool?schema=public

# JWT 配置 (生产环境必须设置强密钥，至少32位)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# 数据加密配置 (生产环境必须设置，64个十六进制字符)
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# ==========================================
# COS + CDN 配置 (强烈推荐，用于视频/图片存储和加速)
# ==========================================
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
COS_BUCKET=your-bucket-name
COS_REGION=ap-guangzhou
COS_DOMAIN=https://your-cdn-domain.com

# Redis 配置 (用于视频处理队列)
REDIS_URL=redis://localhost:6379

# ==========================================
# 视频处理配置 (低配服务器优化)
# ==========================================
# 硬件负担最小模式
VIDEO_LOW_POWER_MODE=true

# 视频分辨率: 480p (低配推荐) / 720p (标准) / 1080p (高清)
VIDEO_RESOLUTION=480p

# 编码速度: ultrafast(最快) / superfast / veryfast / faster / fast
VIDEO_PRESET=ultrafast

# 视频质量: 18-28，越大质量越低速度越快
VIDEO_CRF=28

# 视频码率: 800k(480p推荐) / 1200k(720p) / 2500k(1080p)
VIDEO_BITRATE=800k

# 视频下载配置 (用于URL下载模式)
# 临时目录
TEMP_DIR=/tmp/videos

# 最大下载文件大小 (2GB = 2147483648)
MAX_DOWNLOAD_SIZE=2147483648

# 下载超时时间 (15分钟 = 900000毫秒)
DOWNLOAD_TIMEOUT=900000
