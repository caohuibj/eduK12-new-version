{
  "name": "ptool-backend",
  "version": "1.0.0",
  "description": "PTool 独立服务器版本后端",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/main.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:guarded": "node scripts/pr24-migration-preflight.mjs && prisma migrate deploy",
    "db:backfill:public-tokens": "tsx src/scripts/pr27-backfill-public-access-tokens.ts",
    "db:backfill:checkin-tokens": "npm run db:backfill:public-tokens",
    "db:release:preflight": "node scripts/release-data-preflight.mjs",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "backup:db": "node ../scripts/backup/backup-db.mjs full",
    "verify:backup": "node ../scripts/backup/backup-db.mjs verify-latest",
    "restore:db": "node ../scripts/backup/restore-db.mjs",
    "smoke:restore": "node ../scripts/backup/smoke-restore.mjs",
    "generate:simulated-reference": "tsx src/modules/cognitive/reference-data/generate-simulated-reference.ts",
    "cognitive:audit": "tsx src/scripts/cognitive-audit.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/__tests__/cognitive/concurrency.integration.test.ts src/__tests__/composite/composite-analysis-snapshot.postgres.integration.test.ts src/__tests__/integration/instrument-final-submit.postgres.integration.test.ts",
    "test:integration:cognitive": "vitest run src/__tests__/cognitive/concurrency.integration.test.ts",
    "test:integration:composite": "vitest run src/__tests__/composite/composite-analysis-snapshot.postgres.integration.test.ts",
    "test:integration:instrument-final": "vitest run src/__tests__/integration/instrument-final-submit.postgres.integration.test.ts",
    "test:integration:pr26": "vitest run src/__tests__/questionnaire/aggregate-report.postgres.integration.test.ts src/__tests__/classroom/classroom-start.postgres.integration.test.ts",
    "test:integration:pr8": "vitest run src/__tests__/composite/composite-analysis-snapshot.postgres.integration.test.ts",
    "release:verify:local": "bash ../scripts/release-verify-local.sh",
    "deploy": "bash /opt/ptool/scripts/deploy.sh backend",
    "cognitive:manifest:generate": "node ../scripts/cognitive/manifests.cjs",
    "cognitive:manifest:check": "node ../scripts/cognitive/manifests.cjs --check"
  },
  "dependencies": {
    "@node-rs/jieba": "^2.0.1",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "canvas": "^3.2.1",
    "cors": "^2.8.5",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.7.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "ipaddr.js": "^1.9.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nanoid": "^3.3.17",
    "node-cache": "^5.1.2",
    "pinyin-pro": "^3.28.0",
    "proxy-addr": "^2.0.7",
    "redis": "^5.11.0",
    "sav-writer": "^1.0.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "playwright-core": "1.62.1",
    "prisma": "^5.22.0",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "fast-xml-parser": "^5.5.9",
    "body-parser": "1.20.6",
    "form-data": "4.0.6",
    "qs": "6.15.3",
    "tough-cookie": "^4.1.3",
    "uuid": "$uuid",
    "ws": "8.21.3",
    "engine.io": "6.6.9",
    "socket.io-parser": "4.2.7",
    "follow-redirects": "1.16.0",
    "lodash": "4.18.1"
  }
}
