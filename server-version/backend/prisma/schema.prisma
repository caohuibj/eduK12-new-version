  wave           SurveyWave    @relation(fields:[waveId],references:[id],onDelete:Restrict)
  participantId  String?       @map("participant_id")
  participant    SurveyParticipant? @relation(fields:[participantId],references:[id],onDelete:Restrict)
  sessionHash    String?       @map("session_hash")
  runtimeAttemptId String?     @unique @map("runtime_attempt_id")
  flowAssignmentCipher String?  @map("flow_assignment_cipher")
  contentBindingCipher String? @map("content_binding_cipher")
