  @@unique([waveId,sessionHash],map:"survey_attempts_wave_session_key")
  @@index([projectId,waveId,status],map:"survey_attempts_project_wave_status_idx")
  @@map("survey_wave_attempts")
}
model SurveyExperimentQuotaBucket {
