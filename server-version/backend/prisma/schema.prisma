// Durable, coalesced report outbox. IDs/frozen bindings only; answers stay in
// their existing encrypted canonical records. Parent deletion is reconciled by
// the worker so it cannot silently leak a held queue permit through a cascade.
enum CompositeReportJobStatus {
  PENDING
  PROCESSING
  WAITING
  READY
  FAILED
  CANCELLED
}

model CompositeReportJob {
  scaleResultFacts AssessmentResultFact[] @relation("AssessmentResultRawReceipt")
  wholeValidationEncrypted String? @map("whole_validation_encrypted")
  wholeValidationHash String? @map("whole_validation_hash")
  wholeSubmissionId String? @map("whole_submission_id")
  wholePayloadHash String? @map("whole_payload_hash")
  wholeAnswersEncrypted String? @map("whole_answers_encrypted")
  wholeAcceptedAt DateTime? @map("whole_accepted_at")
  id                 String                   @id @default(uuid())
  attemptId          String                   @map("attempt_id")
  attemptEpoch       Int                      @map("attempt_epoch")
  slotSetHash        String                   @map("slot_set_hash")
  contextHash        String?                  @map("context_hash")
  status             CompositeReportJobStatus @default(WAITING)
  requestedRevision  Int                      @default(1) @map("requested_revision")
  claimedRevision    Int                      @default(0) @map("claimed_revision")
  attemptCount       Int                      @default(0) @map("attempt_count")
  budgetHeld         Boolean                  @default(false) @map("budget_held")
  leaseToken         String?                  @map("lease_token")
  leaseExpiresAt     DateTime?                @map("lease_expires_at")
  nextAttemptAt      DateTime                 @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("next_attempt_at")
  reportEncrypted    String?                  @map("report_encrypted")
  aggregateInputHash String?                  @map("aggregate_input_hash")
  errorCode          String?                  @map("error_code")
  completedAt        DateTime?                @map("completed_at")
  createdAt          DateTime                 @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@unique([attemptId, attemptEpoch], map: "composite_report_jobs_attempt_epoch_key")
  @@index([status, nextAttemptAt], map: "composite_report_jobs_pending_idx")
  @@index([status, leaseExpiresAt], map: "composite_report_jobs_lease_idx")
  @@map("composite_report_jobs")
}

// Updated inside the outbox transaction. No COUNT scan or Redis durability
// dependency on each submit; a permit is released exactly once by its job.
model CompositeReportQueueBudget {
  id      String @id
  pending Int    @default(0)

  @@map("composite_report_queue_budget")
}

// Shared scientific content only; personal binding remains on each attempt.
model AssessmentRuntimeArtifact {
  artifactHash     String   @id @map("artifact_hash")
  formatVersion    Int      @map("format_version")
  plaintextBytes   Int      @map("plaintext_bytes")
  payloadEncrypted String   @map("payload_encrypted")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  @@map("assessment_runtime_artifacts")
}

// Shared public templates; personal facts stay in owned records.
model AssessmentPublicTemplate {
 templateHash String @id @map("template_hash")
 templateKind String @map("template_kind")
 plaintextBytes Int @map("plaintext_bytes")
 payloadEncrypted String @map("payload_encrypted")
 createdAt DateTime @default(now()) @map("created_at")
 @@map("assessment_public_templates")
}

model AssessmentResultFact {
 assessmentId String @map("assessment_id")
 attemptEpoch Int @map("attempt_epoch")
 submissionId String @unique @map("submission_id")
 payloadHash String @map("payload_hash")
 sourceResultHash String @map("source_result_hash")
 canonicalResultHash String? @map("canonical_result_hash")
 factsEncrypted String @map("facts_encrypted")
 rawAnswersEncrypted String? @map("raw_answers_encrypted")
 rawReceiptAttemptId String? @map("raw_receipt_attempt_id")
 completedAt DateTime @map("completed_at")
 totalTime Int @map("total_time")
 createdAt DateTime @default(now()) @map("created_at")
 assessment Assessment @relation(fields:[assessmentId], references:[id], onDelete:Cascade, onUpdate:Cascade)
 rawReceipt CompositeReportJob? @relation("AssessmentResultRawReceipt", fields:[rawReceiptAttemptId,attemptEpoch], references:[attemptId,attemptEpoch], onDelete:NoAction, onUpdate:NoAction)
 @@id([assessmentId,attemptEpoch])
 @@index([rawReceiptAttemptId,attemptEpoch], map: "assessment_result_facts_raw_receipt_epoch_idx")
 @@map("assessment_result_facts")
}

// One frozen personal context per distinct parent/context; unit plans stay shared.
model AssessmentFrozenBinding {
 id BigInt @id @default(autoincrement())
 bindingHash Bytes @unique @map("binding_hash")
 compositeAttemptId String? @map("composite_attempt_id")
 questionnaireAssessmentId String? @map("questionnaire_assessment_id")
 plaintextBytes Int @map("plaintext_bytes")
 payloadEncrypted String @map("payload_encrypted")
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
 compositeAttempt CompositeAssessmentAttempt? @relation(fields:[compositeAttemptId],references:[id],onDelete:Cascade,onUpdate:Cascade)
 questionnaireAssessment QuestionnaireAssessment? @relation(fields:[questionnaireAssessmentId],references:[id],onDelete:Cascade,onUpdate:Cascade)
 @@index([compositeAttemptId],map:"assessment_frozen_bindings_composite_idx")
 @@index([questionnaireAssessmentId],map:"assessment_frozen_bindings_questionnaire_idx")
 @@map("assessment_frozen_bindings")
}


// Survey-owned FINAL_ONLY cognitive administrations. No Training identity is used.
model SurveyCognitiveSession {
  id                  String @id
  projectId           String @map("project_id")
  waveId              String @map("wave_id")
  attemptId           String @map("attempt_id")
  attempt             SurveyWaveAttempt @relation(fields:[attemptId,projectId,waveId],references:[id,projectId,waveId],onDelete:Restrict)
  publicationId       String @map("publication_id")
  publication         SurveyPublication @relation(fields:[publicationId],references:[id],onDelete:Restrict)
  slotKey             String @map("slot_key")
  epoch               Int
  status              String @default("IN_PROGRESS")
  measurementDigest   String @map("measurement_digest")
  randomSeedCipher    String @map("random_seed_cipher")
  lockedAnswersCipher String @map("locked_answers_cipher")
  lockedAnswersHash   String @map("locked_answers_hash")
  admissionCipher     String @map("admission_cipher")
  startedAt           DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  interruptedAt       DateTime? @map("interrupted_at") @db.Timestamptz(6)
  finishedAt          DateTime? @map("finished_at") @db.Timestamptz(6)
  retentionReviewAt   DateTime @map("retention_review_at") @db.Timestamptz(6)
  result              SurveyCognitiveResult?
  @@unique([attemptId,slotKey,epoch],map:"survey_cognitive_attempt_slot_epoch_uniq")
  @@unique([id,projectId,waveId,attemptId,publicationId,slotKey,epoch],map:"survey_cognitive_session_scope_uniq")
  @@index([projectId,waveId,attemptId],map:"survey_cognitive_session_scope_idx")
  @@index([retentionReviewAt],map:"survey_cognitive_retention_review_idx")
  @@map("survey_cognitive_sessions")
}
model SurveyCognitiveResult {
  id                  String @id
  sessionId           String @unique @map("session_id")
  projectId           String @map("project_id")
  waveId              String @map("wave_id")
  attemptId           String @map("attempt_id")
  publicationId       String @map("publication_id")
  slotKey             String @map("slot_key")
  epoch               Int
  session             SurveyCognitiveSession @relation(fields:[sessionId,projectId,waveId,attemptId,publicationId,slotKey,epoch],references:[id,projectId,waveId,attemptId,publicationId,slotKey,epoch],onDelete:Restrict)
  measurementDigest   String @map("measurement_digest")
  submissionId        String @map("submission_id")
  payloadHash         String @map("payload_hash")
  rawHash             String @map("raw_hash")
  rawCipher           String @map("raw_cipher")
  resultHash          String @map("result_hash")
  resultCipher        String @map("result_cipher")
  trialCount          Int @map("trial_count")
  completedAt         DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  @@unique([sessionId,projectId,waveId,attemptId,publicationId,slotKey,epoch],map:"survey_cognitive_result_scope_uniq")
  @@unique([attemptId,slotKey],map:"survey_cognitive_result_attempt_slot_uniq")
  @@index([projectId,waveId,attemptId],map:"survey_cognitive_result_scope_idx")
  @@map("survey_cognitive_results")
}

// Analysis eligibility is independent of the accepted FINAL and task status.
model TrainingAnalysisQuality {
  id           String   @id @default(uuid())
  courseId     String   @map("course_id")
  attemptId    String   @map("attempt_id")
  attemptEpoch Int      @map("attempt_epoch")
  sourceHash   String   @map("source_hash")
  verdict      String
  reason       String
  reviewerId   String   @map("reviewer_id")
  revision     Int      @default(1)
  reviewedAt   DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  @@unique([courseId, attemptId, attemptEpoch, sourceHash], map: "training_analysis_quality_scope_key")
  @@index([courseId, attemptId])
  @@map("training_analysis_quality")
}

// Append-only decisions, including the previous verdict and revision.
model TrainingAnalysisQualityAudit {
  id           String   @id @default(uuid())
  reviewId     String   @map("review_id")
  courseId     String   @map("course_id")
  attemptId    String   @map("attempt_id")
  attemptEpoch Int      @map("attempt_epoch")
  sourceHash   String   @map("source_hash")
  verdict      String
  previousVerdict String @map("previous_verdict")
  reason       String
  reviewerId   String   @map("reviewer_id")
  revision     Int
  reviewedAt   DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  @@unique([reviewId, revision])
  @@index([courseId, attemptId])
  @@map("training_analysis_quality_audit")
}

// C20 durable material-only assignment receipts. Existing attempt ciphertext is
// the envelope carrier; historical attempts and flow hashes are not rewritten.
model TrainingMaterialExperiment {
  id            String @id @default(uuid())
  ownerId       String @map("owner_id")
  courseId      String @map("course_id")
  experimentKey String @map("experiment_key")
  groupKeysHash String @map("group_keys_hash")

  @@unique([ownerId, courseId, experimentKey], map: "training_material_experiment_scope_key")
  @@map("training_material_experiments")
}

model TrainingMaterialSubjectBinding {
  id             String @id @default(uuid())
  experimentId   String @map("experiment_id")
  participantKey String @map("participant_key")
  groupKey       String @map("group_key")
  initialClaimId String @map("initial_claim_id")

  @@unique([experimentId, participantKey], map: "training_material_binding_subject_key")
  @@map("training_material_subject_bindings")
}

model TrainingMaterialQuotaBucket {
  id             String @id @default(uuid())
  compositeId    String @map("composite_id")
  publicationKey String @map("publication_key")
  configDigest   String @map("config_digest")
  groupKey       String @map("group_key")
  maxAssigned    Int @map("max_assigned")
  assignedCount  Int @default(0) @map("assigned_count")

  @@unique([compositeId, publicationKey, configDigest, groupKey], map: "training_material_quota_scope_key")
  @@map("training_material_quota_buckets")
}

model TrainingMaterialAllocationClaim {
  id                   String @id @default(uuid())
  experimentId         String @map("experiment_id")
  compositeId          String @map("composite_id")
  publicationKey       String @map("publication_key")
  configDigest         String @map("config_digest")
  participantKey       String @map("participant_key")
  groupKey             String @map("group_key")
  algorithm            String
  inheritedFromClaimId String? @map("inherited_from_claim_id")
  initialAttemptId     String @unique(map: "training_material_claim_attempt_key") @map("initial_attempt_id")
  materialDigest       String @map("material_digest")
  reservationOrdinal   Int? @map("reservation_ordinal")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([compositeId, publicationKey, configDigest, groupKey, reservationOrdinal], map: "training_material_claim_reservation_key")
  @@index([experimentId, participantKey], map: "training_material_claim_subject_idx")
  @@index([compositeId, publicationKey, configDigest, groupKey], map: "training_material_claim_quota_idx")
  @@map("training_material_allocation_claims")
}

// Explicit immutable public recruitment round; historical tokens remain null.
model TrainingPublicRound {
  id String @id @default(uuid())
  compositeId String @map("composite_id")
  courseId String @map("course_id")
  createdBy String @map("created_by")
  publishedAt DateTime @map("published_at")
  publicationHash String @map("publication_hash")
  publicationIdentity Json @map("publication_identity")
  groupIpPolicy Json @map("group_ip_policy")
  opensAt DateTime @map("opens_at")
  closesAt DateTime @map("closes_at")
  createdAt DateTime @default(now()) @map("created_at")
  tokens CompositeAssessmentAccessToken[]
  @@index([compositeId])
  @@index([courseId])
  @@map("training_public_rounds")
}

// Retained identity/counters; clearing payload never renews the per-attempt budget.
model TrainingAttemptCheckpoint {
  attemptId String @id @map("attempt_id")
  snapshotHash String @map("snapshot_hash")
  definitionHash String @map("definition_hash")
  attemptEpoch Int @map("attempt_epoch")
  roundId String? @map("round_id")
  revision Int @default(0)
  successfulSaveCount Int @default(0) @map("successful_save_count")
  payloadEncrypted String? @map("payload_encrypted")
  payloadHash String? @map("payload_hash")
  expiresAt DateTime? @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  attempt CompositeAssessmentAttempt @relation(fields:[attemptId],references:[id],onDelete:Restrict)
  @@map("training_attempt_checkpoints")
}

// Three independently versioned content layers; no personal answer data.
model MeasurementContentRelease {
  surveyReportDrafts SurveyReportDraft[]
  referenceCandidates MeasurementReferenceCandidate[]
  id              String @id
  layer           String
  family          String
  key             String @map("content_key")
  version         String
  hashScheme      String @map("hash_scheme")
  contentHash     String @map("content_hash")
  content         Json
  scope           Json
  provenance      Json @default("{}")
  assetRefs       Json @map("asset_refs")
  sourceReleaseId String? @map("source_release_id")
  source          MeasurementContentRelease? @relation("ContentSource",fields:[sourceReleaseId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  adaptations     MeasurementContentRelease[] @relation("ContentSource")
  scales          Scale[]
  cognitiveConfigs CognitiveTestConfig[]
  sjtReleases     SjtAuthorRelease[]
  publishedBy     String @map("published_by")
  publishedAt     DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  status          String @default("PUBLISHED")
  events          MeasurementContentReleaseEvent[]
  @@unique([family,layer,key,version],map:"measurement_content_release_identity_key")
  @@index([family,layer,status],map:"measurement_content_catalog_idx")
  @@map("measurement_content_releases")
}
model MeasurementContentReleaseEvent {
  id         String @id
  releaseId  String @map("release_id")
  release    MeasurementContentRelease @relation(fields:[releaseId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  fromStatus String @map("from_status")
  toStatus   String @map("to_status")
  actorId    String @map("actor_id")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([releaseId,createdAt],map:"measurement_content_events_release_idx")
  @@map("measurement_content_release_events")
}

model MeasurementReferenceCandidate {
  surveyRequests SurveyReferenceRequest[]
  id String @id
  candidateHash String @unique @map("candidate_hash")
  measurementReleaseId String @map("measurement_release_id")
  measurementRelease MeasurementContentRelease @relation(fields:[measurementReleaseId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  analyzerId String @map("analyzer_id")
  analyzer User @relation(fields:[analyzerId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  payload Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reviews MeasurementReferenceReview[]
  @@map("measurement_reference_candidates")
}
model MeasurementReferenceReview {
  surveyRequests SurveyReferenceRequest[]
  id String @id
  candidateId String @map("candidate_id")
  candidate MeasurementReferenceCandidate @relation(fields:[candidateId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  candidateHash String @map("candidate_hash")
  reviewerId String @map("reviewer_id")
  reviewer User @relation(fields:[reviewerId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  decision String
  statement String
  reviewedAt DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  @@index([candidateId,reviewedAt],map:"measurement_reference_review_candidate_idx")
  @@map("measurement_reference_reviews")
}

model SurveyReportDraft {
  id String @id
  projectId String @map("project_id")
  project SurveyProject @relation(fields:[projectId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  ownerId String @map("owner_id")
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  reportKey String @map("report_key")
  version String
  revision Int @default(0)
  payload Json
  state String @default("DRAFT")
  publishedReleaseId String? @map("published_release_id")
  publishedRelease MeasurementContentRelease? @relation(fields:[publishedReleaseId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([projectId,reportKey,version],map:"survey_report_drafts_project_id_report_key_version_key")
  @@map("survey_report_drafts")
}

model ContentCapabilityGrant {
  id                       String   @id
  subjectId                String   @map("subject_id")
  issuerId                 String   @map("issuer_id")
  parentGrantId            String?  @map("parent_grant_id")
  product                  String
  scopeKind                String   @map("scope_kind")
  scopeId                  String   @map("scope_id")
  resourceKind             String   @map("resource_kind")
  resourceKeys             String[] @map("resource_keys")
  capabilities             String[]
  delegableCapabilities    String[] @map("delegable_capabilities")
  remainingDelegationDepth Int      @map("remaining_delegation_depth")
  validFrom                DateTime @map("valid_from") @db.Timestamp(3)
  expiresAt                DateTime @map("expires_at") @db.Timestamp(3)
  ancestry                 String[]
  version                  Int      @default(1)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamp(3)
  revokedBy                String?  @map("revoked_by")
  revokeReason             String?  @map("revoke_reason")
  subject                  User     @relation("ContentCapabilitySubject", fields: [subjectId], references: [id], onDelete: Restrict)
  issuer                   User     @relation("ContentCapabilityIssuer", fields: [issuerId], references: [id], onDelete: Restrict)
  revoker                  User?    @relation("ContentCapabilityRevoker", fields: [revokedBy], references: [id], onDelete: Restrict)
  parent                   ContentCapabilityGrant? @relation("ContentCapabilityDelegation", fields: [parentGrantId], references: [id], onDelete: Restrict)
  children                 ContentCapabilityGrant[] @relation("ContentCapabilityDelegation")

  @@index([subjectId, product, scopeKind, scopeId, resourceKind], map: "content_capability_grants_subject_scope_idx")
  @@index([parentGrantId], map: "content_capability_grants_parent_idx")
  @@map("content_capability_grants")
}

// Independently requested immutable interpretation; FINAL facts remain canonical.
model SurveyInterpretationArtifact {
  id String @id
  finalId String @map("final_id")
  final SurveyWaveFinal @relation(fields:[finalId],references:[id],onDelete:Restrict)
  createdBy String @map("created_by")
  creator User @relation(fields:[createdBy],references:[id],onDelete:Restrict)
  requestHash String @map("request_hash")
  sourceFinalHash String @map("source_final_hash")
  artifactCipher String @map("artifact_cipher")
  artifactHash String @map("artifact_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([finalId,createdAt,id],map:"survey_interpretation_artifacts_final_time_idx")
  @@map("survey_interpretation_artifacts")
}

// Immutable operation-to-result pointers. CHECK constraints and immutability
// trigger are defined in the additive survey_reference_requests migration.
model SurveyReferenceRequest {
  requestId String @id @map("request_id") @db.Uuid
  actorId String @map("actor_id")
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  projectId String @map("project_id")
  project SurveyProject @relation(fields:[projectId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  waveId String @map("wave_id")
  wave SurveyWave @relation(fields:[waveId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  operation String
  inputHash String @map("input_hash")
  candidateId String @map("candidate_id")
  candidate MeasurementReferenceCandidate @relation(fields:[candidateId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  reviewId String? @map("review_id")
  review MeasurementReferenceReview? @relation(fields:[reviewId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  exclusionCounts Json? @map("exclusion_counts")
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  @@map("survey_reference_requests")
}
