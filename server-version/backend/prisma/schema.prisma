  @@index([projectId, status, updatedAt, id], map:"survey_instruments_project_status_idx")
  @@map("survey_instrument_drafts")
}



// PR3 design: Survey research-only frozen publication and wave lineage.
// Old anonymous_study_* tables remain unmodified and are not double-written.
model SurveyPublication {
  id              String        @id
  projectId       String        @map("project_id")
  project         SurveyProject @relation(fields:[projectId],references:[id],onDelete:Restrict)
  definitionDigest String       @map("definition_digest")
  compiledSnapshot Json         @map("compiled_snapshot")
  consentVersion  Int           @map("consent_version")
  purpose         String        @default("RESEARCH_ONLY")
  version         Int
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  waves           SurveyWave[]
  finals          SurveyWaveFinal[]
  cognitiveSessions SurveyCognitiveSession[]
  @@unique([projectId,version],map:"survey_publications_project_version_key")
  @@index([projectId,createdAt],map:"survey_publications_project_idx")
  @@map("survey_publications")
}
model SurveyWave {
  referenceRequests SurveyReferenceRequest[]
  id              String        @id
  projectId       String        @map("project_id")
  project         SurveyProject @relation(fields:[projectId],references:[id],onDelete:Restrict)
  publicationId   String?       @map("publication_id")
  publication     SurveyPublication? @relation(fields:[publicationId],references:[id],onDelete:Restrict)
  ordinal         Int
  title           String
  status          String        @default("DRAFT")
  revision        Int           @default(0)
  consentText     String        @map("consent_text")
  consentVersion  Int           @default(1) @map("consent_version")
  linkageNoticeConfirmed Boolean @default(false) @map("linkage_notice_confirmed")
  generalText     String        @default("") @map("general_text")
  hardStopAt      DateTime?     @map("hard_stop_at") @db.Timestamptz(6)
  instrumentIds   Json          @default("[]") @map("instrument_ids")
  flowDefinition  Json?         @map("flow_definition")
  quotaPolicy     Json?         @map("quota_policy")
  checkpointPolicy Json?        @map("checkpoint_policy")
  groupIpPolicy   Json?         @map("group_ip_policy")
  groupIpActivatedAt DateTime?  @map("group_ip_activated_at") @db.Timestamptz(6)
  opensAt         DateTime?     @map("opens_at") @db.Timestamptz(6)
  closesAt        DateTime?     @map("closes_at") @db.Timestamptz(6)
  finishUntil     DateTime?     @map("finish_until") @db.Timestamptz(6)
  quotaStarts     Int?          @map("quota_starts")
  startsCount     Int           @default(0) @map("starts_count")
  allowNewParticipants Boolean @default(false) @map("allow_new_participants")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  attempts        SurveyWaveAttempt[]
  quotaBuckets    SurveyExperimentQuotaBucket[]
  finals          SurveyWaveFinal[]
  entryTokens     SurveyEntryToken[]
  consents        SurveyConsent[]
  @@unique([projectId,ordinal],map:"survey_waves_project_ordinal_key")
  @@index([projectId,status,opensAt],map:"survey_waves_project_status_idx")
  @@map("survey_waves")
}
model SurveyParticipant {
  id                String        @id
