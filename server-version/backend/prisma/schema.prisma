generator client {
  provider = "prisma-client-js"
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  surveyReferenceRequests SurveyReferenceRequest[]
  contentCapabilityGrants       ContentCapabilityGrant[] @relation("ContentCapabilitySubject")
  issuedContentCapabilityGrants ContentCapabilityGrant[] @relation("ContentCapabilityIssuer")
  revokedContentCapabilityGrants ContentCapabilityGrant[] @relation("ContentCapabilityRevoker")

  surveyReportDrafts SurveyReportDraft[]
  surveyInterpretationArtifacts SurveyInterpretationArtifact[]
  measurementReferenceCandidates MeasurementReferenceCandidate[]
  measurementReferenceReviews MeasurementReferenceReview[]
  compositionTemplates AssessmentCompositionTemplate[]
  assessmentManagementEvents AssessmentManagementEvent[]
  scalePublicationAudits ScalePublicationAudit[]
  id                                  String                           @id @default(uuid())
  username                            String                           @unique
  // Existing accounts retain their legacy identity; new legacy registrations are TRAINING.
  accountDomain                       String                           @default("TRAINING") @map("account_domain")
  campusAccount                       CampusAccount?
  passwordHash                        String                           @map("password_hash")
  role                                UserRole                         @default(STUDENT)
  platformRole                        PlatformRole                     @default(STANDARD) @map("platform_role")
  nickname                            String?
  avatarUrl                           String?                          @map("avatar_url")
  phone                               String?
  isActive                            Boolean                          @default(true) @map("is_active")
  tokenVersion                        Int                              @default(0) @map("token_version")
  mustChangePassword                  Boolean                          @default(false) @map("must_change_password")
  createdAt                           DateTime                         @default(now()) @map("created_at")
  updatedAt                           DateTime                         @updatedAt @map("updated_at")
  teacherCodeId                       String?                          @map("teacher_code_id")
  expiresAt                           DateTime?                        @map("expires_at")
  isFrozen                            Boolean                          @default(false) @map("is_frozen")
  teacherApproved                     Boolean                          @default(true) @map("teacher_approved")
  checkinSubmissions                  CheckinSubmission[]
  checkins                            Checkin[]                        @relation("CheckinCreator")
  courseStudents                      CourseStudent[]
  createdCourses                      Course[]                         @relation("CourseCreator")
  submissions                         Submission[]
  teacherCodes                        TeacherCode[]                    @relation("TeacherCodeCreator")
  teacherCode                         TeacherCode?                     @relation("UserTeacherCode", fields: [teacherCodeId], references: [id])
  videos                              Video[]
  sharedCourses                       CourseShare[]                    @relation("SharedBy")
  receivedCourses                     CourseShare[]                    @relation("SharedTo")
  // 心理问卷模块关联
  assessments                         Assessment[]
  scaleDeploymentPolicies            ScaleDeploymentPolicy[]
  createdScales                       Scale[]                          @relation("ScaleCreator")
  // 聚合问卷模块关联
  createdQuestionnaires               Questionnaire[]                  @relation("QuestionnaireCreator")
  questionnaireAssessments            QuestionnaireAssessment[]        @relation("UserQuestionnaireAssessments")
  // 访问令牌关联（新增）
  createdAccessTokens                 QuestionnaireAccessToken[]       @relation("TokenCreator")
  exportArtifacts                     ExportArtifact[]                 @relation("ExportArtifactCreator")
  // 匿名打卡令牌关联
  createdCheckinTokens                CheckinAccessToken[]             @relation("CheckinTokenCreator")
  // 文档库关联
  documents                           Document[]
  // 课堂模块关联
  createdClassrooms                   Classroom[]                      @relation("ClassroomCreator")
  // 认知测评模块关联（userId 删除时 Session 保留，userId 置空 -> SetNull）
  cognitiveSessions                   CognitiveSession[]               @relation("SessionUser")
  // Situational PR-B standalone attempts keep a stable participant pseudonym
  // and remain readable as historical rows if the User is removed.
  situationalAttempts                SituationalAttempt[]              @relation("SituationalAttemptUser")
  createdCognitiveAssignments         CognitiveAssignment[]            @relation("AssignmentCreator")
  // 综合测评模块关联
  createdCompositeAssessments         CompositeAssessment[]            @relation("CompositeAssessmentCreator")
  compositeAssessmentAttempts         CompositeAssessmentAttempt[]     @relation("CompositeAttemptUser")
  createdCompositeAccessTokens        CompositeAssessmentAccessToken[] @relation("CompositeTokenCreator")
  generatedCompositeAnalysisSnapshots CompositeAnalysisSnapshot[]      @relation("CompositeAnalysisSnapshotGenerator")
  createdCognitiveAccessTokens        CognitiveAccessToken[]           @relation("CognitiveTokenCreator")
  materialGrantsReceived              MaterialGrant[]                  @relation("MaterialGrantTeacher")
  materialGrantsGiven                 MaterialGrant[]                  @relation("MaterialGrantGranter")

  // Unified Assessment Bundle: PARENT / episode / invite / consent
  parentRelationshipsAsParent   ParentStudentRelationship[] @relation("ParentRelationshipParent")
  parentRelationshipsAsStudent  ParentStudentRelationship[] @relation("ParentRelationshipStudent")
  parentInviteCodesCreated      ParentInviteCode[]          @relation("ParentInviteCodeCreator")
  assessmentEpisodesAsSubject   AssessmentEpisode[]         @relation("EpisodeSubject")
  assessmentEpisodesInitiated   AssessmentEpisode[]         @relation("EpisodeInitiator")
  attemptConsentsAsSubject      AssessmentAttemptConsent[]  @relation("ConsentSubject")
  attemptConsentsAsRespondent   AssessmentAttemptConsent[]  @relation("ConsentRespondent")
  relationalAssignmentsAsSubject    RelationalAssessmentAssignment[] @relation("RelationalAssignmentSubject")
  relationalAssignmentsAsRespondent RelationalAssessmentAssignment[] @relation("RelationalAssignmentRespondent")
  relationalAssignmentsCreated      RelationalAssessmentAssignment[] @relation("RelationalAssignmentCreator")
  relationalAnalysisSnapshotsAsSubject RelationalAnalysisSnapshot[] @relation("RelationalAnalysisSubject")
  safetyCasesAsSubject          SafetyCase[]                @relation("SafetyCaseSubject")
  safetyCasesAsPrimaryOwner     SafetyCase[]                @relation("SafetyCasePrimaryOwner")

  // Organization / Reporting V2.1 identity authority
  organizationsCreated                 Organization[]                @relation("OrganizationCreator")
  organizationMemberships              OrganizationMembership[]      @relation("OrganizationMembershipUser")
  organizationMembershipsEnded         OrganizationMembership[]      @relation("OrganizationMembershipEnder")
  organizationPersonaGrantsGiven       OrganizationPersonaGrant[]    @relation("OrganizationPersonaGrantGranter")
  organizationPersonaGrantsRevoked     OrganizationPersonaGrant[]    @relation("OrganizationPersonaGrantRevoker")
  organizationCapabilityGrantsGiven    OrganizationCapabilityGrant[] @relation("OrganizationCapabilityGrantGranter")
  organizationCapabilityGrantsRevoked  OrganizationCapabilityGrant[] @relation("OrganizationCapabilityGrantRevoker")
  organizationAccessDeniesReceived     OrganizationAccessDeny[]      @relation("OrganizationAccessDenySubject")
  organizationAccessDeniesGiven        OrganizationAccessDeny[]      @relation("OrganizationAccessDenyDenier")
  organizationAccessDeniesLifted       OrganizationAccessDeny[]      @relation("OrganizationAccessDenyLifter")
  organizationGovernanceAudits         OrganizationGovernanceAudit[] @relation("OrganizationGovernanceAuditActor")
  organizationCommandReceipts          OrganizationCommandReceipt[]  @relation("OrganizationCommandReceiptActor")

  @@map("users")
}


// ==================== Organization / Reporting V2.1 identity authority ====================
// PostgreSQL-only partial/expression indexes, CHECK constraints, and the
// append-only audit trigger remain authoritative in the handwritten migrations.
model AdminSecurityKey {
  id        String @id
  userId    String @map("user_id")
  publicKey Bytes @map("public_key")
  counter   BigInt @default(0)
  transports String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([userId], map: "admin_security_keys_user_idx")
  @@map("admin_security_keys")
}

model AdminSecurityChallenge {
  idHash         String @id @map("id_hash")
  userId         String @map("user_id")
  purpose        String
  challenge      String
  tokenVersion   Int @map("token_version")
  sessionId      String? @map("session_id")
  enrollmentHash String? @map("enrollment_hash")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  @@index([expiresAt], map: "admin_security_challenges_expiry_idx")
  @@map("admin_security_challenges")
}

model AdminEntryGrant {
  id        String @id
  userId    String @map("user_id")
  entry     String
  version   Int @default(1)
  grantedBy String @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedBy String? @map("revoked_by")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  @@unique([userId, entry], map: "admin_entry_grants_user_entry_key")
  @@map("admin_entry_grants")
}

model AdminAuthorizationAudit {
  id           String @id
  actorUserId  String? @map("actor_user_id")
  targetUserId String @map("target_user_id")
  entry        String?
  action       String
  version      Int?
  reason       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([targetUserId, createdAt(sort: Desc)], map: "admin_authorization_audits_target_idx")
  @@map("admin_authorization_audits")
}

model Organization {
  homeroomDeliveryEnabled Boolean @default(true) @map("homeroom_delivery_enabled")
  productDomain String @default("LEGACY") @map("product_domain")
  id              String    @id
  name            String
  status          String    @default("ACTIVE")
  createdByUserId String    @map("created_by_user_id")
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy        User                          @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships      OrganizationMembership[]
  courses          Course[] @relation("OrganizationCourses")
  accessDenies     OrganizationAccessDeny[]
  governanceAudits OrganizationGovernanceAudit[]
  commandReceipts  OrganizationCommandReceipt[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String    @id
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  orgRole        String    @default("MEMBER") @map("org_role")
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(6)
  endedByUserId  String?   @map("ended_by_user_id")
  endReason      String?   @map("end_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization     Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_memberships_organization_id_fkey")
  user             User                          @relation("OrganizationMembershipUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_memberships_user_id_fkey")
  endedBy          User?                         @relation("OrganizationMembershipEnder", fields: [endedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_memberships_ended_by_user_id_fkey")
  personaGrants    OrganizationPersonaGrant[]
  capabilityGrants OrganizationCapabilityGrant[]

  @@unique([organizationId, id], map: "organization_memberships_org_id_id_key")
  @@index([userId, organizationId, validFrom(sort: Desc)], map: "organization_memberships_user_history_idx")
  @@map("organization_memberships")
}

model OrganizationPersonaGrant {
  id              String    @id
  organizationId  String    @map("organization_id")
  membershipId    String    @map("membership_id")
  persona         String
  grantedByUserId String    @map("granted_by_user_id")
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id")
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)

  membership OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "organization_persona_grants_membership_fkey")
  grantedBy  User                   @relation("OrganizationPersonaGrantGranter", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_persona_grants_granted_by_fkey")
  revokedBy  User?                  @relation("OrganizationPersonaGrantRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_persona_grants_revoked_by_fkey")

  @@index([organizationId, membershipId], map: "organization_persona_grants_org_membership_idx")
  @@map("organization_persona_grants")
}

model OrganizationCapabilityGrant {
  id              String    @id
  organizationId  String    @map("organization_id")
  membershipId    String    @map("membership_id")
  capability      String
  grantedByUserId String    @map("granted_by_user_id")
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id")
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)

  membership OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "organization_capability_grants_membership_fkey")
  grantedBy  User                   @relation("OrganizationCapabilityGrantGranter", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_capability_grants_granted_by_fkey")
  revokedBy  User?                  @relation("OrganizationCapabilityGrantRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_capability_grants_revoked_by_fkey")

  @@index([organizationId, membershipId], map: "organization_capability_grants_org_membership_idx")
  @@map("organization_capability_grants")
}

model OrganizationAccessDeny {
  id             String    @id
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  permission     String
  reason         String
  deniedByUserId String    @map("denied_by_user_id")
  deniedAt       DateTime  @default(now()) @map("denied_at") @db.Timestamptz(6)
  liftedByUserId String?   @map("lifted_by_user_id")
  liftedAt       DateTime? @map("lifted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_access_denies_org_fkey")
  user         User         @relation("OrganizationAccessDenySubject", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_access_denies_user_fkey")
  deniedBy     User         @relation("OrganizationAccessDenyDenier", fields: [deniedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_access_denies_denied_by_fkey")
  liftedBy     User?        @relation("OrganizationAccessDenyLifter", fields: [liftedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_access_denies_lifted_by_fkey")

  @@map("organization_access_denies")
}

model OrganizationGovernanceAudit {
  id             String   @id
  organizationId String?  @map("organization_id")
  actorUserId    String   @map("actor_user_id")
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  domainEventId  String   @unique(map: "organization_governance_audits_domain_event_id_key") @map("domain_event_id")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_governance_audits_org_fkey")
  actor        User          @relation("OrganizationGovernanceAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_governance_audits_actor_fkey")

  @@index([organizationId, createdAt(sort: Desc)], map: "organization_governance_audits_org_created_idx")
  @@map("organization_governance_audits")
}

model OrganizationCommandReceipt {
  id             String   @id
  actorUserId    String   @map("actor_user_id")
  organizationId String?  @map("organization_id")
  commandKey     String   @map("command_key")
  payloadHash    String   @map("payload_hash")
  response       Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor        User          @relation("OrganizationCommandReceiptActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_command_receipts_actor_fkey")
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_command_receipts_org_fkey")

  @@index([createdAt], map: "organization_command_receipts_created_idx")
  @@map("organization_command_receipts")
}

model TeacherCode {
  id        String    @id @default(uuid())
  code      String    @unique
  createdBy String    @map("created_by")
  maxUses   Int       @default(1) @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  creator   User      @relation("TeacherCodeCreator", fields: [createdBy], references: [id])
  users     User[]    @relation("UserTeacherCode")

  @@map("teacher_codes")
}

model Course {
  questionnaireDeliveries QuestionnaireCourseDelivery[]
  id                   String                @id @default(uuid())
  title                String
  description          String?
  coverUrl             String?               @map("cover_url")
  coverAssetId         String?               @map("cover_asset_id")
  status               CourseStatus          @default(DRAFT)
  courseCode           String                @unique @map("course_code")
  // Legacy rows remain LEGACY_COURSE, never inferred from user role or hostname.
  courseType           String                @default("LEGACY_COURSE") @map("course_type")
  organizationId       String?               @map("organization_id")
  organization         Organization?         @relation("OrganizationCourses", fields: [organizationId], references: [id], onDelete: Restrict)
  creatorId            String                @map("creator_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  endedAt              DateTime?             @map("ended_at")
  isRecruiting         Boolean               @default(true) @map("is_recruiting")
  isLibrary            Boolean               @default(false) @map("is_library")
  assignments          Assignment[]
  checkins             Checkin[]
  students             CourseStudent[]
  creator              User                  @relation("CourseCreator", fields: [creatorId], references: [id])
  coverAsset           StoredAsset?          @relation("CourseCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  shares               CourseShare[]
  // 心理问卷模块关联
  courseScales         CourseScale[]
  // 聚合问卷模块关联
  courseQuestionnaires CourseQuestionnaire[]
  // 课堂模块关联
  classrooms           Classroom[]
  // 认知测评模块关联（courseId 删除时 Assignment 保留，courseId 置空 + courseSnapshot -> SetNull）
  cognitiveAssignments CognitiveAssignment[] @relation("CourseCognitiveAssignments")
  compositeAssessments CompositeAssessment[] @relation("CourseCompositeAssessments")

  @@index([isLibrary])
  @@map("courses")
}

model CourseShare {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  sharedBy  String   @map("shared_by")
  sharedTo  String   @map("shared_to")
  createdAt DateTime @default(now()) @map("created_at")

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sharer   User   @relation("SharedBy", fields: [sharedBy], references: [id], onDelete: Cascade)
  receiver User   @relation("SharedTo", fields: [sharedTo], references: [id], onDelete: Cascade)

  @@unique([courseId, sharedTo])
  @@map("course_shares")
}

model CourseStudent {
  id        String              @id @default(uuid())
  courseId  String              @map("course_id")
  studentId String              @map("student_id")
  status    CourseStudentStatus @default(PENDING)
  joinedAt  DateTime            @default(now()) @map("joined_at")
  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@map("course_students")
}

model Assignment {
  id          String           @id @default(uuid())
  courseId    String           @map("course_id")
  title       String
  description String?
  deadline    DateTime?
  status      AssignmentStatus @default(PUBLISHED)
  questions   Json?
  videos      Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  content     String?
  images      Json?
  documents   Json?
  tags        String[]         @default([])
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id                     String                         @id @default(uuid())
  assignmentId           String                         @map("assignment_id")
  studentId              String                         @map("student_id")
  // Monotonic optimistic-concurrency revision.  A keyed submit must carry
  // the revision it read so a delayed request can never overwrite a newer
  // commit after the idempotency receipt window has been missed.
  revision               Int                            @default(0)
  content                String?
  answers                Json?
  comment                String?
  status                 SubmissionStatus               @default(SUBMITTED)
  submittedAt            DateTime                       @default(now()) @map("submitted_at")
  reviewedAt             DateTime?                      @map("reviewed_at")
  idempotencyKeyHash     String?                        @map("idempotency_key_hash")
  idempotencyPayloadHash String?                        @map("idempotency_payload_hash")
  assignment             Assignment                     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student                User                           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  history                SubmissionHistory[]
  idempotencyReceipts    SubmissionIdempotencyReceipt[]

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

// Immutable receipt for every keyed assignment submission.  The mutable
// Submission row keeps only the latest key for compatibility, while receipts
// preserve older keys so a delayed retry can be replayed without overwriting
// a newer submission.
model SubmissionIdempotencyReceipt {
  id                     String     @id @default(uuid())
  assignmentId           String     @map("assignment_id")
  studentId              String     @map("student_id")
  submissionId           String     @map("submission_id")
  idempotencyKeyHash     String     @map("idempotency_key_hash")
  idempotencyPayloadHash String     @map("idempotency_payload_hash")
  response               Json
  createdAt              DateTime   @default(now()) @map("created_at")
  submission             Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique(name: "submission_idempotency_receipt_scope_key", [assignmentId, studentId, idempotencyKeyHash])
  @@index([submissionId])
  @@index([createdAt])
  @@map("submission_idempotency_receipts")
}

model SubmissionHistory {
  id           String     @id @default(uuid())
  submissionId String     @map("submission_id")
  content      String?
  answers      Json?
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, version])
  @@map("submission_histories")
}

model Checkin {
  id              String               @id @default(uuid())
  courseId        String               @map("course_id")
  title           String
  description     String?
  creatorId       String               @map("creator_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  content         String?
  images          Json?
  documents       Json?
  videos          Json?
  allowViewOthers Boolean              @default(false) @map("allow_view_others")
  endTime         DateTime?            @map("end_time")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  tags            String[]             @default([])
  allowAnonymous  Boolean              @default(false) @map("allow_anonymous")
  submissions     CheckinSubmission[]
  accessTokens    CheckinAccessToken[]
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator         User                 @relation("CheckinCreator", fields: [creatorId], references: [id])

  @@map("checkins")
}

model CheckinSubmission {
  id                     String                                @id @default(uuid())
  checkinId              String                                @map("checkin_id")
  studentId              String?                               @map("student_id")
  // Monotonic optimistic-concurrency revision for authenticated submissions.
  revision               Int                                   @default(0)
  content                String?
  images                 Json?
  createdAt              DateTime                              @default(now()) @map("created_at")
  idempotencyKeyHash     String?                               @map("idempotency_key_hash")
  idempotencyPayloadHash String?                               @map("idempotency_payload_hash")
  isAnonymous            Boolean                               @default(false) @map("is_anonymous")
  sessionId              String?                               @map("session_id")
  tokenId                String?                               @map("token_id")
  checkin                Checkin                               @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  student                User?                                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  accessToken            CheckinAccessToken?                   @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  idempotencyReceipts    CheckinSubmissionIdempotencyReceipt[]

  @@unique([checkinId, studentId])
  @@unique([checkinId, sessionId])
  @@index([isAnonymous])
  @@index([sessionId])
  @@index([tokenId])
  @@map("checkin_submissions")
}

// Immutable receipt for keyed, authenticated check-in submissions.  Public
// anonymous submissions do not use this table because they are session
// claimed by their access token instead of an Idempotency-Key.
model CheckinSubmissionIdempotencyReceipt {
  id                     String            @id @default(uuid())
  checkinId              String            @map("checkin_id")
  studentId              String            @map("student_id")
  submissionId           String            @map("submission_id")
  idempotencyKeyHash     String            @map("idempotency_key_hash")
  idempotencyPayloadHash String            @map("idempotency_payload_hash")
  response               Json
  createdAt              DateTime          @default(now()) @map("created_at")
  submission             CheckinSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique(name: "checkin_submission_idempotency_receipt_scope_key", [checkinId, studentId, idempotencyKeyHash])
  @@index([submissionId])
  @@index([createdAt])
  @@map("checkin_submission_idempotency_receipts")
}

model Video {
  id                  String       @id @default(uuid())
  title               String
  filePath            String       @map("file_path")
  fileName            String       @map("file_name")
  fileSize            Int          @map("file_size")
  mimeType            String       @map("mime_type")
  teacherId           String       @map("teacher_id")
  usageCount          Int          @default(0) @map("usage_count")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  deletedAt           DateTime?    @map("deleted_at")
  isDeleted           Boolean      @default(false) @map("is_deleted")
  tags                String[]     @default([])
  duration            Int?
  errorMessage        String?      @map("error_message")
  // The queue job identity and start time make PROCESSING recoverable after a
  // worker crash or a stalled Bull job.
  processingJobId     String?      @map("processing_job_id")
  processingGeneration Int         @default(0) @map("processing_generation")
  processingStartedAt DateTime?    @map("processing_started_at")
  originalUrl         String?      @map("original_url")
  originalCosUrl      String?      @map("original_cos_url") // 原始文件COS URL（低频存储）
  originalCosKey      String?      @map("original_cos_key") // 原始文件COS Key
  processedAt         DateTime?    @map("processed_at")
  processedUrl        String?      @map("processed_url")
  resolution          String?
  status              VideoStatus  @default(PENDING)
  thumbnailUrl        String?      @map("thumbnail_url")
  originalAssetId     String?      @map("original_asset_id")
  processedAssetId    String?      @map("processed_asset_id")
  thumbnailAssetId    String?      @map("thumbnail_asset_id")
  teacher             User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  originalAsset       StoredAsset? @relation("VideoOriginalAsset", fields: [originalAssetId], references: [id], onDelete: SetNull)
  processedAsset      StoredAsset? @relation("VideoProcessedAsset", fields: [processedAssetId], references: [id], onDelete: SetNull)
  thumbnailAsset      StoredAsset? @relation("VideoThumbnailAsset", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  @@index([status, processingStartedAt])
  @@map("videos")
}

