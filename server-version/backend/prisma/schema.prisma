// 一次学生/匿名参与记录。recoveryTokenHash 只存哈希，原始恢复凭证只在创建时返回一次。
model CompositeAssessmentAttempt {
  deliveryCourseId String? @map("delivery_course_id")
  id                           String                           @id @default(uuid())
  compositeAssessmentId        String                           @map("composite_assessment_id")
  userId                       String?                          @map("user_id")
  accessTokenId                String?                          @map("access_token_id")
  recoveryTokenHash            String?                          @unique @map("recovery_token_hash")
  participantKey               String                           @map("participant_key")
  anonymousCode                String?                          @map("anonymous_code")
  attemptNo                    Int                              @default(1) @map("attempt_no")
  status                       CompositeAssessmentAttemptStatus @default(IN_PROGRESS)
  deliveryMode                 InstrumentDeliveryMode           @default(FINAL_ONLY) @map("delivery_mode")
  runtimeGeneration            RuntimeGeneration?               @map("runtime_generation")
  attemptEpoch                 Int                              @default(1) @map("attempt_epoch")
  progress                     Int                              @default(0)
  completedItems               Int                              @default(0) @map("completed_items")
  startedAt                    DateTime                         @default(now()) @map("started_at")
  lastSavedAt                  DateTime                         @default(now()) @map("last_saved_at")
  completedAt                  DateTime?                        @map("completed_at")
  totalTime                    Int?                             @map("total_time")
  contextSnapshotEncrypted     String?                          @map("context_snapshot_encrypted")
  contextSnapshotHash          String?                          @map("context_snapshot_hash")
  contextFrozenAt              DateTime?                        @map("context_frozen_at")
  aggregateInputHash           String?                          @map("aggregate_input_hash")
  compiledBundleRuntimeHash    String?                          @map("compiled_bundle_runtime_hash")
  frozenActiveSlotSetEncrypted String?                          @map("frozen_active_slot_set_encrypted")
  frozenActiveSlotSetHash      String?                          @map("frozen_active_slot_set_hash")
  // Additive identity (Commit 11). Historical rows stay null — never infer from userId.
  subjectUserId                String?                          @map("subject_user_id")
  respondentUserId             String?                          @map("respondent_user_id")
  respondentType               String?                          @map("respondent_type")
  episodeId                    String?                          @map("episode_id")
  assignmentRef                String?                          @map("assignment_ref")
  consentId                    String?                          @map("consent_id")
  contextSnapshotRef           String?                          @map("context_snapshot_ref")

  compositeAssessment CompositeAssessment             @relation(fields: [compositeAssessmentId], references: [id], onDelete: Cascade)
  episode             AssessmentEpisode?              @relation(fields: [episodeId], references: [id], onDelete: Restrict)
  consent             AssessmentAttemptConsent?       @relation(fields: [consentId], references: [id], onDelete: Restrict)
  user                User?                           @relation("CompositeAttemptUser", fields: [userId], references: [id], onDelete: SetNull)
  accessToken         CompositeAssessmentAccessToken? @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)
  scaleAssessments    Assessment[]                    @relation("CompositeAttemptAssessments")
  cognitiveSessions   CognitiveSession[]              @relation("CompositeAttemptCognitiveSessions")
  situationalAttempts SituationalAttempt[]            @relation("CompositeAttemptSituationalAttempts")
  formAnswers         CompositeFormAnswer[]
  formSectionAttempts CompositeFormSectionAttempt[]
  bundleAnalyses      BundleAnalysis[]
  analysisSnapshots   CompositeAnalysisSnapshot[]
  unitSnapshots       AssessmentUnitSnapshot[]        @relation("CompositeAssessmentUnitSnapshots")

  @@unique([compositeAssessmentId, participantKey, attemptNo], map: "composite_attempts_assessment_participant_no_key")
  @@index([compositeAssessmentId, status])
  @@index([userId, status])
  @@index([participantKey])
  @@index([accessTokenId])
  @@index([subjectUserId, status])
  @@index([respondentUserId, status])
  @@index([episodeId])
  @@map("composite_assessment_attempts")
}

// Package-scoped cognitive analysis output. Rows are append-only at the
// application level; the completion row is the historical default and an
// explicit reanalysis creates a separate row.
model CompositeAnalysisSnapshot {
  id                        String                                    @id @default(uuid())
  attemptId                 String                                    @map("attempt_id")
  packageKey                String                                    @map("package_key")
  packageVersion            String                                    @map("package_version")
  analysisDefinitionVersion String                                    @map("analysis_definition_version")
  analysisVersion           String                                    @map("analysis_version")
  reportSchemaVersion       String                                    @map("report_schema_version")
  inputFingerprint          String                                    @map("input_fingerprint")
  generationReason          CompositeAnalysisSnapshotGenerationReason @map("generation_reason")
  generatedBy               String?                                   @map("generated_by")
  payloadEncrypted          String                                    @map("payload_encrypted")
  aggregateInputHash        String?                                   @map("aggregate_input_hash")
  hashScheme                String?                                   @map("hash_scheme")
  compiledBundleRuntimeHash String?                                   @map("compiled_bundle_runtime_hash")
  attemptEpoch              Int?                                      @map("attempt_epoch")
  contextHash               String?                                   @map("context_hash")
  runtimeGeneration         RuntimeGeneration?                        @map("runtime_generation")
  createdAt                 DateTime                                  @default(now()) @map("created_at")

  attempt   CompositeAssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  generator User?                      @relation("CompositeAnalysisSnapshotGenerator", fields: [generatedBy], references: [id], onDelete: SetNull)

  @@unique([attemptId, analysisVersion, inputFingerprint], map: "composite_analysis_snapshots_attempt_version_fingerprint_key")
  @@index([attemptId, generationReason, createdAt], map: "composite_analysis_snapshots_attempt_reason_created_idx")
  @@map("composite_analysis_snapshots")
}

