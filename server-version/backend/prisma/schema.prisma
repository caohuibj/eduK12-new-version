generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                  String                           @id @default(uuid())
  username                            String                           @unique
  passwordHash                        String                           @map("password_hash")
  role                                UserRole                         @default(STUDENT)
  nickname                            String?
  avatarUrl                           String?                          @map("avatar_url")
  phone                               String?
  isActive                            Boolean                          @default(true) @map("is_active")
  tokenVersion                        Int                              @default(0) @map("token_version")
  mustChangePassword                  Boolean                          @default(false) @map("must_change_password")
  createdAt                           DateTime                         @default(now()) @map("created_at")
  updatedAt                           DateTime                         @updatedAt @map("updated_at")
  teacherCodeId                       String?                          @map("teacher_code_id")
  expiresAt                           DateTime?                        @map("expires_at")
  isFrozen                            Boolean                          @default(false) @map("is_frozen")
  teacherApproved                     Boolean                          @default(true) @map("teacher_approved")
  checkinSubmissions                  CheckinSubmission[]
  checkins                            Checkin[]                        @relation("CheckinCreator")
  courseStudents                      CourseStudent[]
  createdCourses                      Course[]                         @relation("CourseCreator")
  submissions                         Submission[]
  teacherCodes                        TeacherCode[]                    @relation("TeacherCodeCreator")
  teacherCode                         TeacherCode?                     @relation("UserTeacherCode", fields: [teacherCodeId], references: [id])
  videos                              Video[]
  sharedCourses                       CourseShare[]                    @relation("SharedBy")
  receivedCourses                     CourseShare[]                    @relation("SharedTo")
  // 心理问卷模块关联
  assessments                         Assessment[]
  createdScales                       Scale[]                          @relation("ScaleCreator")
  // 聚合问卷模块关联
  createdQuestionnaires               Questionnaire[]                  @relation("QuestionnaireCreator")
  questionnaireAssessments            QuestionnaireAssessment[]        @relation("UserQuestionnaireAssessments")
  // 访问令牌关联（新增）
  createdAccessTokens                 QuestionnaireAccessToken[]       @relation("TokenCreator")
  exportArtifacts                     ExportArtifact[]                 @relation("ExportArtifactCreator")
  // 匿名打卡令牌关联
  createdCheckinTokens                CheckinAccessToken[]             @relation("CheckinTokenCreator")
  // 文档库关联
  documents                           Document[]
  // 课堂模块关联
  createdClassrooms                   Classroom[]                      @relation("ClassroomCreator")
  // 认知测评模块关联（userId 删除时 Session 保留，userId 置空 -> SetNull）
  cognitiveSessions                   CognitiveSession[]               @relation("SessionUser")
  createdCognitiveAssignments         CognitiveAssignment[]            @relation("AssignmentCreator")
  // 综合测评模块关联
  createdCompositeAssessments         CompositeAssessment[]            @relation("CompositeAssessmentCreator")
  compositeAssessmentAttempts         CompositeAssessmentAttempt[]     @relation("CompositeAttemptUser")
  createdCompositeAccessTokens        CompositeAssessmentAccessToken[] @relation("CompositeTokenCreator")
  generatedCompositeAnalysisSnapshots CompositeAnalysisSnapshot[]      @relation("CompositeAnalysisSnapshotGenerator")
  createdCognitiveAccessTokens        CognitiveAccessToken[]           @relation("CognitiveTokenCreator")
  materialGrantsReceived              MaterialGrant[]                  @relation("MaterialGrantTeacher")
  materialGrantsGiven                 MaterialGrant[]                  @relation("MaterialGrantGranter")

  @@map("users")
}

model TeacherCode {
  id        String    @id @default(uuid())
  code      String    @unique
  createdBy String    @map("created_by")
  maxUses   Int       @default(1) @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  creator   User      @relation("TeacherCodeCreator", fields: [createdBy], references: [id])
  users     User[]    @relation("UserTeacherCode")

  @@map("teacher_codes")
}

model Course {
  id                   String                @id @default(uuid())
  title                String
  description          String?
  coverUrl             String?               @map("cover_url")
  coverAssetId         String?               @map("cover_asset_id")
  status               CourseStatus          @default(DRAFT)
  courseCode           String                @unique @map("course_code")
  creatorId            String                @map("creator_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  endedAt              DateTime?             @map("ended_at")
  isRecruiting         Boolean               @default(true) @map("is_recruiting")
  isLibrary            Boolean               @default(false) @map("is_library")
  assignments          Assignment[]
  checkins             Checkin[]
  students             CourseStudent[]
  creator              User                  @relation("CourseCreator", fields: [creatorId], references: [id])
  coverAsset           StoredAsset?          @relation("CourseCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  shares               CourseShare[]
  // 心理问卷模块关联
  courseScales         CourseScale[]
  // 聚合问卷模块关联
  courseQuestionnaires CourseQuestionnaire[]
  // 课堂模块关联
  classrooms           Classroom[]
  // 认知测评模块关联（courseId 删除时 Assignment 保留，courseId 置空 + courseSnapshot -> SetNull）
  cognitiveAssignments CognitiveAssignment[] @relation("CourseCognitiveAssignments")
  compositeAssessments CompositeAssessment[] @relation("CourseCompositeAssessments")

  @@index([isLibrary])
  @@map("courses")
}

model CourseShare {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  sharedBy  String   @map("shared_by")
  sharedTo  String   @map("shared_to")
  createdAt DateTime @default(now()) @map("created_at")

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sharer   User   @relation("SharedBy", fields: [sharedBy], references: [id], onDelete: Cascade)
  receiver User   @relation("SharedTo", fields: [sharedTo], references: [id], onDelete: Cascade)

  @@unique([courseId, sharedTo])
  @@map("course_shares")
}

model CourseStudent {
  id        String              @id @default(uuid())
  courseId  String              @map("course_id")
  studentId String              @map("student_id")
  status    CourseStudentStatus @default(PENDING)
  joinedAt  DateTime            @default(now()) @map("joined_at")
  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@map("course_students")
}

model Assignment {
  id          String           @id @default(uuid())
  courseId    String           @map("course_id")
  title       String
  description String?
  deadline    DateTime?
  status      AssignmentStatus @default(PUBLISHED)
  questions   Json?
  videos      Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  content     String?
  images      Json?
  documents   Json?
  tags        String[]         @default([])
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String              @id @default(uuid())
  assignmentId String              @map("assignment_id")
  studentId    String              @map("student_id")
  content      String?
  answers      Json?
  comment      String?
  status       SubmissionStatus    @default(SUBMITTED)
  submittedAt  DateTime            @default(now()) @map("submitted_at")
  reviewedAt   DateTime?           @map("reviewed_at")
  assignment   Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  history      SubmissionHistory[]

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

model SubmissionHistory {
  id           String     @id @default(uuid())
  submissionId String     @map("submission_id")
  content      String?
  answers      Json?
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_histories")
}

model Checkin {
  id              String               @id @default(uuid())
  courseId        String               @map("course_id")
  title           String
  description     String?
  creatorId       String               @map("creator_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  content         String?
  images          Json?
  documents       Json?
  videos          Json?
  allowViewOthers Boolean              @default(false) @map("allow_view_others")
  endTime         DateTime?            @map("end_time")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  tags            String[]             @default([])
  allowAnonymous  Boolean              @default(false) @map("allow_anonymous")
  submissions     CheckinSubmission[]
  accessTokens    CheckinAccessToken[]
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator         User                 @relation("CheckinCreator", fields: [creatorId], references: [id])

  @@map("checkins")
}

model CheckinSubmission {
  id          String              @id @default(uuid())
  checkinId   String              @map("checkin_id")
  studentId   String?             @map("student_id")
  content     String?
  images      Json?
  createdAt   DateTime            @default(now()) @map("created_at")
  isAnonymous Boolean             @default(false) @map("is_anonymous")
  sessionId   String?             @map("session_id")
  tokenId     String?             @map("token_id")
  checkin     Checkin             @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  student     User?               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  accessToken CheckinAccessToken? @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([checkinId, studentId])
  @@unique([checkinId, sessionId])
  @@index([isAnonymous])
  @@index([sessionId])
  @@index([tokenId])
  @@map("checkin_submissions")
}

model Video {
  id               String       @id @default(uuid())
  title            String
  filePath         String       @map("file_path")
  fileName         String       @map("file_name")
  fileSize         Int          @map("file_size")
  mimeType         String       @map("mime_type")
  teacherId        String       @map("teacher_id")
  usageCount       Int          @default(0) @map("usage_count")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")
  isDeleted        Boolean      @default(false) @map("is_deleted")
  tags             String[]     @default([])
  duration         Int?
  errorMessage     String?      @map("error_message")
  originalUrl      String?      @map("original_url")
  originalCosUrl   String?      @map("original_cos_url") // 原始文件COS URL（低频存储）
  originalCosKey   String?      @map("original_cos_key") // 原始文件COS Key
  processedAt      DateTime?    @map("processed_at")
  processedUrl     String?      @map("processed_url")
  resolution       String?
  status           VideoStatus  @default(PENDING)
  thumbnailUrl     String?      @map("thumbnail_url")
  originalAssetId  String?      @map("original_asset_id")
  processedAssetId String?      @map("processed_asset_id")
  thumbnailAssetId String?      @map("thumbnail_asset_id")
  teacher          User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  originalAsset    StoredAsset? @relation("VideoOriginalAsset", fields: [originalAssetId], references: [id], onDelete: SetNull)
  processedAsset   StoredAsset? @relation("VideoProcessedAsset", fields: [processedAssetId], references: [id], onDelete: SetNull)
  thumbnailAsset   StoredAsset? @relation("VideoThumbnailAsset", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  @@map("videos")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum CourseStudentStatus {
  PENDING
  APPROVED
  ACTIVE
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
}

enum VideoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ==================== 心理问卷模块 ====================

enum ScaleStatus {
  DRAFT // 草稿
  PUBLISHED // 已发布
  DEPRECATED // 已废弃
  ARCHIVED // 已归档
}

enum ScaleInstrumentClass {
  STANDARD
  CUSTOM_DESCRIPTIVE
}

enum AssessmentStatus {
  IN_PROGRESS // 进行中
  COMPLETED // 已完成
  ABANDONED // 已放弃
}

enum ScaleVisibility {
  HIDDEN // 未关联不可见（默认）
  COURSE // 关联课程后可见
  PUBLIC // 全体可见
}

enum AssessmentReferenceInstrumentType {
  SCALE
  COGNITIVE
}

enum AssessmentReferenceStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum MaterialResourceType {
  SCALE
  COGNITIVE_CONFIG
  REPORT_PACKAGE
}

enum CognitiveConfigAccessPolicy {
  OPEN
  GRANT
}

model MaterialGrant {
  id           String               @id @default(uuid())
  teacherId    String               @map("teacher_id")
  resourceType MaterialResourceType @map("resource_type")
  resourceId   String               @map("resource_id")
  grantedBy    String               @map("granted_by")
  createdAt    DateTime             @default(now()) @map("created_at")

  teacher User @relation("MaterialGrantTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  granter User @relation("MaterialGrantGranter", fields: [grantedBy], references: [id], onDelete: Restrict)

  @@unique([teacherId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@map("material_grants")
}

// 量表表
model Scale {
  id                String               @id @default(uuid())
  code              String               @unique // 量表编码
  name              String // 量表名称
  description       String? // 量表描述
  status            ScaleStatus          @default(DRAFT) // 状态
  visibility        ScaleVisibility      @default(HIDDEN) // 可见性
  instrumentClass   ScaleInstrumentClass @default(CUSTOM_DESCRIPTIVE) @map("instrument_class")
  instrumentVersion String               @default("2.0.0") @map("instrument_version")
  definition        Json? // ScaleDefinitionV2；运行时唯一计分来源
  definitionHash    String?              @map("definition_hash")
  estimatedTime     Int?                 @map("estimated_time") // 预计用时（分钟）
  instruction       String? // 指导语
  creatorId         String               @map("creator_id") // 创建者ID
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  tags              String[]             @default([])

  // 关联
  creator             User                      @relation("ScaleCreator", fields: [creatorId], references: [id])
  assessments         Assessment[]
  courseScales        CourseScale[]
  // 聚合问卷模块关联
  questionnaireScales QuestionnaireScale[]      @relation("QuestionnaireScales")
  // 综合测评模块关联
  compositeItems      CompositeAssessmentItem[] @relation("CompositeAssessmentScale")

  @@map("scales")
}

// 测评记录表
model Assessment {
  id                        String           @id @default(uuid())
  scaleId                   String           @map("scale_id")
  userId                    String?          @map("user_id") // 改为可选，支持匿名测评
  status                    AssessmentStatus @default(IN_PROGRESS)
  answers                   Json? // 答案数组（加密存储）
  result                    Json? // 加密的完整 ScaleResultV2
  progress                  Int              @default(0) // 进度百分比
  startedAt                 DateTime         @default(now()) @map("started_at")
  completedAt               DateTime?        @map("completed_at") // 完成时间
  totalTime                 Int?             @map("total_time") // 总用时（毫秒）
  // 聚合问卷模块关联（可选，单体量表测评时为空）
  questionnaireAssessmentId String?          @map("questionnaire_assessment_id")
  compositeAttemptId        String?          @map("composite_attempt_id")
  compositeItemId           String?          @map("composite_item_id")

  // 关联
  scale                   Scale                       @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  user                    User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionnaireAssessment QuestionnaireAssessment?    @relation(fields: [questionnaireAssessmentId], references: [id])
  compositeAttempt        CompositeAssessmentAttempt? @relation("CompositeAttemptAssessments", fields: [compositeAttemptId], references: [id], onDelete: Cascade)
  compositeItem           CompositeAssessmentItem?    @relation("CompositeScaleAssessments", fields: [compositeItemId], references: [id], onDelete: Restrict)

  // 性能优化索引
  @@index([userId, status]) // 用户查询自己的测评
  @@index([scaleId, status]) // 按量表统计
  @@index([startedAt]) // 时间范围查询
  @@index([questionnaireAssessmentId])
  @@index([compositeAttemptId])
  @@index([compositeItemId])
  @@index([status, startedAt]) // 新增：统计场景优化
  @@map("assessments")
}

// 通用 Reference Core。definition 保存结构化 reference set，避免 scale/cognitive 各自维护一套表。
model AssessmentReferenceSet {
  id               String                            @id @default(uuid())
  instrumentType   AssessmentReferenceInstrumentType @map("instrument_type")
  instrumentKey    String                            @map("instrument_key")
  referenceVersion String                            @map("reference_version")
  status           AssessmentReferenceStatus         @default(DRAFT)
  definition       Json
  createdAt        DateTime                          @default(now()) @map("created_at")
  updatedAt        DateTime                          @updatedAt @map("updated_at")

  @@unique([instrumentType, instrumentKey, referenceVersion])
  @@index([instrumentType, instrumentKey, status])
  @@map("assessment_reference_sets")
}

// 课程量表关联表（支持将量表关联到课程）
model CourseScale {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  scaleId   String   @map("scale_id")
  createdAt DateTime @default(now()) @map("created_at")

  // 关联
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scale  Scale  @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([courseId, scaleId])
  @@map("course_scales")
}

// ==================== 聚合问卷模块 ====================

enum QuestionnaireStatus {
  DRAFT // 草稿
  PUBLISHED // 已发布
  DEPRECATED // 已废弃
}

// 问卷类型枚举（新增）
enum QuestionnaireType {
  COURSE // 课程问卷（原有）
  GENERAL // 泛化问卷（新增）
}

// 问卷主表
model Questionnaire {
  id            String              @id @default(uuid())
  code          String              @unique // 问卷编码
  name          String // 问卷名称
  description   String? // 描述
  instruction   String? // 指导语
  status        QuestionnaireStatus @default(DRAFT) // 状态
  type          QuestionnaireType   @default(COURSE) // 问卷类型：COURSE/GENERAL（新增）
  visibility    ScaleVisibility     @default(HIDDEN) // 可见性
  estimatedTime Int?                @map("estimated_time") // 预计用时
  creatorId     String              @map("creator_id") // 创建者ID
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  // 关联
  creator              User                       @relation("QuestionnaireCreator", fields: [creatorId], references: [id])
  questionnaireScales  QuestionnaireScale[]
  formItems            QuestionnaireFormItem[] // 新增：表单题目关联
  assessments          QuestionnaireAssessment[]
  courseQuestionnaires CourseQuestionnaire[]
  accessTokens         QuestionnaireAccessToken[] // 新增：访问令牌关联

  @@map("questionnaires")
}

// 问卷-量表关联表
model QuestionnaireScale {
  id              String @id @default(uuid())
  questionnaireId String @map("questionnaire_id")
  scaleId         String @map("scale_id")
  position        Int    @default(0) @map("position") // 统一排序位置（重命名自sortOrder）

  // 关联
  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  scale         Scale         @relation("QuestionnaireScales", fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId, scaleId])
  @@index([questionnaireId, position])
  @@map("questionnaire_scales")
}

// 问卷测评记录表
model QuestionnaireAssessment {
  id                       String           @id @default(uuid())
  questionnaireId          String           @map("questionnaire_id")
  userId                   String?          @map("user_id") // 改为可选，支持匿名测评
  tokenId                  String?          @map("token_id") // 访问令牌ID（匿名测评时使用）
  sessionId                String?          @unique @map("session_id") // 匿名会话标识
  resumeTokenHash          String?          @unique @map("resume_token_hash") // 服务端恢复凭据哈希
  resumeTokenExpiresAt     DateTime?        @map("resume_token_expires_at")
  status                   AssessmentStatus @default(IN_PROGRESS)
  progress                 Int              @default(0) // 总体进度
  completedScales          Int              @default(0) @map("completed_scales") // 已完成量表数量（缓存）
  completedForms           Int              @default(0) @map("completed_forms") // 已完成表单数量（缓存）
  startedAt                DateTime         @default(now()) @map("started_at")
  completedAt              DateTime?        @map("completed_at")
  totalTime                Int?             @map("total_time") // 总用时（毫秒）
  aggregateReport          Json?            @map("aggregate_report") // 聚合报告（加密存储）
  contextSnapshotEncrypted String?          @map("context_snapshot_encrypted")
  contextSnapshotHash      String?          @map("context_snapshot_hash")
  contextFrozenAt          DateTime?        @map("context_frozen_at")

  // 关联
  questionnaire    Questionnaire             @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  user             User?                     @relation("UserQuestionnaireAssessments", fields: [userId], references: [id], onDelete: Cascade)
  token            QuestionnaireAccessToken? @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  scaleAssessments Assessment[]
  formAnswers      QuestionnaireFormAnswer[] // 新增：表单答案关联

  // 性能优化索引
  @@index([userId, status])
  @@index([questionnaireId, status])
  @@index([startedAt])
  @@index([tokenId]) // 新增：令牌索引
  @@index([sessionId]) // 新增：会话索引
  @@index([resumeTokenExpiresAt])
  @@map("questionnaire_assessments")
}

// 问卷访问令牌表（新增）
model QuestionnaireAccessToken {
  id              String   @id @default(uuid())
  questionnaireId String   @map("questionnaire_id")
  // Legacy plaintext is retained nullable during the dual-read/backfill
  // window. New writes populate tokenHash + tokenEncrypted only.
  token           String?  @unique // legacy compatibility column
  tokenHash       String?  @unique @map("token_hash")
  tokenEncrypted  String?  @map("token_encrypted")
  createdBy       String   @map("created_by")
  expiresAt       DateTime @map("expires_at") // 过期时间
  maxUses         Int      @default(0) @map("max_uses") // 最大访问次数，0表示无限制
  usedCount       Int      @default(0) @map("used_count") // 已使用次数
  isActive        Boolean  @default(true) @map("is_active") // 是否激活
  createdAt       DateTime @default(now()) @map("created_at")

  // 关联
  questionnaire Questionnaire             @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  creator       User                      @relation("TokenCreator", fields: [createdBy], references: [id])
  assessments   QuestionnaireAssessment[]

  // 性能优化索引
  @@index([token])
  @@index([questionnaireId])
  @@index([expiresAt])
  @@index([isActive, expiresAt]) // 新增：有效令牌查询优化
  @@map("questionnaire_access_tokens")
}

// Metadata authority for generated exports. The file itself remains on the
// configured export storage; every download must resolve through this row.
model ExportArtifact {
  id           String   @id @default(uuid())
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  createdBy    String   @map("created_by")
  format       String
  anonymized   Boolean  @default(false)
  storageKey   String   @map("storage_key")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  creator User @relation("ExportArtifactCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId])
  @@index([createdBy])
  @@index([expiresAt])
  @@map("export_artifacts")
}

// 课程-问卷关联表
model CourseQuestionnaire {
  id              String   @id @default(uuid())
  courseId        String   @map("course_id")
  questionnaireId String   @map("questionnaire_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // 关联
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([courseId, questionnaireId])
  @@map("course_questionnaires")
}

// ==================== 表单题目模块 ====================

// 表单题目表（问卷级别的表单字段）
model QuestionnaireFormItem {
  id              String   @id @default(uuid())
  questionnaireId String   @map("questionnaire_id")
  type            String // 题目类型：fill_blank / single_choice / text_input
  label           String // 题目标签（如"性别"、"年龄"）
  placeholder     String? // 占位提示文字
  required        Boolean  @default(true) // 是否必填
  position        Int      @default(0) // 统一排序位置（与量表共享排序空间）
  options         Json? // 单选选项列表 [{value: "male", label: "男"}]
  contextKey      String?  @map("context_key")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // 关联
  questionnaire Questionnaire             @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  answers       QuestionnaireFormAnswer[]

  @@unique([questionnaireId, contextKey])
  // 性能优化索引
  @@index([questionnaireId, position])
  @@map("questionnaire_form_items")
}

// 表单答案表
model QuestionnaireFormAnswer {
  id                        String   @id @default(uuid())
  questionnaireAssessmentId String   @map("questionnaire_assessment_id")
  formItemId                String   @map("form_item_id")
  value                     String // 用户填写的答案值
  createdAt                 DateTime @default(now()) @map("created_at")

  // 关联
  questionnaireAssessment QuestionnaireAssessment @relation(fields: [questionnaireAssessmentId], references: [id], onDelete: Cascade)
  formItem                QuestionnaireFormItem   @relation(fields: [formItemId], references: [id], onDelete: Cascade)

  @@unique([questionnaireAssessmentId, formItemId])
  @@index([questionnaireAssessmentId])
  @@map("questionnaire_form_answers")
}

// ==================== 心理量表 + 认知任务综合测评 ====================

enum CompositeAssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CompositeAssessmentItemType {
  SCALE
  COGNITIVE
  FORM
}

enum CompositeAssessmentAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum CompositeAnalysisSnapshotGenerationReason {
  COMPLETION
  REANALYSIS
}

// 综合测评模板。发布后项目配置不可修改，历史测评通过子记录保存各自的结果快照。
model CompositeAssessment {
  id                                String                    @id @default(uuid())
  code                              String                    @unique
  name                              String
  description                       String?
  instruction                       String?
  status                            CompositeAssessmentStatus @default(DRAFT)
  courseId                          String?                   @map("course_id")
  createdBy                         String?                   @map("created_by")
  opensAt                           DateTime?                 @map("opens_at")
  expiresAt                         DateTime?                 @map("expires_at")
  maxAttempts                       Int                       @default(1) @map("max_attempts")
  publicEnabled                     Boolean                   @default(false) @map("public_enabled")
  copyable                          Boolean                   @default(false) @map("copyable")
  copiedFromId                      String?                   @map("copied_from_id")
  analysisProtocolKey               String?                   @map("analysis_protocol_key")
  analysisProtocolVersion           String?                   @map("analysis_protocol_version")
  analysisProtocolSnapshotEncrypted String?                   @map("analysis_protocol_snapshot_encrypted")
  // PR6B package boundary. The legacy analysisProtocol* fields remain readable
  // for historical composites; new package instances use these frozen fields.
  reportPackageKey                  String?                   @map("report_package_key")
  reportPackageVersion              String?                   @map("report_package_version")
  reportPackageProfile              String?                   @map("report_package_profile")
  reportPackageSnapshotEncrypted    String?                   @map("report_package_snapshot_encrypted")
  createdAt                         DateTime                  @default(now()) @map("created_at")
  updatedAt                         DateTime                  @updatedAt @map("updated_at")
  publishedAt                       DateTime?                 @map("published_at")

  course       Course?                          @relation("CourseCompositeAssessments", fields: [courseId], references: [id], onDelete: SetNull)
  creator      User?                            @relation("CompositeAssessmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  copiedFrom   CompositeAssessment?             @relation("CompositeCopySource", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       CompositeAssessment[]            @relation("CompositeCopySource")
  items        CompositeAssessmentItem[]
  accessTokens CompositeAssessmentAccessToken[]
  attempts     CompositeAssessmentAttempt[]

  @@index([courseId, status])
  @@index([createdBy, status])
  @@index([copyable, status])
  @@index([reportPackageKey, reportPackageVersion], map: "composite_assessments_report_package_key_version_idx")
  @@map("composite_assessments")
}

// 综合测评中按 position 排序的模块。一个模块只允许填写 scale/cognitive/form 三类中的一种。
model CompositeAssessmentItem {
  id                    String                      @id @default(uuid())
  compositeAssessmentId String                      @map("composite_assessment_id")
  type                  CompositeAssessmentItemType
  position              Int                         @default(0)
  required              Boolean                     @default(true)
  scaleId               String?                     @map("scale_id")
  cognitiveAssignmentId String?                     @map("cognitive_assignment_id")
  formType              String?                     @map("form_type")
  formLabel             String?                     @map("form_label")
  formPlaceholder       String?                     @map("form_placeholder")
  formOptions           Json?                       @map("form_options")
  contextKey            String?                     @map("context_key")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  compositeAssessment CompositeAssessment   @relation(fields: [compositeAssessmentId], references: [id], onDelete: Cascade)
  scale               Scale?                @relation("CompositeAssessmentScale", fields: [scaleId], references: [id], onDelete: Restrict)
  cognitiveAssignment CognitiveAssignment?  @relation("CompositeAssessmentCognitiveAssignment", fields: [cognitiveAssignmentId], references: [id], onDelete: Restrict)
  scaleAssessments    Assessment[]          @relation("CompositeScaleAssessments")
  cognitiveSessions   CognitiveSession[]    @relation("CompositeCognitiveSessions")
  formAnswers         CompositeFormAnswer[]

  @@unique([compositeAssessmentId, position])
  @@unique([compositeAssessmentId, contextKey])
  @@index([scaleId])
  @@index([cognitiveAssignmentId])
  @@map("composite_assessment_items")
}

// 一次学生/匿名参与记录。recoveryTokenHash 只存哈希，原始恢复凭证只在创建时返回一次。
model CompositeAssessmentAttempt {
  id                       String                           @id @default(uuid())
  compositeAssessmentId    String                           @map("composite_assessment_id")
  userId                   String?                          @map("user_id")
  accessTokenId            String?                          @map("access_token_id")
  recoveryTokenHash        String?                          @unique @map("recovery_token_hash")
  participantKey           String                           @map("participant_key")
  anonymousCode            String?                          @map("anonymous_code")
  attemptNo                Int                              @default(1) @map("attempt_no")
  status                   CompositeAssessmentAttemptStatus @default(IN_PROGRESS)
  progress                 Int                              @default(0)
  completedItems           Int                              @default(0) @map("completed_items")
  startedAt                DateTime                         @default(now()) @map("started_at")
  lastSavedAt              DateTime                         @default(now()) @map("last_saved_at")
  completedAt              DateTime?                        @map("completed_at")
  totalTime                Int?                             @map("total_time")
  contextSnapshotEncrypted String?                          @map("context_snapshot_encrypted")
  contextSnapshotHash      String?                          @map("context_snapshot_hash")
  contextFrozenAt          DateTime?                        @map("context_frozen_at")

  compositeAssessment CompositeAssessment             @relation(fields: [compositeAssessmentId], references: [id], onDelete: Cascade)
  user                User?                           @relation("CompositeAttemptUser", fields: [userId], references: [id], onDelete: SetNull)
  accessToken         CompositeAssessmentAccessToken? @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)
  scaleAssessments    Assessment[]                    @relation("CompositeAttemptAssessments")
  cognitiveSessions   CognitiveSession[]              @relation("CompositeAttemptCognitiveSessions")
  formAnswers         CompositeFormAnswer[]
  analysisSnapshots   CompositeAnalysisSnapshot[]

  @@unique([compositeAssessmentId, participantKey, attemptNo], map: "composite_attempts_assessment_participant_no_key")
  @@index([compositeAssessmentId, status])
  @@index([userId, status])
  @@index([participantKey])
  @@index([accessTokenId])
  @@map("composite_assessment_attempts")
}

// Package-scoped cognitive analysis output. Rows are append-only at the
// application level; the completion row is the historical default and an
// explicit reanalysis creates a separate row.
model CompositeAnalysisSnapshot {
  id                        String                                    @id @default(uuid())
  attemptId                 String                                    @map("attempt_id")
  packageKey                String                                    @map("package_key")
  packageVersion            String                                    @map("package_version")
  analysisDefinitionVersion String                                    @map("analysis_definition_version")
  analysisVersion           String                                    @map("analysis_version")
  reportSchemaVersion       String                                    @map("report_schema_version")
  inputFingerprint          String                                    @map("input_fingerprint")
  generationReason          CompositeAnalysisSnapshotGenerationReason @map("generation_reason")
  generatedBy               String?                                   @map("generated_by")
  payloadEncrypted          String                                    @map("payload_encrypted")
  createdAt                 DateTime                                  @default(now()) @map("created_at")

  attempt   CompositeAssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  generator User?                      @relation("CompositeAnalysisSnapshotGenerator", fields: [generatedBy], references: [id], onDelete: SetNull)

  @@unique([attemptId, analysisVersion, inputFingerprint], map: "composite_analysis_snapshots_attempt_version_fingerprint_key")
  @@index([attemptId, generationReason, createdAt], map: "composite_analysis_snapshots_attempt_reason_created_idx")
  @@map("composite_analysis_snapshots")
}

model CompositeFormAnswer {
  id        String   @id @default(uuid())
  attemptId String   @map("attempt_id")
  itemId    String   @map("item_id")
  value     String
  completed Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attempt CompositeAssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  item    CompositeAssessmentItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([attemptId, itemId])
  @@index([attemptId])
  @@map("composite_form_answers")
}

model CompositeAssessmentAccessToken {
  id                    String   @id @default(uuid())
  compositeAssessmentId String   @map("composite_assessment_id")
  token                 String   @unique
  createdBy             String   @map("created_by")
  expiresAt             DateTime @map("expires_at")
  maxUses               Int      @default(0) @map("max_uses")
  usedCount             Int      @default(0) @map("used_count")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")

  compositeAssessment CompositeAssessment          @relation(fields: [compositeAssessmentId], references: [id], onDelete: Cascade)
  creator             User                         @relation("CompositeTokenCreator", fields: [createdBy], references: [id])
  attempts            CompositeAssessmentAttempt[]

  @@index([compositeAssessmentId])
  @@index([isActive, expiresAt])
  @@map("composite_assessment_access_tokens")
}

// ==================== 文档库模块 ====================

// 文档表
model Document {
  id         String    @id @default(uuid())
  title      String
  filePath   String    @map("file_path")
  fileName   String    @map("file_name")
  fileSize   Int       @map("file_size")
  mimeType   String    @default("application/pdf") @map("mime_type")
  teacherId  String    @map("teacher_id")
  usageCount Int       @default(0) @map("usage_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  tags       String[]  @default([])
  pageCount  Int?      @map("page_count")
  cosUrl     String?   @map("cos_url")
  cosKey     String?   @map("cos_key")
  assetId    String?   @map("asset_id")

  // 关联
  teacher User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  asset   StoredAsset? @relation("DocumentAsset", fields: [assetId], references: [id], onDelete: SetNull)

  // 性能优化索引
