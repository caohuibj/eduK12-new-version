// ==================== 课堂互动模块 ====================

// 课堂状态枚举
enum ClassroomStatus {
  PREPARING // 准备中
  ACTIVE // 进行中
  ENDED // 已结束
}

// 课堂表
model Classroom {
  endSummary ClassroomEndSummary?
  id              String          @id @default(uuid())
  code            String          @unique // 课堂码（6位数字）
  name            String // 课堂名称
  courseId        String          @map("course_id") // 关联课程
  status          ClassroomStatus @default(PREPARING) // 状态
  questionnaireId String?         @map("questionnaire_id") // 可选：关联问卷复用题目
  creatorId       String          @map("creator_id") // 创建者ID
  startedAt       DateTime?       @map("started_at") // 开始时间
  endedAt         DateTime?       @map("ended_at") // 结束时间
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // 关联
  course          Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator         User                @relation("ClassroomCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  sessions        ClassroomSession[]
  questions       ClassroomQuestion[]
  ClassroomAnswer ClassroomAnswer[]

  // 性能优化索引
  @@index([code])
  @@index([courseId])
  @@index([status])
  @@index([creatorId])
  @@map("classrooms")
}

model ClassroomEndSummary {
  classroomId String @id @map("classroom_id")
  createdBy String @map("created_by")
  frozenAt DateTime @default(now()) @map("frozen_at")
  payload Json
  contentHash String @map("content_hash")
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  @@map("classroom_end_summaries")
}

// 课堂会话表（学生参与记录）
model ClassroomSession {
  id          String    @id @default(uuid())
  classroomId String    @map("classroom_id")
  studentId   String    @map("student_id") // 学生ID（临时学生使用temp_开头）
  joinedAt    DateTime  @default(now()) @map("joined_at") // 加入时间
  leftAt      DateTime? @map("left_at") // 离开时间
  isTemporary Boolean   @default(false) @map("is_temporary") // 是否为临时学生

  // 关联
  classroom Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  // 注意：studentId 字段存储学生ID，但移除外键约束以支持临时学生
  // 对于临时学生（studentId以temp_开头），不关联User表
  // 对于正式学生，代码层面确保studentId存在
  answers   ClassroomAnswer[]

  // 性能优化索引
  @@unique([classroomId, studentId])
  @@index([classroomId])
  @@index([studentId])
  @@index([isTemporary])
  @@map("classroom_sessions")
}

// 课堂题目表
model ClassroomQuestion {
  id              String    @id @default(uuid())
  classroomId     String    @map("classroom_id")
  formItemId      String?   @map("form_item_id") // 可选：关联表单题目
  questionIndex   Int       @map("question_index") // 题号
  questionContent Json // 题目内容快照
  timeLimit       Int?      @map("time_limit") // 答题时限（秒）
  startedAt       DateTime? @map("started_at") // 开始时间
  endedAt         DateTime? @map("ended_at") // 结束时间

  // 关联
  classroom Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  answers   ClassroomAnswer[]

  // 性能优化索引
  @@unique([classroomId, questionIndex])
  @@index([classroomId])
  @@index([classroomId, questionIndex])
  @@map("classroom_questions")
}

// 课堂答案表
model ClassroomAnswer {
  id          String   @id @default(uuid())
  classroomId String   @map("classroom_id")
  questionId  String   @map("question_id")
  sessionId   String   @map("session_id")
  answer      Json // 答案内容
  submittedAt DateTime @default(now()) @map("submitted_at") // 提交时间

  // 关联
  classroom Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  question  ClassroomQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session   ClassroomSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // 性能优化索引
  @@unique([questionId, sessionId])
  @@index([classroomId])
  @@index([questionId])
  @@index([sessionId])
  @@map("classroom_answers")
}

// ==================== 匿名打卡模块 ====================

// 打卡访问令牌表
model CheckinAccessToken {
  id             String              @id @default(uuid())
  checkinId      String              @map("checkin_id")
  // Legacy plaintext is retained nullable only during the resumable
  // application-level backfill window. New writes use hash + encryption.
  token          String?             @unique
  tokenHash      String?             @unique @map("token_hash")
  tokenEncrypted String?             @map("token_encrypted")
  createdBy      String              @map("created_by")
  expiresAt      DateTime            @map("expires_at")
  maxUses        Int                 @default(0) @map("max_uses")
  usedCount      Int                 @default(0) @map("used_count")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  checkin        Checkin             @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  creator        User                @relation("CheckinTokenCreator", fields: [createdBy], references: [id])
  submissions    CheckinSubmission[]

  @@index([checkinId])
  @@index([expiresAt])
  @@index([isActive, expiresAt])
  @@index([token])
  @@map("checkin_access_tokens")
}

// ==================== 认知测评核心模块 (Milestone D / v1.2) ====================
//
// 数据保留与不可变原则（见 Milestone D v1.2 收口文档）：
//   - User 删除            -> CognitiveSession.userId 置空（SetNull），participantKey 保留
//   - Course 删除          -> CognitiveAssignment.courseId 置空（SetNull），courseSnapshot 保留
//   - CognitiveTestConfig  -> 被 Assignment/Session 引用时禁止物理删除（Restrict），只能 RETIRE
//   - CognitiveAssignment  -> 有 Session 后禁止物理删除（Restrict），只能 ARCHIVE
//   - CognitiveSession     -> 删除时 Trial 允许 Cascade
//   - CognitiveTrial       -> append-only，无 updatedAt

enum CognitiveConfigStatus {
  DRAFT // 草稿，可编辑
  PUBLISHED // 已发布，核心字段不可变
  RETIRED // 已退役，不再用于新 Assignment，历史 Session 继续引用
}

enum CognitiveAssignmentStatus {
  DRAFT // 草稿
  PUBLISHED // 已发布，实验核心字段不可变
  ARCHIVED // 已归档，禁止物理删除（有 Session 时）
}

enum CognitiveSessionStatus {
  IN_PROGRESS // 进行中
  COMPLETED // 已完成
  ABANDONED // 已放弃（RESTART 策略产生）
  INVALID // 服务端校验失败
}

// 认知测试配置（任务定义）。config 为任务参数（非参与者原始行为数据），按明文 Json 存储。
model CognitiveTestConfig {
  id             String                      @id @default(uuid())
  testType       String                      @map("test_type")
  configVersion  String                      @map("config_version")
  name           String
  instruction    String?
  config         Json? // 任务定义（刺激参数、计数等），非参与者行为数据
  status         CognitiveConfigStatus       @default(DRAFT)
  engineVersion  String                      @map("engine_version")
  scoringVersion String                      @map("scoring_version")
  accessPolicy   CognitiveConfigAccessPolicy @default(OPEN) @map("access_policy")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
  publishedAt    DateTime?                   @map("published_at")

  assignments CognitiveAssignment[]
  sessions    CognitiveSession[]

  @@unique([testType, configVersion])
  @@index([testType, status])
  @@map("cognitive_test_configs")
}

// 认知测评分发（课程作业）。courseId 可空 + SetNull，保留 courseSnapshot 以抵御课程删除。
model CognitiveAssignment {
  id                              String                    @id @default(uuid())
  courseId                        String?                   @map("course_id")
  courseSnapshot                  Json?                     @map("course_snapshot")
  configId                        String                    @map("config_id")
  createdBy                       String?                   @map("created_by")
  title                           String
  instruction                     String?
  status                          CognitiveAssignmentStatus @default(DRAFT)
  opensAt                         DateTime?                 @map("opens_at")
  dueAt                           DateTime?                 @map("due_at")
  maxAttempts                     Int                       @default(1) @map("max_attempts")
  quotaSourceAssignmentId         String?                   @map("quota_source_assignment_id")
  required                        Boolean                   @default(true)
  createdAt                       DateTime                  @default(now()) @map("created_at")
  updatedAt                       DateTime                  @updatedAt @map("updated_at")
  publishedAt                     DateTime?                 @map("published_at")
  listedStandalone                Boolean                   @default(true) @map("listed_standalone")
  profile                         String?
  profileDefinitionVersion        String?                   @map("profile_definition_version")
  resolvedConfigSnapshotEncrypted String?                   @map("resolved_config_snapshot_encrypted")
  resolvedConfigHash              String?                   @map("resolved_config_hash")
  resolvedReportSnapshotEncrypted String?                   @map("resolved_report_snapshot_encrypted")

  course         Course?                   @relation("CourseCognitiveAssignments", fields: [courseId], references: [id], onDelete: SetNull)
  config         CognitiveTestConfig       @relation(fields: [configId], references: [id], onDelete: Restrict)
  creator        User?                     @relation("AssignmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  sessions       CognitiveSession[]
  compositeItems CompositeAssessmentItem[] @relation("CompositeAssessmentCognitiveAssignment")
  accessTokens   CognitiveAccessToken[]
  quotaSource    CognitiveAssignment?      @relation("CognitiveQuotaSource", fields: [quotaSourceAssignmentId], references: [id], onDelete: Restrict)
  quotaCopies    CognitiveAssignment[]     @relation("CognitiveQuotaSource")

  @@index([courseId])
  @@index([quotaSourceAssignmentId])
  @@map("cognitive_assignments")
}

// 认知测评会话。所有敏感字段以密文存储（*Encrypted，统一 Cognitive 信封）。
// participantSnapshotEncrypted 为预留的身份快照（即使 User 被删除也保留必要历史信息），
// D4 Session API 写入时须用 Cognitive strict encryption 加密，禁止写入明文身份数据。
model CognitiveSession {
  id                           String                 @id @default(uuid())
  userId                       String?                @map("user_id")
  participantKey               String                 @map("participant_key")
  participantSnapshotEncrypted String?                @map("participant_snapshot_encrypted")
  assignmentId                 String?                @map("assignment_id")
  compositeAttemptId           String?                @map("composite_attempt_id")
  compositeItemId              String?                @map("composite_item_id")
  accessTokenId                String?                @map("access_token_id")
  recoveryTokenHash            String?                @unique @map("recovery_token_hash")
  anonymousCode                String?                @map("anonymous_code")
  configId                     String                 @map("config_id")
  testType                     String                 @map("test_type")
  attemptNo                    Int                    @default(1) @map("attempt_no")
  status                       CognitiveSessionStatus @default(IN_PROGRESS)
  startedAt                    DateTime               @default(now()) @map("started_at")
  finishedAt                   DateTime?              @map("finished_at")
  scoreEncrypted               String?                @map("score_encrypted")
  metricsEncrypted             String?                @map("metrics_encrypted")
  qualityFlagsEncrypted        String?                @map("quality_flags_encrypted")
  resultSnapshotEncrypted      String?                @map("result_snapshot_encrypted")
  configVersion                String                 @map("config_version")
  configSnapshotEncrypted      String                 @map("config_snapshot_encrypted")
  engineVersion                String                 @map("engine_version")
  scoringVersion               String                 @map("scoring_version")
  randomSeed                   String                 @map("random_seed")
  completionKey                String?                @map("completion_key")
  deliveryMode                 InstrumentDeliveryMode @default(FINAL_ONLY) @map("delivery_mode")
  runtimeGeneration            RuntimeGeneration?     @map("runtime_generation")
  compiledRuntimeHash          String?                @map("compiled_runtime_hash")
  submissionId                 String?                @unique @map("submission_id")
  submissionPayloadHash        String?                @map("submission_payload_hash")
  submittedAt                  DateTime?              @map("submitted_at")
  frozenAdmissionSnapshotEncrypted String?            @map("frozen_admission_snapshot_encrypted")
  frozenAdmissionSnapshotHash      String?            @map("frozen_admission_snapshot_hash")
  createdAt                    DateTime               @default(now()) @map("created_at")
  updatedAt                    DateTime               @updatedAt @map("updated_at")

  user             User?                       @relation("SessionUser", fields: [userId], references: [id], onDelete: SetNull)
  assignment       CognitiveAssignment?        @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  config           CognitiveTestConfig         @relation(fields: [configId], references: [id], onDelete: Restrict)
  compositeAttempt CompositeAssessmentAttempt? @relation("CompositeAttemptCognitiveSessions", fields: [compositeAttemptId], references: [id], onDelete: Cascade)
  compositeItem    CompositeAssessmentItem?    @relation("CompositeCognitiveSessions", fields: [compositeItemId], references: [id], onDelete: Restrict)
  accessToken      CognitiveAccessToken?       @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)
  trials           CognitiveTrial[]
  rawSubmissions   CognitiveRawSubmission[]

  // 同一分发下，按稳定匿名标识 participantKey + 尝试次数保证唯一；
  // assignmentId 为 NULL 的内部直测会话依赖应用层保证（见 v1.2 P0-4）。
  @@unique([assignmentId, participantKey, attemptNo])
  @@index([userId, status])
  @@index([assignmentId])
  @@index([configId])
  @@index([compositeAttemptId])
  @@index([compositeItemId])
  @@index([accessTokenId])
  @@index([recoveryTokenHash])
  @@index([participantKey])
  @@map("cognitive_sessions")
}

// 单个认知任务的公开链接。公开参与始终 userId=NULL，不能仅靠“导出脱敏”冒充匿名。
model CognitiveAccessToken {
  id             String   @id @default(uuid())
  assignmentId   String   @map("assignment_id")
  // Legacy plaintext is nullable during the resumable application backfill.
  // New rows persist only a deterministic lookup hash and encrypted bearer.
  token          String?  @unique
  tokenHash      String?  @unique @map("token_hash")
  tokenEncrypted String?  @map("token_encrypted")
  createdBy      String   @map("created_by")
  expiresAt      DateTime @map("expires_at")
  maxUses        Int      @default(0) @map("max_uses")
  usedCount      Int      @default(0) @map("used_count")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  assignment CognitiveAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  creator    User                @relation("CognitiveTokenCreator", fields: [createdBy], references: [id])
  sessions   CognitiveSession[]

  @@index([assignmentId])
  @@index([isActive, expiresAt])
  @@index([token])
  @@map("cognitive_access_tokens")
}

// 认知原始试次。append-only：无 updatedAt；payloadHash 用于幂等/冲突判断。
model CognitiveTrial {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  trialIndex       Int      @map("trial_index")
  payloadEncrypted String   @map("payload_encrypted")
  payloadHash      String   @map("payload_hash")
  createdAt        DateTime @default(now()) @map("created_at")

  session CognitiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, trialIndex])
  @@index([sessionId])
  @@map("cognitive_trials")
}

// Unified Cognitive final submissions persist the normalized trial sequence as
// one strict encrypted payload. Legacy CognitiveTrial rows remain readable for
// historical and legacy-generation sessions.
model CognitiveRawSubmission {
  id                   String   @id @default(uuid())
  sessionId            String   @map("session_id")
  attemptEpoch         Int      @map("attempt_epoch")
  trialCount           Int      @map("trial_count")
  payloadEncrypted     String   @map("payload_encrypted")
  payloadSchemaVersion Int      @map("payload_schema_version")
  encodingVersion      String   @map("encoding_version")
  createdAt            DateTime @default(now()) @map("created_at")

  session CognitiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, attemptEpoch], map: "cognitive_raw_submissions_session_epoch_key")
  @@index([sessionId])
  @@map("cognitive_raw_submissions")
}

// Immutable terminal fact for an active questionnaire/composite slot. The
// encrypted payload is either a CanonicalUnitResult envelope or a report-safe
// FormSectionCollectionFacts projection; raw answers never cross this boundary.
model AssessmentUnitSnapshot {
  id                        String                      @id @default(uuid())
  questionnaireAssessmentId String?                     @map("questionnaire_assessment_id")
  compositeAttemptId        String?                     @map("composite_attempt_id")
  attemptEpoch              Int                         @map("attempt_epoch")
  slotKey                   String                      @map("slot_key")
  unitType                  AssessmentUnitType          @map("unit_type")
  terminalState             AssessmentUnitTerminalState @map("terminal_state")
  payloadKind               AssessmentUnitPayloadKind   @map("payload_kind")
  sourceType                String                      @map("source_type")
  sourceAttemptId           String                      @map("source_attempt_id")
  sourceSubmissionId        String?                     @map("source_submission_id")
  sourceDefinitionHash      String?                     @map("source_definition_hash")
  compiledRuntimeHash       String?                     @map("compiled_runtime_hash")
  canonicalResultEncrypted  String?                     @map("canonical_result_encrypted")
  collectionFactsEncrypted  String?                     @map("collection_facts_encrypted")
  completedAt               DateTime                    @map("completed_at")
  createdAt                 DateTime                    @default(now()) @map("created_at")

  questionnaireAssessment QuestionnaireAssessment?    @relation("QuestionnaireAssessmentUnitSnapshots", fields: [questionnaireAssessmentId], references: [id], onDelete: Cascade)
  compositeAttempt        CompositeAssessmentAttempt? @relation("CompositeAssessmentUnitSnapshots", fields: [compositeAttemptId], references: [id], onDelete: Cascade)

  @@unique([questionnaireAssessmentId, attemptEpoch, slotKey], map: "assessment_unit_snapshots_questionnaire_slot_key")
  @@unique([compositeAttemptId, attemptEpoch, slotKey], map: "assessment_unit_snapshots_composite_slot_key")
  @@unique([questionnaireAssessmentId, attemptEpoch, sourceAttemptId], map: "assessment_unit_snapshots_questionnaire_source_key")
  @@unique([compositeAttemptId, attemptEpoch, sourceAttemptId], map: "assessment_unit_snapshots_composite_source_key")
  @@index([questionnaireAssessmentId, attemptEpoch, terminalState], map: "assessment_unit_snapshots_questionnaire_terminal_idx")
  @@index([compositeAttemptId, attemptEpoch, terminalState], map: "assessment_unit_snapshots_composite_terminal_idx")
  @@map("assessment_unit_snapshots")
}

// Standalone Situational PR-B attempt. This is intentionally independent from
// Assessment/Questionnaire/Composite: a Situational pilot is one UNIT with no
// parent slot and must not be represented as a fake Scale row.
model SituationalAttempt {
  id                     String                 @id @default(uuid())
  userId                 String?                @map("user_id")
  compositeAttemptId     String?                @map("composite_attempt_id")
  compositeItemId        String?                @map("composite_item_id")
  compositeSlotKey       String?                @map("composite_slot_key")
  participantKey         String                 @map("participant_key")
  instrumentKey          String                 @map("instrument_key")
  instrumentVersion      String                 @map("instrument_version")
  attemptNo              Int                    @default(1) @map("attempt_no")
  status                 AssessmentStatus       @default(IN_PROGRESS)
  deliveryMode           InstrumentDeliveryMode @default(FINAL_ONLY) @map("delivery_mode")
  runtimeGeneration      RuntimeGeneration     @default(UNIFIED_V1) @map("runtime_generation")
  attemptEpoch           Int                    @default(1) @map("attempt_epoch")
  definitionHash         String                 @map("definition_hash")
  compiledRuntimeHash    String                 @map("compiled_runtime_hash")
  scorerKey              String                 @map("scorer_key")
  scoringVersion         String                 @map("scoring_version")
  frozenAt               DateTime               @map("frozen_at")
  runtimeSnapshotEncrypted String               @map("runtime_snapshot_encrypted")
  submissionId           String?                @unique @map("submission_id")
  submissionPayloadHash  String?                @map("submission_payload_hash")
  submittedAt            DateTime?              @map("submitted_at")
  progress               Int                    @default(0)
  startedAt              DateTime               @default(now()) @map("started_at")
  completedAt            DateTime?              @map("completed_at")
  totalTime              Int?                   @map("total_time")
  resultEncrypted        String?                @map("result_encrypted")
  canonicalResultEncrypted String?              @map("canonical_result_encrypted")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  user          User?                   @relation("SituationalAttemptUser", fields: [userId], references: [id], onDelete: SetNull)
  compositeAttempt CompositeAssessmentAttempt? @relation("CompositeAttemptSituationalAttempts", fields: [compositeAttemptId], references: [id], onDelete: Cascade)
  compositeItem   CompositeAssessmentItem? @relation("CompositeSituationalAttempts", fields: [compositeItemId], references: [id], onDelete: Restrict)
  rawSubmission SituationalRawSubmission?

  // Standalone attempt numbers are unique within the standalone namespace;
  // embedded children are scoped by their composite parent/slot instead.
  @@index([instrumentKey, instrumentVersion, participantKey, attemptNo])
  @@index([userId, status])
  @@index([participantKey, status])
  @@index([instrumentKey, instrumentVersion, status])
  @@index([compositeAttemptId, status])
  @@unique([compositeAttemptId, compositeItemId], map: "situational_attempts_composite_item_key")
  @@map("situational_attempts")
}

// Exactly one immutable encrypted raw payload is attached to a completed
// standalone attempt. Per-scene and per-answer writes are intentionally not
// modelled.
model SituationalRawSubmission {
  id                  String            @id @default(uuid())
  attemptId           String            @unique @map("attempt_id")
  attemptEpoch        Int               @map("attempt_epoch")
  responseCount       Int               @map("response_count")
  payloadEncrypted    String            @map("payload_encrypted")
  payloadHash         String            @map("payload_hash")
  payloadSchemaVersion Int              @map("payload_schema_version")
  encodingVersion     String            @map("encoding_version")
  createdAt           DateTime          @default(now()) @map("created_at")

  attempt SituationalAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("situational_raw_submissions")
}

model InstrumentAuthorization {
  id                       String   @id @default(uuid())
  authorizationKey         String   @map("authorization_key")
  version                  Int
  instrumentKey            String   @map("instrument_key")
  instrumentVersion        String   @map("instrument_version")
  grantor                  String
  grantee                  String
  electronicAdministration Boolean  @default(true) @map("electronic_administration")
  scoring                  Boolean  @default(true)
  translation              Boolean  @default(false)
  display                  Boolean  @default(true)
  territories              String[] @default([])
  locales                  String[] @default([])
  commercialNature         String   @map("commercial_nature")
  validFrom                DateTime @map("valid_from")
  validTo                  DateTime @map("valid_to")
  basis                    String
  status                   String
  evidenceAssetId          String?  @map("evidence_asset_id")
  evidenceSha256           String?  @map("evidence_sha256")
  selfApprovalDeclaration  String?  @map("self_approval_declaration")
  approvedByUserId         String?  @map("approved_by_user_id")
  approvedAt               DateTime? @map("approved_at")
  createdByUserId          String   @map("created_by_user_id")
  recordHash               String   @map("record_hash")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  evidenceAsset StoredAsset? @relation("InstrumentAuthorizationEvidence", fields: [evidenceAssetId], references: [id], onDelete: SetNull)
  audits        InstrumentAuthorizationAudit[]

  @@unique([authorizationKey, version])
  @@index([instrumentKey, instrumentVersion, status])
  @@index([status, validTo])
  @@map("instrument_authorizations")
}

model InstrumentAuthorizationAudit {
  id                    String   @id @default(uuid())
  authorizationId       String   @map("authorization_id")
  authorizationVersion  Int      @map("authorization_version")
  action                String
  actorUserId           String   @map("actor_user_id")
  at                    DateTime
  note                  String
  recordHash            String   @map("record_hash")
  createdAt             DateTime @default(now()) @map("created_at")

  authorization InstrumentAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Restrict)

  @@index([authorizationId, at])
  @@map("instrument_authorization_audits")
}


enum ParentRelationshipStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum AssessmentEpisodeInitiationMode {
  TEACHER_CAMPAIGN
  PARENT_SELF_SERVE
  STUDENT_SELF
  ANONYMOUS_SELF
}

enum ParentInviteCodeStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

/// Global many-to-many parent↔student relationship. Revocable; never physically deleted.
model ParentStudentRelationship {
  id              String                   @id @default(uuid())
  parentUserId    String                   @map("parent_user_id")
  studentUserId   String                   @map("student_user_id")
  status          ParentRelationshipStatus @default(PENDING)
  inviteCodeId    String?                  @map("invite_code_id")
  approvedByUserId String?                 @map("approved_by_user_id")
  approvedAt      DateTime?                @map("approved_at")
  revokedByUserId String?                  @map("revoked_by_user_id")
  revokedAt       DateTime?                @map("revoked_at")
  revokeReason    String?                  @map("revoke_reason")
  consentVersion  String?                  @map("consent_version")
  consentHash     String?                  @map("consent_hash")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  parent     User             @relation("ParentRelationshipParent", fields: [parentUserId], references: [id], onDelete: Restrict)
  student    User             @relation("ParentRelationshipStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  inviteCode ParentInviteCode? @relation(fields: [inviteCodeId], references: [id], onDelete: Restrict)

  // Current-pair uniqueness is a partial index; revoked episodes remain historical.
  @@index([parentUserId, studentUserId, createdAt(sort: Desc)], map: "parent_relationship_pair_history_idx")
  @@index([studentUserId, status])
  @@index([parentUserId, status])
  @@map("parent_student_relationships")
}

/// Single-use invite bound to an exact course or current student membership.
model ParentInviteCode {
  id                String                 @id @default(uuid())
  codeHash          String                 @unique @map("code_hash")
  studentUserId     String                 @map("student_user_id")
  courseId          String?                @map("course_id")
  organizationId    String?                @map("organization_id")
  membershipId      String?                @map("membership_id")
  createdByUserId   String                 @map("created_by_user_id")
  status            ParentInviteCodeStatus @default(ACTIVE)
  expiresAt         DateTime               @map("expires_at")
  consumedAt        DateTime?              @map("consumed_at")
  consumedByParentUserId String?           @map("consumed_by_parent_user_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  creator       User                         @relation("ParentInviteCodeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  relationships ParentStudentRelationship[]

  @@index([studentUserId, status])
  @@index([courseId, status])
  @@index([expiresAt])
  @@map("parent_invite_codes")
}

model AssessmentEpisode {
  id                String                           @id @default(uuid())
  subjectUserId     String?                          @map("subject_user_id")
  initiatedByUserId String?                          @map("initiated_by_user_id")
  initiationMode    AssessmentEpisodeInitiationMode  @map("initiation_mode")
  courseId          String?                          @map("course_id")
  campaignKey       String?                          @map("campaign_key")
  label             String?
  createdAt         DateTime                         @default(now()) @map("created_at")
  updatedAt         DateTime                         @updatedAt @map("updated_at")

  subject    User? @relation("EpisodeSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  initiator  User? @relation("EpisodeInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  assessments Assessment[]
  compositeAttempts CompositeAssessmentAttempt[]
  relationalAssignments RelationalAssessmentAssignment[]

  @@index([subjectUserId, createdAt])
  @@index([courseId, campaignKey])
  @@map("assessment_episodes")
}

/// Per-attempt consent; append-only semantics (revoke via new row / status, no physical delete).
model AssessmentAttemptConsent {
  id                 String   @id @default(uuid())
  priorConsentId     String?  @unique(map: "assessment_attempt_consents_prior_consent_id_key") @map("prior_consent_id")
  subjectUserId      String?  @map("subject_user_id")
  respondentUserId   String?  @map("respondent_user_id")
  respondentType     String   @map("respondent_type")
  consentVersion     String   @map("consent_version")
  consentHash        String   @map("consent_hash")
  purpose            String
  visibilityScope    String   @map("visibility_scope")
  shareTargetsJson   Json?    @map("share_targets_json")
  acceptedAt         DateTime? @map("accepted_at")
  revokedAt          DateTime? @map("revoked_at")
  createdAt          DateTime @default(now()) @map("created_at")

  subject    User? @relation("ConsentSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  respondent User? @relation("ConsentRespondent", fields: [respondentUserId], references: [id], onDelete: Restrict)
  priorConsent AssessmentAttemptConsent? @relation("ConsentLineage", fields: [priorConsentId], references: [id], onDelete: Restrict, map: "assessment_attempt_consents_prior_consent_id_fkey")
  supersedingConsent AssessmentAttemptConsent? @relation("ConsentLineage")
  assessments Assessment[]
  compositeAttempts CompositeAssessmentAttempt[]
  relationalAssignments RelationalAssessmentAssignment[]

  @@index([subjectUserId, acceptedAt])
  @@index([respondentUserId, acceptedAt])
  @@map("assessment_attempt_consents")
}

model RelationalAssessmentAssignment {
  id                       String   @id
  episodeId                String   @map("episode_id")
  subjectUserId            String   @map("subject_user_id")
  subjectRole              String   @map("subject_role")
  respondentUserId         String   @map("respondent_user_id")
  respondentRole           String   @map("respondent_role")
  createdByUserId          String   @map("created_by_user_id")
  relationshipKind         String   @map("relationship_kind")
  relationshipRef          String?  @map("relationship_ref")
  relationshipSnapshotJson Json     @map("relationship_snapshot_json")
  relationshipSnapshotHash String   @map("relationship_snapshot_hash")
  perspective              String
  resourceKind             String   @map("resource_kind")
  resourceKey              String   @map("resource_key")
  resourceVersion          String   @map("resource_version")
  applicabilityHash        String?  @map("applicability_hash")
  analysisMode             String?  @map("analysis_mode")
  minimumRespondents       Int?     @map("minimum_respondents")
  consentId                String?  @map("consent_id")
  visibilityPolicyKey      String   @map("visibility_policy_key")
  status                   String   @default("OPEN")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  startedAt                DateTime? @map("started_at")
  completedAt              DateTime? @map("completed_at")
  revokedAt                DateTime? @map("revoked_at")

  episode    AssessmentEpisode         @relation(fields: [episodeId], references: [id], onDelete: Restrict, map: "relational_assignment_episode_fkey")
  subject    User                      @relation("RelationalAssignmentSubject", fields: [subjectUserId], references: [id], onDelete: Restrict, map: "relational_assignment_subject_fkey")
  respondent User                      @relation("RelationalAssignmentRespondent", fields: [respondentUserId], references: [id], onDelete: Restrict, map: "relational_assignment_respondent_fkey")
  creator    User                      @relation("RelationalAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "relational_assignment_created_by_fkey")
  consent    AssessmentAttemptConsent? @relation(fields: [consentId], references: [id], onDelete: Restrict, map: "relational_assignment_consent_fkey")

  @@unique([episodeId, respondentUserId, resourceKind, resourceKey, resourceVersion], map: "relational_assignment_episode_respondent_resource_key")
  @@index([respondentUserId, status], map: "relational_assignment_respondent_status_idx")
  @@index([subjectUserId, status], map: "relational_assignment_subject_status_idx")
  @@index([episodeId], map: "relational_assignment_episode_idx")
  @@index([relationshipKind, relationshipRef], map: "relational_assignment_relationship_ref_idx")
  @@index([subjectUserId, episodeId, resourceKind, resourceKey, resourceVersion, status], map: "relational_assignment_cohort_scope_idx")
  @@map("relational_assessment_assignments")
}

model RelationalAnalysisSnapshot {
  id                    String   @id
  subjectUserId         String   @map("subject_user_id")
  resourceKind          String   @map("resource_kind")
  resourceKey           String   @map("resource_key")
  resourceVersion       String   @map("resource_version")
  analysisKind          String   @map("analysis_kind")
  policyKey             String   @map("policy_key")
  policyVersion         String   @map("policy_version")
  policyHash            String   @map("policy_hash")
  respondentCount       Int      @map("respondent_count")
  inputResultHashesJson Json     @map("input_result_hashes_json")
  payloadJson           Json     @map("payload_json")
  snapshotHash          String   @unique(map: "relational_analysis_snapshot_hash_key") @map("snapshot_hash")
  createdAt             DateTime @default(now()) @map("created_at")

  subject User @relation("RelationalAnalysisSubject", fields: [subjectUserId], references: [id], onDelete: Restrict, map: "relational_analysis_subject_fkey")

  @@index([subjectUserId, resourceKind, resourceKey, createdAt(sort: Desc)], map: "relational_analysis_subject_resource_created_idx")
  @@map("relational_analysis_snapshots")
}

enum SafetyPolicyStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum SafetyCaseStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  ESCALATED
  DISPOSED
  REFERRED
}

enum SafetyCaseEventType {
  CREATED
  ACKNOWLEDGED
  ACTION_RECORDED
  ESCALATED
  DISPOSED
  REFERRED
  WAKEUP_SCHEDULED
  WAKEUP_FIRED
  RECONCILED
  WAKEUP_DUPLICATE_NOOP
}

model SafetyPolicyTemplate {
  id                           String             @id @default(uuid())
  policyKey                    String             @map("policy_key")
  policyVersion                String             @map("policy_version")
  status                       SafetyPolicyStatus @default(DRAFT)
  name                         String
  acknowledgeWithinMs          Int                @map("acknowledge_within_ms")
  disposeWithinMs              Int                @map("dispose_within_ms")
  escalationChainJson          Json               @map("escalation_chain_json")
  productionTriggerEnabled     Boolean            @default(false) @map("production_trigger_enabled")
  testOnlyAuthoritativeFixture Boolean            @default(false) @map("test_only_authoritative_fixture")
  createdByUserId              String             @map("created_by_user_id")
  approvedByUserId             String?            @map("approved_by_user_id")
  createdAt                    DateTime           @default(now()) @map("created_at")
  updatedAt                    DateTime           @updatedAt @map("updated_at")

  @@unique([policyKey, policyVersion])
  @@map("safety_policy_templates")
}

model SafetyCase {
  id                   String          @id @default(uuid())
  policyKey            String          @map("policy_key")
  policyVersion        String          @map("policy_version")
  status               SafetyCaseStatus @default(OPEN)
  subjectUserId        String          @map("subject_user_id")
  primaryOwnerUserId   String          @map("primary_owner_user_id")
  backupOwnerUserIds   String[]        @map("backup_owner_user_ids")
  triggerSourceKind    String          @map("trigger_source_kind")
  triggerSourceHash    String          @map("trigger_source_hash")
  triggerSourceRecordId String?        @map("trigger_source_record_id")
  triggerBundleKey     String?         @map("trigger_bundle_key")
  triggerBundleVersion String?         @map("trigger_bundle_version")
  triggerNotesJson     Json?           @map("trigger_notes_json")
  idempotencyKey       String          @unique @map("idempotency_key")
  priorCaseId          String?         @map("prior_case_id")
  acknowledgedAt       DateTime?       @map("acknowledged_at")
  disposedAt           DateTime?       @map("disposed_at")
  ackDueAt             DateTime        @map("ack_due_at")
  disposeDueAt         DateTime        @map("dispose_due_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  subject      User              @relation("SafetyCaseSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  primaryOwner User              @relation("SafetyCasePrimaryOwner", fields: [primaryOwnerUserId], references: [id], onDelete: Restrict)
  priorCase    SafetyCase?       @relation("SafetyCasePrior", fields: [priorCaseId], references: [id], onDelete: Restrict)
  childCases   SafetyCase[]      @relation("SafetyCasePrior")
  events       SafetyCaseEvent[]
  wakeups      SafetyWakeupLedger[]

  @@index([subjectUserId, status])
  @@index([primaryOwnerUserId, status])
  @@map("safety_cases")
}

model SafetyCaseEvent {
  id          String              @id @default(uuid())
  caseId      String              @map("case_id")
  type        SafetyCaseEventType
  actorUserId String              @map("actor_user_id")
  at          DateTime
  note        String
  wakeupJobId String?             @map("wakeup_job_id")
  createdAt   DateTime            @default(now()) @map("created_at")

  safetyCase SafetyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, at])
  @@index([wakeupJobId])
  @@map("safety_case_events")
}

model SafetyWakeupLedger {
  id           String   @id @default(uuid())
  wakeupJobId  String   @unique @map("wakeup_job_id")
  caseId       String   @map("case_id")
  kind         String
  fireAt       DateTime @map("fire_at")
  status       String
  createdAt    DateTime @default(now()) @map("created_at")
  processedAt  DateTime? @map("processed_at")

  safetyCase SafetyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, kind])
  @@index([caseId, status])
  @@map("safety_wakeup_ledger")
}

// Partial ACTIVE uniqueness and CHECK constraints are defined in the additive SQL migration.
model ScaleDeploymentPolicy {
  id String @id @db.Uuid
  scaleId String @map("scale_id")
  revision Int
  status String
  policyJson Json @map("policy_json")
  policyHash String @map("policy_hash")
  authorizationRefs Json @default("[]") @map("authorization_refs")
  createdByUserId String? @map("created_by_user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  activatedAt DateTime? @db.Timestamptz(6) @map("activated_at")
  retiredAt DateTime? @db.Timestamptz(6) @map("retired_at")
  scale Scale @relation(fields: [scaleId], references: [id], onDelete: Restrict)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  @@unique([scaleId, revision], map: "scale_deployment_policies_scale_revision_key")
  @@index([status, createdAt(sort: Desc)], map: "scale_deployment_policies_status_created_idx")
  @@map("scale_deployment_policies")
}

model ScalePublicationAudit {
  id String @id @default(uuid()) @db.Uuid
  scaleId String @map("scale_id")
  actorUserId String @map("actor_user_id")
  proofHash String @map("proof_hash")
  proof Json
  createdAt DateTime @default(now()) @map("created_at")
  scale Scale @relation(fields: [scaleId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([scaleId, createdAt])
  @@map("scale_publication_audits")
}


model QuestionnaireCourseDelivery {
  compositeId String @map("composite_id")
  courseId String @map("course_id")
  composite CompositeAssessment @relation(fields: [compositeId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  @@id([compositeId, courseId])
  @@index([courseId])
  @@map("questionnaire_course_deliveries")
}


// Explicit V3 family. Legacy package snapshots cannot represent pending/failed
// executions or request-scoped append-only reanalysis; keep their storage contract.
model BundleInstance {
  compositeId String @id @map("composite_id")
  schemaVersion Int @default(1) @map("schema_version")
  bundleKey String @map("bundle_key")
  bundleVersion String @map("bundle_version")
  definitionHash String @map("definition_hash")
  definitionEncrypted String @map("definition_encrypted")
  bindingsEncrypted String @map("bindings_encrypted")
  bindingsHash String @map("bindings_hash")
  createdAt DateTime @default(now()) @map("created_at")
  composite CompositeAssessment @relation(fields: [compositeId], references: [id], onDelete: Cascade)
  @@map("bundle_instances")
}

model BundleAnalysis {
  id String @id @default(uuid())
  attemptId String @map("attempt_id")
  attemptEpoch Int @map("attempt_epoch")
  requestKey String @map("request_key")
  purpose String
  status String @default("PENDING")
  parentInputHash String @map("parent_input_hash")
  targetDefinitionHash String @map("target_definition_hash")
  targetDefinitionEncrypted String @map("target_definition_encrypted")
  aggregateInputHash String? @map("aggregate_input_hash")
  payloadEncrypted String? @map("payload_encrypted")
  factsHash String? @map("facts_hash")
  errorCode String? @map("error_code")
  generatedBy String? @map("generated_by")
  reason String?
  previousAnalysisId String? @map("previous_analysis_id")
  retryCount Int @default(0) @map("retry_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  attempt CompositeAssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@unique([attemptId, attemptEpoch, requestKey])
  @@index([attemptId, createdAt])
  @@map("bundle_analyses")
}

// Source content is immutable; admission uses this governed lifecycle record.
model BundlePackageRelease {
  id              String   @id @default(uuid())
  bundleKey       String
  bundleVersion   String
  contentHash     String
  content         Json
  status          String   @default("DRAFT")
  review          Json?
  installedBy     String
  publishedBy     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([bundleKey, bundleVersion])
  @@map("bundle_package_releases")
}

// Author uploads stay separate from the code-owned registry and frozen attempts.
model SjtAuthorDraft {
  id            String   @id @default(uuid())
  ownerId       String   @map("owner_id")
  revision      Int      @default(1)
  status        String   @default("DRAFT")
  contentDigest String   @map("content_digest")
  template      Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  audits        SjtAuthorAudit[]
  release       SjtAuthorRelease?
  @@index([ownerId, updatedAt])
  @@map("sjt_author_drafts")
}

model SjtAuthorAudit {
  id            String   @id @default(uuid())
  draftId       String   @map("draft_id")
  draft         SjtAuthorDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  actorId       String   @map("actor_id")
  revision      Int
  action        String
  contentDigest String   @map("content_digest")
  template      Json?
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  @@index([draftId, createdAt])
  @@map("sjt_author_audits")
}

model SjtAuthorRelease {
  id                String   @id @default(uuid())
  instrumentKey     String   @map("instrument_key")
  instrumentVersion String   @map("instrument_version")
  sourceDraftId     String   @unique @map("source_draft_id")
  sourceDraft       SjtAuthorDraft @relation(fields: [sourceDraftId], references: [id], onDelete: Restrict)
  contentDigest     String   @map("content_digest")
  definitionHash    String   @map("definition_hash")
  package           Json
  authorId          String   @map("author_id")
  reviewerId        String   @map("reviewer_id")
  status            String   @default("PUBLISHED")
  createdAt         DateTime @default(now()) @map("created_at")
  @@unique([instrumentKey, instrumentVersion])
  @@map("sjt_author_releases")
}

/// 旧系统（ptool）导入簿记：仅迁移工具读写，运行时代码不使用。
model LegacyImportBatch {
  id         String    @id @default(uuid())
  mode       String
  status     String    @default("RUNNING")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  counts     Json?
  summary    Json?
  error      String?
  idMaps     LegacyImportIdMap[]

  @@map("_legacy_import_batches")
}

/// 旧系统 ID → 新系统 ID 对应（旧 ID 原样保留的表也记录以供追溯）。
model LegacyImportIdMap {
  id        String            @id @default(uuid())
  entity    String
  legacyId  String            @map("legacy_id")
  newId     String            @map("new_id")
  batchId   String            @map("batch_id")
  createdAt DateTime          @default(now()) @map("created_at")
  batch     LegacyImportBatch @relation(fields: [batchId], references: [id])

  @@unique([entity, legacyId])
  @@index([batchId])
  @@map("_legacy_import_id_map")
}

// Huischool login aliases are disjoint from legacy User.username.
model CampusAccount {
  userId          String   @id @map("user_id")
  loginName       String   @map("login_name")
  normalizedLogin String   @unique(map: "campus_accounts_normalized_login_key") @map("normalized_login")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("campus_accounts")
}

// Campus admissions use handwritten multi-column FKs/partial indexes in SQL
// migrations, because OrganizationUnit is intentionally SQL-owned.
model CampusClassAdmission {
  classUnitId      String    @id @map("class_unit_id")
  organizationId   String    @map("organization_id")
  rosterVersion    Int       @default(0) @map("roster_version")
  status           String    @default("DRAFT")
  windowOpensAt    DateTime? @map("window_opens_at") @db.Timestamptz(6)
  windowClosesAt   DateTime? @map("window_closes_at") @db.Timestamptz(6)
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedByUserId String?   @map("approved_by_user_id")
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@index([organizationId, status], map: "campus_class_admissions_org_status_idx")
  @@map("campus_class_admissions")
}

model CampusStudentEligibility {
  id                String    @id
  organizationId    String    @map("organization_id")
  classUnitId       String    @map("class_unit_id")
  studentNoDigest   String    @map("student_no_digest")
  keyVersion        Int       @default(1) @map("key_version")
  rosterVersion     Int       @map("roster_version")
  claimedUserId     String?   @unique(map: "campus_student_eligibilities_claimed_user_key") @map("claimed_user_id")
  status            String    @default("VALID")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([organizationId, studentNoDigest], map: "campus_student_eligibilities_org_digest_key")
  @@index([organizationId, classUnitId, rosterVersion], map: "campus_student_eligibilities_class_idx")
  @@map("campus_student_eligibilities")
}

model CampusActivationCode {
  id             String    @id
  organizationId String    @map("organization_id")
  classUnitId    String    @map("class_unit_id")
  rosterVersion  Int       @map("roster_version")
  codeDigest     String    @unique(map: "campus_activation_codes_digest_key") @map("code_digest")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  consumedUserId String?   @map("consumed_user_id")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([organizationId, classUnitId, expiresAt], map: "campus_activation_codes_class_idx")
  @@map("campus_activation_codes")
}

model CampusStudentEnrollment {
  userId          String    @id @map("user_id")
  organizationId  String    @map("organization_id")
  classUnitId     String    @map("class_unit_id")
  eligibilityId   String    @unique(map: "campus_student_enrollments_eligibility_key") @map("eligibility_id")
  rosterVersion   Int       @map("roster_version")
  status          String    @default("PENDING_CLASS_APPROVAL")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([organizationId, classUnitId, status], map: "campus_student_enrollments_class_idx")
  @@map("campus_student_enrollments")
}

model CampusAdmissionIncident {
  id              String    @id
  organizationId  String    @map("organization_id")
  classUnitId     String    @map("class_unit_id")
  reason          String
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([organizationId, classUnitId, resolvedAt], map: "campus_admission_incidents_class_idx")
  @@map("campus_admission_incidents")
}

// TOTP secrets are encrypted at rest with a dedicated CAMPUS MFA key.
model CampusMfaCredential {
  userId        String    @id @map("user_id")
  secretCipher  String    @map("secret_cipher")
  enabled       Boolean   @default(false)
  lastUsedStep  BigInt    @default(-1) @map("last_used_step")
  enabledAt     DateTime? @map("enabled_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("campus_mfa_credentials")
}
model CampusMfaChallenge {
  id           String    @id
  userId       String    @map("user_id")
  challengeHash String   @unique(map: "campus_mfa_challenges_digest_key") @map("challenge_hash")
  tokenVersion Int       @map("token_version")
  failedCount  Int       @default(0) @map("failed_count")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([userId, expiresAt], map: "campus_mfa_challenges_user_idx")
  @@map("campus_mfa_challenges")
}
model CampusMfaRecoveryCode {
  userId      String    @map("user_id")
  codeHash    String    @map("code_hash")
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  @@id([userId, codeHash])
  @@map("campus_mfa_recovery_codes")
}
