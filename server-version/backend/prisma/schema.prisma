  scaleId   String   @map("scale_id")
  createdAt DateTime @default(now()) @map("created_at")

  // 关联
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scale  Scale  @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([courseId, scaleId])
  @@map("course_scales")
}

// ==================== 聚合问卷模块 ====================

enum QuestionnaireStatus {
  DRAFT // 草稿
  PUBLISHED // 已发布
  DEPRECATED // 已废弃
}

// 问卷类型枚举（新增）
enum QuestionnaireType {
  COURSE // 课程问卷（原有）
  GENERAL // 泛化问卷（新增）
}

// 问卷主表
model Questionnaire {
  id            String              @id @default(uuid())
  code          String              @unique // 问卷编码
  name          String // 问卷名称
  description   String? // 描述
  instruction   String? // 指导语
  status        QuestionnaireStatus @default(DRAFT) // 状态
  type          QuestionnaireType   @default(COURSE) // 问卷类型：COURSE/GENERAL（新增）
  visibility    ScaleVisibility     @default(HIDDEN) // 可见性
  estimatedTime Int?                @map("estimated_time") // 预计用时
  creatorId     String              @map("creator_id") // 创建者ID
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  // 关联
  creator              User                       @relation("QuestionnaireCreator", fields: [creatorId], references: [id])
  questionnaireScales  QuestionnaireScale[]
  formItems            QuestionnaireFormItem[] // 新增：表单题目关联
  formSections         QuestionnaireFormSection[]
  assessments          QuestionnaireAssessment[]
  courseQuestionnaires CourseQuestionnaire[]
  accessTokens         QuestionnaireAccessToken[] // 新增：访问令牌关联

  @@map("questionnaires")
}

// 问卷-量表关联表
model QuestionnaireScale {
  id              String @id @default(uuid())
  questionnaireId String @map("questionnaire_id")
  scaleId         String @map("scale_id")
  position        Int    @default(0) @map("position") // 统一排序位置（重命名自sortOrder）

  // 关联
  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  scale         Scale         @relation("QuestionnaireScales", fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId, scaleId])
  @@index([questionnaireId, position])
  @@map("questionnaire_scales")
}

// 一个表单区段是一个独立的最终提交单元；字段仍保留在区段内排序。
model QuestionnaireFormSection {
  id              String   @id @default(uuid())
  questionnaireId String   @map("questionnaire_id")
  title           String   @default("表单")
  description     String?
  position        Int      @default(0)
  contextSection  Boolean  @default(false) @map("context_section")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  questionnaire Questionnaire                     @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  items         QuestionnaireFormItem[]
  attempts      QuestionnaireFormSectionAttempt[]

  @@unique([questionnaireId, position])
  @@index([questionnaireId])
  @@map("questionnaire_form_sections")
}

// 问卷测评记录表
model QuestionnaireAssessment {
  frozenControlBindings AssessmentFrozenBinding[]
  id                           String                 @id @default(uuid())
  questionnaireId              String                 @map("questionnaire_id")
  userId                       String?                @map("user_id") // 改为可选，支持匿名测评
  tokenId                      String?                @map("token_id") // 访问令牌ID（匿名测评时使用）
  sessionId                    String?                @unique @map("session_id") // 匿名会话标识
  resumeTokenHash              String?                @unique @map("resume_token_hash") // 服务端恢复凭据哈希
  resumeTokenExpiresAt         DateTime?              @map("resume_token_expires_at")
  status                       AssessmentStatus       @default(IN_PROGRESS)
  deliveryMode                 InstrumentDeliveryMode @default(FINAL_ONLY) @map("delivery_mode")
  runtimeGeneration            RuntimeGeneration?     @map("runtime_generation")
  attemptEpoch                 Int                    @default(1) @map("attempt_epoch")
  progress                     Int                    @default(0) // 总体进度
  completedScales              Int                    @default(0) @map("completed_scales") // 已完成量表数量（缓存）
  completedForms               Int                    @default(0) @map("completed_forms") // 已完成表单数量（缓存）
  startedAt                    DateTime               @default(now()) @map("started_at")
  completedAt                  DateTime?              @map("completed_at")
  totalTime                    Int?                   @map("total_time") // 总用时（毫秒）
  aggregateReport              Json?                  @map("aggregate_report") // 聚合报告（加密存储）
  aggregateReportEncrypted     String?                @map("aggregate_report_encrypted")
  aggregateInputHash           String?                @map("aggregate_input_hash")
  contextSnapshotEncrypted     String?                @map("context_snapshot_encrypted")
  contextSnapshotHash          String?                @map("context_snapshot_hash")
  contextFrozenAt              DateTime?              @map("context_frozen_at")
  frozenActiveSlotSetEncrypted String?                @map("frozen_active_slot_set_encrypted")
  frozenActiveSlotSetHash      String?                @map("frozen_active_slot_set_hash")

  // 关联
  questionnaire       Questionnaire                     @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  user                User?                             @relation("UserQuestionnaireAssessments", fields: [userId], references: [id], onDelete: Cascade)
  token               QuestionnaireAccessToken?         @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  scaleAssessments    Assessment[]
  formAnswers         QuestionnaireFormAnswer[] // 新增：表单答案关联
  formSectionAttempts QuestionnaireFormSectionAttempt[]
  unitSnapshots       AssessmentUnitSnapshot[]          @relation("QuestionnaireAssessmentUnitSnapshots")

  // 性能优化索引
  @@index([userId, status])
  @@index([questionnaireId, status])
  @@index([startedAt])
  @@index([tokenId]) // 新增：令牌索引
  @@index([sessionId]) // 新增：会话索引
  @@index([resumeTokenExpiresAt])
  @@map("questionnaire_assessments")
}

// 问卷访问令牌表（新增）
model QuestionnaireAccessToken {
  id              String   @id @default(uuid())
  questionnaireId String   @map("questionnaire_id")
  // Legacy plaintext is retained nullable during the dual-read/backfill
  // window. New writes populate tokenHash + tokenEncrypted only.
  token           String?  @unique // legacy compatibility column
  tokenHash       String?  @unique @map("token_hash")
  tokenEncrypted  String?  @map("token_encrypted")
  createdBy       String   @map("created_by")
  expiresAt       DateTime @map("expires_at") // 过期时间
  maxUses         Int      @default(0) @map("max_uses") // 最大访问次数，0表示无限制
  usedCount       Int      @default(0) @map("used_count") // 已使用次数
  isActive        Boolean  @default(true) @map("is_active") // 是否激活
  createdAt       DateTime @default(now()) @map("created_at")

  // 关联
  questionnaire Questionnaire             @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  creator       User                      @relation("TokenCreator", fields: [createdBy], references: [id])
  assessments   QuestionnaireAssessment[]

  // 性能优化索引
  @@index([token])
  @@index([questionnaireId])
  @@index([expiresAt])
  @@index([isActive, expiresAt]) // 新增：有效令牌查询优化
  @@map("questionnaire_access_tokens")
}

// Durable intent authority for worker-generated Scale/Questionnaire exports.
// Bull is a delivery mechanism only; PostgreSQL remains the recoverable source
// of truth across queue outages, retries, worker restarts, and stale jobs.
model ExportBatch {
  id                  String               @id @default(uuid())
  resourceType        String               @map("resource_type")
  resourceId          String               @map("resource_id")
  createdBy           String               @map("created_by")
  anonymized          Boolean              @default(true)
  formats             String[]
  options             Json
  requestKey          String               @map("request_key")
  requestHash         String               @map("request_hash")
  status              ExportArtifactStatus @default(PROCESSING)
  generation          Int                  @default(0)
  processingJobId     String?              @map("processing_job_id")
  processingStartedAt DateTime?            @map("processing_started_at")
  errorCode           String?              @map("error_code")
  recordCount         Int                  @map("record_count")
  fieldCount          Int?                 @map("field_count")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  expiresAt           DateTime             @map("expires_at")

  @@unique([createdBy, requestKey])
  @@index([resourceType, resourceId])
  @@index([status, updatedAt])
  @@index([expiresAt])
  @@map("export_batches")
}

// Metadata authority for generated exports. The file itself remains on the
// configured export storage; every download must resolve through this row.
model ExportArtifact {
  id           String               @id @default(uuid())
  resourceType String               @map("resource_type")
  resourceId   String               @map("resource_id")
  createdBy    String               @map("created_by")
  format       String
  anonymized   Boolean              @default(false)
  storageKey   String               @map("storage_key")
  status       ExportArtifactStatus @default(READY)
  batchId      String?              @map("batch_id")
  errorCode    String?              @map("error_code")
  createdAt    DateTime             @default(now()) @map("created_at")
  expiresAt    DateTime             @map("expires_at")

  provenance Json?

  creator User @relation("ExportArtifactCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId])
  @@index([createdBy])
  @@index([expiresAt])
  @@index([status, createdAt])
  @@index([batchId])
  @@map("export_artifacts")
}

// 课程-问卷关联表
model CourseQuestionnaire {
  id              String   @id @default(uuid())
  courseId        String   @map("course_id")
  questionnaireId String   @map("questionnaire_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // 关联
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([courseId, questionnaireId])
  @@map("course_questionnaires")
}

// ==================== 表单题目模块 ====================

// 表单题目表（问卷级别的表单字段）
model QuestionnaireFormItem {
  id              String   @id @default(uuid())
  questionnaireId String   @map("questionnaire_id")
  type            String // 题目类型：fill_blank / single_choice / text_input
  label           String // 题目标签（如"性别"、"年龄"）
  placeholder     String? // 占位提示文字
  required        Boolean  @default(true) // 是否必填
  position        Int      @default(0) // 统一排序位置（与量表共享排序空间）
  sectionId       String?  @map("section_id")
  sectionPosition Int?     @map("section_position")
  options         Json? // 单选选项列表 [{value: "male", label: "男"}]
  contextKey      String?  @map("context_key")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // 关联
  questionnaire Questionnaire             @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  section       QuestionnaireFormSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  answers       QuestionnaireFormAnswer[]

  @@unique([questionnaireId, contextKey])
  // 性能优化索引
  @@index([questionnaireId, position])
  @@index([sectionId, sectionPosition])
  @@map("questionnaire_form_items")
}

model QuestionnaireFormSectionAttempt {
  id                        String           @id @default(uuid())
  questionnaireAssessmentId String           @map("questionnaire_assessment_id")
  sectionId                 String           @map("section_id")
  status                    AssessmentStatus @default(IN_PROGRESS)
  attemptEpoch              Int              @default(1) @map("attempt_epoch")
  submissionId              String?          @unique @map("submission_id")
  submissionPayloadHash     String?          @map("submission_payload_hash")
  submittedAt               DateTime?        @map("submitted_at")
  frozenAdmissionSnapshotEncrypted String?   @map("frozen_admission_snapshot_encrypted")
  frozenAdmissionSnapshotHash      String?   @map("frozen_admission_snapshot_hash")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")

  questionnaireAssessment QuestionnaireAssessment   @relation(fields: [questionnaireAssessmentId], references: [id], onDelete: Cascade)
  section                 QuestionnaireFormSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers                 QuestionnaireFormAnswer[]

  @@unique([questionnaireAssessmentId, sectionId])
  @@index([questionnaireAssessmentId, status])
  @@map("questionnaire_form_section_attempts")
}

// 表单答案表
model QuestionnaireFormAnswer {
  id                        String                        @id @default(uuid())
  questionnaireAssessmentId String                        @map("questionnaire_assessment_id")
  formItemId                String                        @map("form_item_id")
  formSectionAttemptId      String?                       @map("form_section_attempt_id")
  value                     String? // 用户填写的答案值；SKIPPED/PENDING 可为空
  status                    QuestionnaireFormAnswerStatus @default(PENDING)
  revision                  Int                           @default(0) // 单题答案 OCC 版本
  createdAt                 DateTime                      @default(now()) @map("created_at")

  // 关联
  questionnaireAssessment QuestionnaireAssessment          @relation(fields: [questionnaireAssessmentId], references: [id], onDelete: Cascade)
  formItem                QuestionnaireFormItem            @relation(fields: [formItemId], references: [id], onDelete: Cascade)
  formSectionAttempt      QuestionnaireFormSectionAttempt? @relation(fields: [formSectionAttemptId], references: [id], onDelete: SetNull)

  @@unique([questionnaireAssessmentId, formItemId])
  @@index([questionnaireAssessmentId])
  @@index([formSectionAttemptId])
  @@map("questionnaire_form_answers")
}

// ==================== 心理量表 + 认知任务综合测评 ====================

enum CompositeAssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CompositeAssessmentItemType {
  SCALE
  COGNITIVE
  FORM
  SITUATIONAL
}

enum CompositeAssessmentAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum CompositeAnalysisSnapshotGenerationReason {
  COMPLETION
  REANALYSIS
}

// 综合测评模板。发布后项目配置不可修改，历史测评通过子记录保存各自的结果快照。
model CompositeAssessment {
  trainingFeedbackPolicy Json? @map("training_feedback_policy")
  trainingFeedbackPolicyHash String? @map("training_feedback_policy_hash")
  trainingPersistencePolicy Json? @map("training_persistence_policy")
  trainingPersistencePolicyHash String? @map("training_persistence_policy_hash")
  trainingFlowDraft Json? @map("training_flow_draft")
  trainingFlowFrozen Json? @map("training_flow_frozen")
  trainingFlowDigest String? @map("training_flow_digest")
  trainingVariantDraft Json? @map("training_variant_draft")
  trainingVariantFrozen Json? @map("training_variant_frozen")
  trainingVariantDigest String? @map("training_variant_digest")
  trainingTimingPolicy Json? @map("training_timing_policy")
  timingExportEnabled Boolean @default(false) @map("timing_export_enabled")
  compositionTemplates AssessmentCompositionTemplate[]
  productKind         String @default("LEGACY_COMPOSITE") @map("product_kind")
  questionnaireType   QuestionnaireType? @map("questionnaire_type")
  revision            Int @default(0)
  creationKey         String? @unique @map("creation_key")
  creationHash        String? @map("creation_hash")
  bundleInstance       BundleInstance?
  questionnaireCourses QuestionnaireCourseDelivery[]
  id                                String                    @id @default(uuid())
  code                              String                    @unique
  name                              String
  description                       String?
  instruction                       String?
  status                            CompositeAssessmentStatus @default(DRAFT)
  courseId                          String?                   @map("course_id")
  createdBy                         String?                   @map("created_by")
  opensAt                           DateTime?                 @map("opens_at")
  expiresAt                         DateTime?                 @map("expires_at")
  maxAttempts                       Int                       @default(1) @map("max_attempts")
  publicEnabled                     Boolean                   @default(false) @map("public_enabled")
  copyable                          Boolean                   @default(false) @map("copyable")
  copiedFromId                      String?                   @map("copied_from_id")
  analysisProtocolKey               String?                   @map("analysis_protocol_key")
  analysisProtocolVersion           String?                   @map("analysis_protocol_version")
  analysisProtocolSnapshotEncrypted String?                   @map("analysis_protocol_snapshot_encrypted")
  // PR6B package boundary. The legacy analysisProtocol* fields remain readable
  // for historical composites; new package instances use these frozen fields.
  reportPackageKey                  String?                   @map("report_package_key")
  reportPackageVersion              String?                   @map("report_package_version")
  reportPackageProfile              String?                   @map("report_package_profile")
  reportPackageSnapshotEncrypted    String?                   @map("report_package_snapshot_encrypted")
  createdAt                         DateTime                  @default(now()) @map("created_at")
  updatedAt                         DateTime                  @updatedAt @map("updated_at")
  publishedAt                       DateTime?                 @map("published_at")

  course       Course?                          @relation("CourseCompositeAssessments", fields: [courseId], references: [id], onDelete: SetNull)
  creator      User?                            @relation("CompositeAssessmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  copiedFrom   CompositeAssessment?             @relation("CompositeCopySource", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       CompositeAssessment[]            @relation("CompositeCopySource")
  items        CompositeAssessmentItem[]
  formSections CompositeFormSection[]
  accessTokens CompositeAssessmentAccessToken[]
  attempts     CompositeAssessmentAttempt[]

  @@index([courseId, status])
  @@index([createdBy, status])
  @@index([copyable, status])
  @@index([reportPackageKey, reportPackageVersion], map: "composite_assessments_report_package_key_version_idx")
  @@map("composite_assessments")
}

// Private reusable definitions. Prototype drafts contain no deliveries/answers.
model AssessmentCompositionTemplate {
  id String @id @default(uuid())
  ownerId String @map("owner_id")
  definitionId String @unique @map("definition_id")
  name String
  requestKey String @unique @map("request_key")
  requestHash String @map("request_hash")
  archivedAt DateTime? @map("archived_at")
  createdAt DateTime @default(now()) @map("created_at")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  definition CompositeAssessment @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  @@index([ownerId, createdAt])
  @@map("assessment_composition_templates")
}

model AssessmentManagementEvent {
  id String @id @default(uuid())
  actorId String @map("actor_id")
  resourceId String @map("resource_id")
  action String
  metadata Json
  createdAt DateTime @default(now()) @map("created_at")
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
  @@index([actorId, createdAt])
  @@map("assessment_management_events")
}

// 综合测评中按 position 排序的模块。一个模块只允许填写 scale/cognitive/form 三类中的一种。
model CompositeAssessmentItem {
  id                    String                      @id @default(uuid())
  compositeAssessmentId String                      @map("composite_assessment_id")
  type                  CompositeAssessmentItemType
  position              Int                         @default(0)
  required              Boolean                     @default(true)
  scaleId               String?                     @map("scale_id")
  cognitiveAssignmentId String?                     @map("cognitive_assignment_id")
  situationalInstrumentKey     String?              @map("situational_instrument_key")
  situationalInstrumentVersion String?              @map("situational_instrument_version")
  formType              String?                     @map("form_type")
  formLabel             String?                     @map("form_label")
  formPlaceholder       String?                     @map("form_placeholder")
  formOptions           Json?                       @map("form_options")
  formPolicy Json? @map("form_policy")
  formDefinition        Json?                       @map("form_definition")
  contextKey            String?                     @map("context_key")
  formSectionId         String?                     @map("form_section_id")
  formSectionPosition   Int?                        @map("form_section_position")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  compositeAssessment CompositeAssessment   @relation(fields: [compositeAssessmentId], references: [id], onDelete: Cascade)
  scale               Scale?                @relation("CompositeAssessmentScale", fields: [scaleId], references: [id], onDelete: Restrict)
  cognitiveAssignment CognitiveAssignment?  @relation("CompositeAssessmentCognitiveAssignment", fields: [cognitiveAssignmentId], references: [id], onDelete: Restrict)
  scaleAssessments    Assessment[]          @relation("CompositeScaleAssessments")
  cognitiveSessions   CognitiveSession[]    @relation("CompositeCognitiveSessions")
  situationalAttempts SituationalAttempt[]  @relation("CompositeSituationalAttempts")
  formAnswers         CompositeFormAnswer[]
  formSection         CompositeFormSection? @relation(fields: [formSectionId], references: [id], onDelete: SetNull)

  @@unique([compositeAssessmentId, position])
  @@unique([compositeAssessmentId, contextKey])
  @@index([scaleId])
  @@index([cognitiveAssignmentId])
  @@index([formSectionId, formSectionPosition])
  @@map("composite_assessment_items")
}

model CompositeFormSection {
  id                    String   @id @default(uuid())
  compositeAssessmentId String   @map("composite_assessment_id")
  title                 String   @default("表单")
  description           String?
  position              Int      @default(0)
  contextSection        Boolean  @default(false) @map("context_section")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  compositeAssessment CompositeAssessment           @relation(fields: [compositeAssessmentId], references: [id], onDelete: Cascade)
  items               CompositeAssessmentItem[]
  attempts            CompositeFormSectionAttempt[]

  @@unique([compositeAssessmentId, position])
  @@index([compositeAssessmentId])
  @@map("composite_form_sections")
}

// 一次学生/匿名参与记录。recoveryTokenHash 只存哈希，原始恢复凭证只在创建时返回一次。
model CompositeAssessmentAttempt {
  trainingFeedbackSnapshot Json? @map("training_feedback_snapshot")
  trainingFeedbackSnapshotHash String? @map("training_feedback_snapshot_hash")
  trainingPersistenceSnapshot Json? @map("training_persistence_snapshot")
  trainingPersistenceSnapshotHash String? @map("training_persistence_snapshot_hash")
  trainingCheckpoint TrainingAttemptCheckpoint?
  trainingFlowSnapshotEncrypted String? @map("training_flow_snapshot_encrypted")
  trainingFlowSnapshotHash String? @map("training_flow_snapshot_hash")
  trainingFlowPathEncrypted String? @map("training_flow_path_encrypted")
  trainingFlowPathHash String? @map("training_flow_path_hash")
  trainingVariantAllocationEncrypted String? @map("training_variant_allocation_encrypted")
  trainingVariantAllocationHash String? @map("training_variant_allocation_hash")
  trainingTimingSnapshot Json? @map("training_timing_snapshot")
  taskSatisfaction String? @map("task_satisfaction")
  frozenControlBindings AssessmentFrozenBinding[]
  // Set atomically with the first durable report outbox event; survives disabling new admission.
  asyncReportEpoch Int? @map("async_report_epoch")
  deliveryCourseId String? @map("delivery_course_id")
  id                           String                           @id @default(uuid())
  compositeAssessmentId        String                           @map("composite_assessment_id")
  userId                       String?                          @map("user_id")
  accessTokenId                String?                          @map("access_token_id")
  recoveryTokenHash            String?                          @unique @map("recovery_token_hash")
  participantKey               String                           @map("participant_key")
  anonymousCode                String?                          @map("anonymous_code")
  attemptNo                    Int                              @default(1) @map("attempt_no")
  status                       CompositeAssessmentAttemptStatus @default(IN_PROGRESS)
  deliveryMode                 InstrumentDeliveryMode           @default(FINAL_ONLY) @map("delivery_mode")
  runtimeGeneration            RuntimeGeneration?               @map("runtime_generation")
  attemptEpoch                 Int                              @default(1) @map("attempt_epoch")
  progress                     Int                              @default(0)
  completedItems               Int                              @default(0) @map("completed_items")
  startedAt                    DateTime                         @default(now()) @map("started_at")
  lastSavedAt                  DateTime                         @default(now()) @map("last_saved_at")
  completedAt                  DateTime?                        @map("completed_at")
  totalTime                    Int?                             @map("total_time")
  contextSnapshotEncrypted     String?                          @map("context_snapshot_encrypted")
  contextSnapshotHash          String?                          @map("context_snapshot_hash")
  contextFrozenAt              DateTime?                        @map("context_frozen_at")
  aggregateInputHash           String?                          @map("aggregate_input_hash")
  compiledBundleRuntimeHash    String?                          @map("compiled_bundle_runtime_hash")
  frozenActiveSlotSetEncrypted String?                          @map("frozen_active_slot_set_encrypted")
  frozenActiveSlotSetHash      String?                          @map("frozen_active_slot_set_hash")
  // Additive identity (Commit 11). Historical rows stay null — never infer from userId.
  subjectUserId                String?                          @map("subject_user_id")
  respondentUserId             String?                          @map("respondent_user_id")
  respondentType               String?                          @map("respondent_type")
  episodeId                    String?                          @map("episode_id")
  assignmentRef                String?                          @map("assignment_ref")
  consentId                    String?                          @map("consent_id")
  contextSnapshotRef           String?                          @map("context_snapshot_ref")

  compositeAssessment CompositeAssessment             @relation(fields: [compositeAssessmentId], references: [id], onDelete: Cascade)
  episode             AssessmentEpisode?              @relation(fields: [episodeId], references: [id], onDelete: Restrict)
  consent             AssessmentAttemptConsent?       @relation(fields: [consentId], references: [id], onDelete: Restrict)
  user                User?                           @relation("CompositeAttemptUser", fields: [userId], references: [id], onDelete: SetNull)
  accessToken         CompositeAssessmentAccessToken? @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)
  scaleAssessments    Assessment[]                    @relation("CompositeAttemptAssessments")
  cognitiveSessions   CognitiveSession[]              @relation("CompositeAttemptCognitiveSessions")
  situationalAttempts SituationalAttempt[]            @relation("CompositeAttemptSituationalAttempts")
  formAnswers         CompositeFormAnswer[]
  formSectionAttempts CompositeFormSectionAttempt[]
  bundleAnalyses      BundleAnalysis[]
  analysisSnapshots   CompositeAnalysisSnapshot[]
  unitSnapshots       AssessmentUnitSnapshot[]        @relation("CompositeAssessmentUnitSnapshots")

  @@unique([compositeAssessmentId, participantKey, attemptNo], map: "composite_attempts_assessment_participant_no_key")
  @@index([compositeAssessmentId, status])
  @@index([userId, status])
  @@index([participantKey])
  @@index([accessTokenId])
  @@index([subjectUserId, status])
  @@index([respondentUserId, status])
  @@index([episodeId])
  @@map("composite_assessment_attempts")
}

// Package-scoped cognitive analysis output. Rows are append-only at the
// application level; the completion row is the historical default and an
// explicit reanalysis creates a separate row.
model CompositeAnalysisSnapshot {
  id                        String                                    @id @default(uuid())
  attemptId                 String                                    @map("attempt_id")
  packageKey                String                                    @map("package_key")
  packageVersion            String                                    @map("package_version")
  analysisDefinitionVersion String                                    @map("analysis_definition_version")
  analysisVersion           String                                    @map("analysis_version")
  reportSchemaVersion       String                                    @map("report_schema_version")
  inputFingerprint          String                                    @map("input_fingerprint")
  generationReason          CompositeAnalysisSnapshotGenerationReason @map("generation_reason")
  generatedBy               String?                                   @map("generated_by")
  payloadEncrypted          String                                    @map("payload_encrypted")
  aggregateInputHash        String?                                   @map("aggregate_input_hash")
  hashScheme                String?                                   @map("hash_scheme")
  compiledBundleRuntimeHash String?                                   @map("compiled_bundle_runtime_hash")
  attemptEpoch              Int?                                      @map("attempt_epoch")
  contextHash               String?                                   @map("context_hash")
  runtimeGeneration         RuntimeGeneration?                        @map("runtime_generation")
  createdAt                 DateTime                                  @default(now()) @map("created_at")

  attempt   CompositeAssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  generator User?                      @relation("CompositeAnalysisSnapshotGenerator", fields: [generatedBy], references: [id], onDelete: SetNull)

  @@unique([attemptId, analysisVersion, inputFingerprint], map: "composite_analysis_snapshots_attempt_version_fingerprint_key")
  @@index([attemptId, generationReason, createdAt], map: "composite_analysis_snapshots_attempt_reason_created_idx")
  @@map("composite_analysis_snapshots")
}

model CompositeFormAnswer {
  id                   String   @id @default(uuid())
  attemptId            String   @map("attempt_id")
  itemId               String   @map("item_id")
  formSectionAttemptId String?  @map("form_section_attempt_id")
  value                String
  completed            Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  attempt            CompositeAssessmentAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  item               CompositeAssessmentItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  formSectionAttempt CompositeFormSectionAttempt? @relation(fields: [formSectionAttemptId], references: [id], onDelete: SetNull)

  @@unique([attemptId, itemId])
  @@index([attemptId])
  @@index([formSectionAttemptId])
  @@map("composite_form_answers")
}

model CompositeFormSectionAttempt {
  taskSatisfaction String? @map("task_satisfaction")
  id                    String                           @id @default(uuid())
  attemptId             String                           @map("attempt_id")
  sectionId             String                           @map("section_id")
  status                CompositeAssessmentAttemptStatus @default(IN_PROGRESS)
  attemptEpoch          Int                              @default(1) @map("attempt_epoch")
  submissionId          String?                          @unique @map("submission_id")
  submissionPayloadHash String?                          @map("submission_payload_hash")
  submittedAt           DateTime?                        @map("submitted_at")
  frozenAdmissionSnapshotEncrypted String?               @map("frozen_admission_snapshot_encrypted")
  frozenAdmissionSnapshotHash      String?               @map("frozen_admission_snapshot_hash")
  createdAt             DateTime                         @default(now()) @map("created_at")
  updatedAt             DateTime                         @updatedAt @map("updated_at")

  attempt CompositeAssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section CompositeFormSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers CompositeFormAnswer[]

  @@unique([attemptId, sectionId])
  @@index([attemptId, status])
  @@map("composite_form_section_attempts")
}

model CompositeAssessmentAccessToken {
  trainingRoundId       String? @map("training_round_id")
  trainingRound         TrainingPublicRound? @relation(fields:[trainingRoundId], references:[id], onDelete:Restrict, onUpdate:NoAction)
  id                    String   @id @default(uuid())
  compositeAssessmentId String   @map("composite_assessment_id")
  // Legacy plaintext is nullable during the resumable application backfill.
  // New rows persist only a deterministic lookup hash and encrypted bearer.
  token                 String?  @unique
  tokenHash             String?  @unique @map("token_hash")
  tokenEncrypted        String?  @map("token_encrypted")
  createdBy             String   @map("created_by")
  expiresAt             DateTime @map("expires_at")
  maxUses               Int      @default(0) @map("max_uses")
  usedCount             Int      @default(0) @map("used_count")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")

  compositeAssessment CompositeAssessment          @relation(fields: [compositeAssessmentId], references: [id], onDelete: Cascade)
  creator             User                         @relation("CompositeTokenCreator", fields: [createdBy], references: [id])
  attempts            CompositeAssessmentAttempt[]

  @@index([compositeAssessmentId])
  @@index([isActive, expiresAt])
  @@index([token])
  @@map("composite_assessment_access_tokens")
  @@index([trainingRoundId])
}

// ==================== 文档库模块 ====================

// 文档表
model Document {
  id         String    @id @default(uuid())
  title      String
  filePath   String    @map("file_path")
  fileName   String    @map("file_name")
  fileSize   Int       @map("file_size")
  mimeType   String    @default("application/pdf") @map("mime_type")
  teacherId  String    @map("teacher_id")
  usageCount Int       @default(0) @map("usage_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  tags       String[]  @default([])
  pageCount  Int?      @map("page_count")
  cosUrl     String?   @map("cos_url")
  cosKey     String?   @map("cos_key")
  assetId    String?   @map("asset_id")

  // 关联
  teacher User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  asset   StoredAsset? @relation("DocumentAsset", fields: [assetId], references: [id], onDelete: SetNull)

  // 性能优化索引
  @@index([createdAt])
  @@index([teacherId])
  @@map("documents")
}

// ==================== 统一文件资产 ====================

model StoredAsset {
  id           String    @id @default(uuid())
  objectKey    String    @unique @map("object_key")
  storageObjectKey String? @map("storage_object_key")
  duplicateCleanupPending Boolean @default(false) @map("duplicate_cleanup_pending")
  provider     String    @default("local")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  sha256       String
  originalName String?   @map("original_name")
  ownerId      String?   @map("owner_id")
  accessScope  String    @default("PRIVATE") @map("access_scope")
  scopeId      String?   @map("scope_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  courseCovers    Course[]         @relation("CourseCoverAsset")
  documents       Document[]       @relation("DocumentAsset")
  videoOriginals  Video[]          @relation("VideoOriginalAsset")
  videoProcessed  Video[]          @relation("VideoProcessedAsset")
  videoThumbnails Video[]          @relation("VideoThumbnailAsset")
  references      AssetReference[]
  instrumentAuthorizationEvidence InstrumentAuthorization[] @relation("InstrumentAuthorizationEvidence")

  @@index([ownerId])
  @@index([accessScope, scopeId])
  @@index([storageObjectKey])
  @@index([provider, sha256, sizeBytes, mimeType, deletedAt, createdAt(sort: Desc), id(sort: Desc)], map: "stored_assets_content_lookup_idx")
  @@map("stored_assets")
}

model AssetReference {
  id         String      @id @default(uuid())
  assetId    String      @map("asset_id")
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  field      String
  createdAt  DateTime    @default(now()) @map("created_at")
  asset      StoredAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, entityType, entityId, field])
  @@index([entityType, entityId])
  @@map("asset_references")
}

// ==================== 课堂互动模块 ====================

// 课堂状态枚举
enum ClassroomStatus {
  PREPARING // 准备中
  ACTIVE // 进行中
  ENDED // 已结束
}

// 课堂表
model Classroom {
  endSummary ClassroomEndSummary?
  id              String          @id @default(uuid())
  code            String          @unique // 课堂码（6位数字）
  name            String // 课堂名称
  courseId        String          @map("course_id") // 关联课程
  status          ClassroomStatus @default(PREPARING) // 状态
  questionnaireId String?         @map("questionnaire_id") // 可选：关联问卷复用题目
  creatorId       String          @map("creator_id") // 创建者ID
  startedAt       DateTime?       @map("started_at") // 开始时间
  endedAt         DateTime?       @map("ended_at") // 结束时间
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // 关联
  course          Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator         User                @relation("ClassroomCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  sessions        ClassroomSession[]
  questions       ClassroomQuestion[]
  ClassroomAnswer ClassroomAnswer[]

  // 性能优化索引
  @@index([code])
  @@index([courseId])
  @@index([status])
  @@index([creatorId])
  @@map("classrooms")
}

model ClassroomEndSummary {
  classroomId String @id @map("classroom_id")
  createdBy String @map("created_by")
  frozenAt DateTime @default(now()) @map("frozen_at")
  payload Json
  contentHash String @map("content_hash")
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  @@map("classroom_end_summaries")
}

// 课堂会话表（学生参与记录）
model ClassroomSession {
  id          String    @id @default(uuid())
  classroomId String    @map("classroom_id")
  studentId   String    @map("student_id") // 学生ID（临时学生使用temp_开头）
  joinedAt    DateTime  @default(now()) @map("joined_at") // 加入时间
  leftAt      DateTime? @map("left_at") // 离开时间
  isTemporary Boolean   @default(false) @map("is_temporary") // 是否为临时学生

  // 关联
  classroom Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  // 注意：studentId 字段存储学生ID，但移除外键约束以支持临时学生
  // 对于临时学生（studentId以temp_开头），不关联User表
  // 对于正式学生，代码层面确保studentId存在
  answers   ClassroomAnswer[]

  // 性能优化索引
  @@unique([classroomId, studentId])
  @@index([classroomId])
  @@index([studentId])
  @@index([isTemporary])
  @@map("classroom_sessions")
}

// 课堂题目表
model ClassroomQuestion {
  id              String    @id @default(uuid())
  classroomId     String    @map("classroom_id")
  formItemId      String?   @map("form_item_id") // 可选：关联表单题目
  questionIndex   Int       @map("question_index") // 题号
  questionContent Json // 题目内容快照
  timeLimit       Int?      @map("time_limit") // 答题时限（秒）
  startedAt       DateTime? @map("started_at") // 开始时间
  endedAt         DateTime? @map("ended_at") // 结束时间

  // 关联
  classroom Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  answers   ClassroomAnswer[]

  // 性能优化索引
  @@unique([classroomId, questionIndex])
  @@index([classroomId])
  @@index([classroomId, questionIndex])
  @@map("classroom_questions")
}

// 课堂答案表
model ClassroomAnswer {
  id          String   @id @default(uuid())
  classroomId String   @map("classroom_id")
  questionId  String   @map("question_id")
  sessionId   String   @map("session_id")
  answer      Json // 答案内容
  submittedAt DateTime @default(now()) @map("submitted_at") // 提交时间

  // 关联
  classroom Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  question  ClassroomQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session   ClassroomSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // 性能优化索引
  @@unique([questionId, sessionId])
  @@index([classroomId])
  @@index([questionId])
  @@index([sessionId])
  @@map("classroom_answers")
}

// ==================== 匿名打卡模块 ====================

// 打卡访问令牌表
model CheckinAccessToken {
  id             String              @id @default(uuid())
  checkinId      String              @map("checkin_id")
  // Legacy plaintext is retained nullable only during the resumable
  // application-level backfill window. New writes use hash + encryption.
  token          String?             @unique
  tokenHash      String?             @unique @map("token_hash")
  tokenEncrypted String?             @map("token_encrypted")
  createdBy      String              @map("created_by")
  expiresAt      DateTime            @map("expires_at")
  maxUses        Int                 @default(0) @map("max_uses")
  usedCount      Int                 @default(0) @map("used_count")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  checkin        Checkin             @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  creator        User                @relation("CheckinTokenCreator", fields: [createdBy], references: [id])
  submissions    CheckinSubmission[]

  @@index([checkinId])
  @@index([expiresAt])
  @@index([isActive, expiresAt])
  @@index([token])
  @@map("checkin_access_tokens")
}

// ==================== 认知测评核心模块 (Milestone D / v1.2) ====================
//
// 数据保留与不可变原则（见 Milestone D v1.2 收口文档）：
//   - User 删除            -> CognitiveSession.userId 置空（SetNull），participantKey 保留
//   - Course 删除          -> CognitiveAssignment.courseId 置空（SetNull），courseSnapshot 保留
//   - CognitiveTestConfig  -> 被 Assignment/Session 引用时禁止物理删除（Restrict），只能 RETIRE
//   - CognitiveAssignment  -> 有 Session 后禁止物理删除（Restrict），只能 ARCHIVE
//   - CognitiveSession     -> 删除时 Trial 允许 Cascade
//   - CognitiveTrial       -> append-only，无 updatedAt

enum CognitiveConfigStatus {
  DRAFT // 草稿，可编辑
  PUBLISHED // 已发布，核心字段不可变
  RETIRED // 已退役，不再用于新 Assignment，历史 Session 继续引用
}

enum CognitiveAssignmentStatus {
  DRAFT // 草稿
  PUBLISHED // 已发布，实验核心字段不可变
  ARCHIVED // 已归档，禁止物理删除（有 Session 时）
}

enum CognitiveSessionStatus {
  IN_PROGRESS // 进行中
  COMPLETED // 已完成
  ABANDONED // 已放弃（RESTART 策略产生）
  INVALID // 服务端校验失败
}

// 认知测试配置（任务定义）。config 为任务参数（非参与者原始行为数据），按明文 Json 存储。
model CognitiveTestConfig {
  measurementReleaseId String? @map("measurement_release_id")
  measurementRelease MeasurementContentRelease? @relation(fields:[measurementReleaseId],references:[id],onDelete:Restrict,onUpdate:NoAction,map:"cognitive_config_measurement_release_fkey")
  id             String                      @id @default(uuid())
  testType       String                      @map("test_type")
  configVersion  String                      @map("config_version")
  name           String
  instruction    String?
  config         Json? // 任务定义（刺激参数、计数等），非参与者行为数据
  status         CognitiveConfigStatus       @default(DRAFT)
  engineVersion  String                      @map("engine_version")
  scoringVersion String                      @map("scoring_version")
  accessPolicy   CognitiveConfigAccessPolicy @default(OPEN) @map("access_policy")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
  publishedAt    DateTime?                   @map("published_at")

  assignments CognitiveAssignment[]
  sessions    CognitiveSession[]

  @@unique([testType, configVersion])
  @@index([testType, status])
  @@map("cognitive_test_configs")
}

// 认知测评分发（课程作业）。courseId 可空 + SetNull，保留 courseSnapshot 以抵御课程删除。
model CognitiveAssignment {
  id                              String                    @id @default(uuid())
  courseId                        String?                   @map("course_id")
  courseSnapshot                  Json?                     @map("course_snapshot")
  configId                        String                    @map("config_id")
  createdBy                       String?                   @map("created_by")
  title                           String
  instruction                     String?
  status                          CognitiveAssignmentStatus @default(DRAFT)
  opensAt                         DateTime?                 @map("opens_at")
  dueAt                           DateTime?                 @map("due_at")
  maxAttempts                     Int                       @default(1) @map("max_attempts")
  quotaSourceAssignmentId         String?                   @map("quota_source_assignment_id")
  required                        Boolean                   @default(true)
  createdAt                       DateTime                  @default(now()) @map("created_at")
  updatedAt                       DateTime                  @updatedAt @map("updated_at")
  publishedAt                     DateTime?                 @map("published_at")
  listedStandalone                Boolean                   @default(true) @map("listed_standalone")
  profile                         String?
  profileDefinitionVersion        String?                   @map("profile_definition_version")
  resolvedConfigSnapshotEncrypted String?                   @map("resolved_config_snapshot_encrypted")
  resolvedConfigHash              String?                   @map("resolved_config_hash")
  resolvedReportSnapshotEncrypted String?                   @map("resolved_report_snapshot_encrypted")

  course         Course?                   @relation("CourseCognitiveAssignments", fields: [courseId], references: [id], onDelete: SetNull)
  config         CognitiveTestConfig       @relation(fields: [configId], references: [id], onDelete: Restrict)
  creator        User?                     @relation("AssignmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  sessions       CognitiveSession[]
  compositeItems CompositeAssessmentItem[] @relation("CompositeAssessmentCognitiveAssignment")
  accessTokens   CognitiveAccessToken[]
  quotaSource    CognitiveAssignment?      @relation("CognitiveQuotaSource", fields: [quotaSourceAssignmentId], references: [id], onDelete: Restrict)
  quotaCopies    CognitiveAssignment[]     @relation("CognitiveQuotaSource")

  @@index([courseId])
  @@index([quotaSourceAssignmentId])
  @@map("cognitive_assignments")
}

// 认知测评会话。所有敏感字段以密文存储（*Encrypted，统一 Cognitive 信封）。
// participantSnapshotEncrypted 为预留的身份快照（即使 User 被删除也保留必要历史信息），
// D4 Session API 写入时须用 Cognitive strict encryption 加密，禁止写入明文身份数据。
model CognitiveSession {
  id                           String                 @id @default(uuid())
  userId                       String?                @map("user_id")
  participantKey               String                 @map("participant_key")
  participantSnapshotEncrypted String?                @map("participant_snapshot_encrypted")
  assignmentId                 String?                @map("assignment_id")
  compositeAttemptId           String?                @map("composite_attempt_id")
  compositeItemId              String?                @map("composite_item_id")
  accessTokenId                String?                @map("access_token_id")
  recoveryTokenHash            String?                @unique @map("recovery_token_hash")
  anonymousCode                String?                @map("anonymous_code")
  configId                     String                 @map("config_id")
  testType                     String                 @map("test_type")
  attemptNo                    Int                    @default(1) @map("attempt_no")
  status                       CognitiveSessionStatus @default(IN_PROGRESS)
  startedAt                    DateTime               @default(now()) @map("started_at")
  finishedAt                   DateTime?              @map("finished_at")
  scoreEncrypted               String?                @map("score_encrypted")
  metricsEncrypted             String?                @map("metrics_encrypted")
  qualityFlagsEncrypted        String?                @map("quality_flags_encrypted")
  resultSnapshotEncrypted      String?                @map("result_snapshot_encrypted")
  configVersion                String                 @map("config_version")
  configSnapshotEncrypted      String                 @map("config_snapshot_encrypted")
  engineVersion                String                 @map("engine_version")
  scoringVersion               String                 @map("scoring_version")
  randomSeed                   String                 @map("random_seed")
  completionKey                String?                @map("completion_key")
  deliveryMode                 InstrumentDeliveryMode @default(FINAL_ONLY) @map("delivery_mode")
  runtimeGeneration            RuntimeGeneration?     @map("runtime_generation")
  compiledRuntimeHash          String?                @map("compiled_runtime_hash")
  submissionId                 String?                @unique @map("submission_id")
  submissionPayloadHash        String?                @map("submission_payload_hash")
  submittedAt                  DateTime?              @map("submitted_at")
  frozenAdmissionSnapshotEncrypted String?            @map("frozen_admission_snapshot_encrypted")
  frozenAdmissionSnapshotHash      String?            @map("frozen_admission_snapshot_hash")
  createdAt                    DateTime               @default(now()) @map("created_at")
  updatedAt                    DateTime               @updatedAt @map("updated_at")

  user             User?                       @relation("SessionUser", fields: [userId], references: [id], onDelete: SetNull)
  assignment       CognitiveAssignment?        @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  config           CognitiveTestConfig         @relation(fields: [configId], references: [id], onDelete: Restrict)
  compositeAttempt CompositeAssessmentAttempt? @relation("CompositeAttemptCognitiveSessions", fields: [compositeAttemptId], references: [id], onDelete: Cascade)
  compositeItem    CompositeAssessmentItem?    @relation("CompositeCognitiveSessions", fields: [compositeItemId], references: [id], onDelete: Restrict)
  accessToken      CognitiveAccessToken?       @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)
  trials           CognitiveTrial[]
  rawSubmissions   CognitiveRawSubmission[]

  // 同一分发下，按稳定匿名标识 participantKey + 尝试次数保证唯一；
  // assignmentId 为 NULL 的内部直测会话依赖应用层保证（见 v1.2 P0-4）。
  @@unique([assignmentId, participantKey, attemptNo])
  @@index([userId, status])
  @@index([assignmentId])
  @@index([configId])
  @@index([compositeAttemptId])
  @@index([compositeItemId])
  @@index([accessTokenId])
  @@index([recoveryTokenHash])
  @@index([participantKey])
  @@map("cognitive_sessions")
}

// 单个认知任务的公开链接。公开参与始终 userId=NULL，不能仅靠“导出脱敏”冒充匿名。
model CognitiveAccessToken {
  id             String   @id @default(uuid())
  assignmentId   String   @map("assignment_id")
  // Legacy plaintext is nullable during the resumable application backfill.
  // New rows persist only a deterministic lookup hash and encrypted bearer.
  token          String?  @unique
  tokenHash      String?  @unique @map("token_hash")
  tokenEncrypted String?  @map("token_encrypted")
  createdBy      String   @map("created_by")
  expiresAt      DateTime @map("expires_at")
  maxUses        Int      @default(0) @map("max_uses")
  usedCount      Int      @default(0) @map("used_count")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  assignment CognitiveAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  creator    User                @relation("CognitiveTokenCreator", fields: [createdBy], references: [id])
  sessions   CognitiveSession[]

  @@index([assignmentId])
  @@index([isActive, expiresAt])
  @@index([token])
  @@map("cognitive_access_tokens")
}

// 认知原始试次。append-only：无 updatedAt；payloadHash 用于幂等/冲突判断。
model CognitiveTrial {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  trialIndex       Int      @map("trial_index")
  payloadEncrypted String   @map("payload_encrypted")
  payloadHash      String   @map("payload_hash")
  createdAt        DateTime @default(now()) @map("created_at")

  session CognitiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, trialIndex])
  @@index([sessionId])
  @@map("cognitive_trials")
}

// Unified Cognitive final submissions persist the normalized trial sequence as
// one strict encrypted payload. Legacy CognitiveTrial rows remain readable for
// historical and legacy-generation sessions.
model CognitiveRawSubmission {
  id                   String   @id @default(uuid())
  sessionId            String   @map("session_id")
  attemptEpoch         Int      @map("attempt_epoch")
  trialCount           Int      @map("trial_count")
  payloadEncrypted     String   @map("payload_encrypted")
  payloadSchemaVersion Int      @map("payload_schema_version")
  encodingVersion      String   @map("encoding_version")
  createdAt            DateTime @default(now()) @map("created_at")

  session CognitiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, attemptEpoch], map: "cognitive_raw_submissions_session_epoch_key")
  @@index([sessionId])
  @@map("cognitive_raw_submissions")
}

// Immutable terminal fact for an active questionnaire/composite slot. The
// encrypted payload is either a CanonicalUnitResult envelope or a report-safe
// FormSectionCollectionFacts projection; raw answers never cross this boundary.
model AssessmentUnitSnapshot {
  id                        String                      @id @default(uuid())
  questionnaireAssessmentId String?                     @map("questionnaire_assessment_id")
  compositeAttemptId        String?                     @map("composite_attempt_id")
  attemptEpoch              Int                         @map("attempt_epoch")
  slotKey                   String                      @map("slot_key")
  unitType                  AssessmentUnitType          @map("unit_type")
  terminalState             AssessmentUnitTerminalState @map("terminal_state")
  payloadKind               AssessmentUnitPayloadKind   @map("payload_kind")
  sourceType                String                      @map("source_type")
  sourceAttemptId           String                      @map("source_attempt_id")
  sourceSubmissionId        String?                     @map("source_submission_id")
  sourceDefinitionHash      String?                     @map("source_definition_hash")
  compiledRuntimeHash       String?                     @map("compiled_runtime_hash")
  canonicalResultEncrypted  String?                     @map("canonical_result_encrypted")
  collectionFactsEncrypted  String?                     @map("collection_facts_encrypted")
  completedAt               DateTime                    @map("completed_at")
  createdAt                 DateTime                    @default(now()) @map("created_at")

  questionnaireAssessment QuestionnaireAssessment?    @relation("QuestionnaireAssessmentUnitSnapshots", fields: [questionnaireAssessmentId], references: [id], onDelete: Cascade)
  compositeAttempt        CompositeAssessmentAttempt? @relation("CompositeAssessmentUnitSnapshots", fields: [compositeAttemptId], references: [id], onDelete: Cascade)

  @@unique([questionnaireAssessmentId, attemptEpoch, slotKey], map: "assessment_unit_snapshots_questionnaire_slot_key")
  @@unique([compositeAttemptId, attemptEpoch, slotKey], map: "assessment_unit_snapshots_composite_slot_key")
  @@unique([questionnaireAssessmentId, attemptEpoch, sourceAttemptId], map: "assessment_unit_snapshots_questionnaire_source_key")
  @@unique([compositeAttemptId, attemptEpoch, sourceAttemptId], map: "assessment_unit_snapshots_composite_source_key")
  @@index([questionnaireAssessmentId, attemptEpoch, terminalState], map: "assessment_unit_snapshots_questionnaire_terminal_idx")
  @@index([compositeAttemptId, attemptEpoch, terminalState], map: "assessment_unit_snapshots_composite_terminal_idx")
  @@map("assessment_unit_snapshots")
}

// Standalone Situational PR-B attempt. This is intentionally independent from
// Assessment/Questionnaire/Composite: a Situational pilot is one UNIT with no
// parent slot and must not be represented as a fake Scale row.
model SituationalAttempt {
  id                     String                 @id @default(uuid())
  userId                 String?                @map("user_id")
  compositeAttemptId     String?                @map("composite_attempt_id")
  compositeItemId        String?                @map("composite_item_id")
  compositeSlotKey       String?                @map("composite_slot_key")
  participantKey         String                 @map("participant_key")
  instrumentKey          String                 @map("instrument_key")
  instrumentVersion      String                 @map("instrument_version")
  attemptNo              Int                    @default(1) @map("attempt_no")
  status                 AssessmentStatus       @default(IN_PROGRESS)
  deliveryMode           InstrumentDeliveryMode @default(FINAL_ONLY) @map("delivery_mode")
  runtimeGeneration      RuntimeGeneration     @default(UNIFIED_V1) @map("runtime_generation")
  attemptEpoch           Int                    @default(1) @map("attempt_epoch")
  definitionHash         String                 @map("definition_hash")
  compiledRuntimeHash    String                 @map("compiled_runtime_hash")
  scorerKey              String                 @map("scorer_key")
  scoringVersion         String                 @map("scoring_version")
  frozenAt               DateTime               @map("frozen_at")
  runtimeSnapshotEncrypted String               @map("runtime_snapshot_encrypted")
  submissionId           String?                @unique @map("submission_id")
  submissionPayloadHash  String?                @map("submission_payload_hash")
  submittedAt            DateTime?              @map("submitted_at")
  progress               Int                    @default(0)
  startedAt              DateTime               @default(now()) @map("started_at")
  completedAt            DateTime?              @map("completed_at")
  totalTime              Int?                   @map("total_time")
  resultEncrypted        String?                @map("result_encrypted")
  canonicalResultEncrypted String?              @map("canonical_result_encrypted")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  user          User?                   @relation("SituationalAttemptUser", fields: [userId], references: [id], onDelete: SetNull)
  compositeAttempt CompositeAssessmentAttempt? @relation("CompositeAttemptSituationalAttempts", fields: [compositeAttemptId], references: [id], onDelete: Cascade)
  compositeItem   CompositeAssessmentItem? @relation("CompositeSituationalAttempts", fields: [compositeItemId], references: [id], onDelete: Restrict)
  rawSubmission SituationalRawSubmission?

  // Standalone attempt numbers are unique within the standalone namespace;
  // embedded children are scoped by their composite parent/slot instead.
  @@index([instrumentKey, instrumentVersion, participantKey, attemptNo])
  @@index([userId, status])
  @@index([participantKey, status])
  @@index([instrumentKey, instrumentVersion, status])
  @@index([compositeAttemptId, status])
  @@unique([compositeAttemptId, compositeItemId], map: "situational_attempts_composite_item_key")
  @@map("situational_attempts")
}

// Exactly one immutable encrypted raw payload is attached to a completed
// standalone attempt. Per-scene and per-answer writes are intentionally not
// modelled.
model SituationalRawSubmission {
  id                  String            @id @default(uuid())
  attemptId           String            @unique @map("attempt_id")
  attemptEpoch        Int               @map("attempt_epoch")
  responseCount       Int               @map("response_count")
  payloadEncrypted    String            @map("payload_encrypted")
  payloadHash         String            @map("payload_hash")
  payloadSchemaVersion Int              @map("payload_schema_version")
  encodingVersion     String            @map("encoding_version")
  createdAt           DateTime          @default(now()) @map("created_at")

  attempt SituationalAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("situational_raw_submissions")
}

model InstrumentAuthorization {
  id                       String   @id @default(uuid())
  authorizationKey         String   @map("authorization_key")
  version                  Int
  instrumentKey            String   @map("instrument_key")
  instrumentVersion        String   @map("instrument_version")
  grantor                  String
  grantee                  String
  electronicAdministration Boolean  @default(true) @map("electronic_administration")
  scoring                  Boolean  @default(true)
  translation              Boolean  @default(false)
  display                  Boolean  @default(true)
  territories              String[] @default([])
  locales                  String[] @default([])
  commercialNature         String   @map("commercial_nature")
  validFrom                DateTime @map("valid_from")
  validTo                  DateTime @map("valid_to")
  basis                    String
  status                   String
  evidenceAssetId          String?  @map("evidence_asset_id")
  evidenceSha256           String?  @map("evidence_sha256")
  selfApprovalDeclaration  String?  @map("self_approval_declaration")
  approvedByUserId         String?  @map("approved_by_user_id")
  approvedAt               DateTime? @map("approved_at")
  createdByUserId          String   @map("created_by_user_id")
  recordHash               String   @map("record_hash")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  evidenceAsset StoredAsset? @relation("InstrumentAuthorizationEvidence", fields: [evidenceAssetId], references: [id], onDelete: SetNull)
  audits        InstrumentAuthorizationAudit[]

  @@unique([authorizationKey, version])
  @@index([instrumentKey, instrumentVersion, status])
  @@index([status, validTo])
  @@map("instrument_authorizations")
}

model InstrumentAuthorizationAudit {
  id                    String   @id @default(uuid())
  authorizationId       String   @map("authorization_id")
  authorizationVersion  Int      @map("authorization_version")
  action                String
  actorUserId           String   @map("actor_user_id")
  at                    DateTime
  note                  String
  recordHash            String   @map("record_hash")
  createdAt             DateTime @default(now()) @map("created_at")

  authorization InstrumentAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Restrict)

  @@index([authorizationId, at])
  @@map("instrument_authorization_audits")
}


enum ParentRelationshipStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum AssessmentEpisodeInitiationMode {
  TEACHER_CAMPAIGN
  PARENT_SELF_SERVE
  STUDENT_SELF
  ANONYMOUS_SELF
}

enum ParentInviteCodeStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

/// Global many-to-many parent↔student relationship. Revocable; never physically deleted.
model ParentStudentRelationship {
  id              String                   @id @default(uuid())
  parentUserId    String                   @map("parent_user_id")
  studentUserId   String                   @map("student_user_id")
  status          ParentRelationshipStatus @default(PENDING)
  inviteCodeId    String?                  @map("invite_code_id")
  approvedByUserId String?                 @map("approved_by_user_id")
  approvedAt      DateTime?                @map("approved_at")
  revokedByUserId String?                  @map("revoked_by_user_id")
  revokedAt       DateTime?                @map("revoked_at")
  revokeReason    String?                  @map("revoke_reason")
  consentVersion  String?                  @map("consent_version")
  consentHash     String?                  @map("consent_hash")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  parent     User             @relation("ParentRelationshipParent", fields: [parentUserId], references: [id], onDelete: Restrict)
  student    User             @relation("ParentRelationshipStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  inviteCode ParentInviteCode? @relation(fields: [inviteCodeId], references: [id], onDelete: Restrict)

  // Current-pair uniqueness is a partial index; revoked episodes remain historical.
  @@index([parentUserId, studentUserId, createdAt(sort: Desc)], map: "parent_relationship_pair_history_idx")
  @@index([studentUserId, status])
  @@index([parentUserId, status])
  @@map("parent_student_relationships")
}

/// Single-use invite bound to an exact course or current student membership.
model ParentInviteCode {
  id                String                 @id @default(uuid())
  codeHash          String                 @unique @map("code_hash")
  studentUserId     String                 @map("student_user_id")
  courseId          String?                @map("course_id")
  organizationId    String?                @map("organization_id")
  membershipId      String?                @map("membership_id")
  createdByUserId   String                 @map("created_by_user_id")
  status            ParentInviteCodeStatus @default(ACTIVE)
