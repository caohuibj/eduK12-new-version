// 量表表
model Scale {
  measurementReleaseId String? @map("measurement_release_id")
  measurementRelease MeasurementContentRelease? @relation(fields:[measurementReleaseId],references:[id],onDelete:Restrict,onUpdate:NoAction,map:"scales_measurement_release_fkey")
  publicationAudits ScalePublicationAudit[]
  id                String               @id @default(uuid())
  code              String               @unique // 量表编码
  name              String // 量表名称
  description       String? // 量表描述
  status            ScaleStatus          @default(DRAFT) // 状态
  visibility        ScaleVisibility      @default(HIDDEN) // 可见性
  instrumentClass   ScaleInstrumentClass @default(CUSTOM_DESCRIPTIVE) @map("instrument_class")
  instrumentVersion String               @default("2.0.0") @map("instrument_version")
  definition        Json? // ScaleDefinitionV2；运行时唯一计分来源
  definitionHash    String?              @map("definition_hash")
  // Immutable, server-authored provenance for a copied draft; never part of scoring/hash.
  copySource        Json?                @map("copy_source")
  itemCount         Int                  @default(0) @map("item_count")
  dimensionCount    Int                  @default(0) @map("dimension_count")
  estimatedTime     Int?                 @map("estimated_time") // 预计用时（分钟）
  instruction       String? // 指导语
  creatorId         String               @map("creator_id") // 创建者ID
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  tags              String[]             @default([])

  // 关联
  creator             User                      @relation("ScaleCreator", fields: [creatorId], references: [id])
  deploymentPolicies  ScaleDeploymentPolicy[]
  assessments         Assessment[]
  courseScales        CourseScale[]
  // 聚合问卷模块关联
  questionnaireScales QuestionnaireScale[]      @relation("QuestionnaireScales")
  // 综合测评模块关联
  compositeItems      CompositeAssessmentItem[] @relation("CompositeAssessmentScale")

  @@map("scales")
}

// 测评记录表
model Assessment {
  timingEncrypted String? @map("timing_encrypted")
  resultFacts AssessmentResultFact[]
  id                        String                 @id @default(uuid())
  scaleId                   String                 @map("scale_id")
  userId                    String?                @map("user_id") // 改为可选，支持匿名测评
  status                    AssessmentStatus       @default(IN_PROGRESS)
  deliveryMode              InstrumentDeliveryMode @default(FINAL_ONLY) @map("delivery_mode")
  runtimeGeneration         RuntimeGeneration?     @map("runtime_generation")
  attemptEpoch              Int                    @default(1) @map("attempt_epoch")
  submissionId              String?                @unique @map("submission_id")
  submissionPayloadHash     String?                @map("submission_payload_hash")
  submissionCompletedAt     DateTime?              @map("submission_completed_at")
  answers                   Json? // 旧格式/进行中答案；新格式完成后引用唯一原始事实
  answersRevision           Int                    @default(0) @map("answers_revision") // 量表答案 OCC 版本
  result                    Json? // 旧格式为加密完整结果；新格式为不可变结果事实引用
  runtimeSnapshotEncrypted  String?                @map("runtime_snapshot_encrypted")
  compiledRuntimeHash       String?                @map("compiled_runtime_hash")
  frozenAdmissionSnapshotEncrypted String?         @map("frozen_admission_snapshot_encrypted")
  frozenAdmissionSnapshotHash      String?         @map("frozen_admission_snapshot_hash")
  progress                  Int                    @default(0) // 进度百分比
  startedAt                 DateTime               @default(now()) @map("started_at")
  completedAt               DateTime?              @map("completed_at") // 完成时间
  totalTime                 Int?                   @map("total_time") // 总用时（毫秒）
  // 聚合问卷模块关联（可选，单体量表测评时为空）
  questionnaireAssessmentId String?                @map("questionnaire_assessment_id")
  compositeAttemptId        String?                @map("composite_attempt_id")
  compositeItemId           String?                @map("composite_item_id")
  // Additive identity (Commit 11). Historical rows stay null — never infer from userId.
  subjectUserId             String?                @map("subject_user_id")
  respondentUserId          String?                @map("respondent_user_id")
  respondentType            String?                @map("respondent_type")
  episodeId                 String?                @map("episode_id")
  assignmentRef             String?                @map("assignment_ref")
  consentId                 String?                @map("consent_id")
  contextSnapshotRef        String?                @map("context_snapshot_ref")

  // 关联
  scale                   Scale                       @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  user                    User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode                 AssessmentEpisode?          @relation(fields: [episodeId], references: [id], onDelete: Restrict)
  consent                 AssessmentAttemptConsent?   @relation(fields: [consentId], references: [id], onDelete: Restrict)
  questionnaireAssessment QuestionnaireAssessment?    @relation(fields: [questionnaireAssessmentId], references: [id])
  compositeAttempt        CompositeAssessmentAttempt? @relation("CompositeAttemptAssessments", fields: [compositeAttemptId], references: [id], onDelete: Cascade)
  compositeItem           CompositeAssessmentItem?    @relation("CompositeScaleAssessments", fields: [compositeItemId], references: [id], onDelete: Restrict)

  // 性能优化索引
  @@index([userId, status]) // 用户查询自己的测评
  @@index([scaleId, status]) // 按量表统计
  @@index([startedAt]) // 时间范围查询
  @@index([questionnaireAssessmentId])
  @@index([compositeAttemptId])
  @@index([compositeItemId])
  @@index([status, startedAt]) // 新增：统计场景优化
  @@index([subjectUserId, status])
  @@index([respondentUserId, status])
  @@index([episodeId])
  @@map("assessments")
}

// 通用 Reference Core。definition 保存结构化 reference set，避免 scale/cognitive 各自维护一套表。
model AssessmentReferenceSet {
  id               String                            @id @default(uuid())
  instrumentType   AssessmentReferenceInstrumentType @map("instrument_type")
  instrumentKey    String                            @map("instrument_key")
  referenceVersion String                            @map("reference_version")
  status           AssessmentReferenceStatus         @default(DRAFT)
  definition       Json
  createdAt        DateTime                          @default(now()) @map("created_at")
  updatedAt        DateTime                          @updatedAt @map("updated_at")

  @@unique([instrumentType, instrumentKey, referenceVersion])
  @@index([instrumentType, instrumentKey, status])
  @@map("assessment_reference_sets")
}

// 课程量表关联表（支持将量表关联到课程）
model CourseScale {
