  cognitiveAssignment CognitiveAssignment?  @relation("CompositeAssessmentCognitiveAssignment", fields: [cognitiveAssignmentId], references: [id], onDelete: Restrict)
  scaleAssessments    Assessment[]          @relation("CompositeScaleAssessments")
