// Survey-specific FINAL persistence, backed by shared canonical FINAL hashing,
// AES-GCM unified encryption and production Scale/SJT scoring implementations.
model SurveyWaveFinal {
  id              String           @id
  attemptId       String           @unique @map("attempt_id")
  attempt         SurveyWaveAttempt @relation(fields:[attemptId],references:[id],onDelete:Restrict)
  projectId       String           @map("project_id")
  waveId          String           @map("wave_id")
  wave            SurveyWave       @relation(fields:[waveId],references:[id],onDelete:Restrict)
  publicationId   String           @map("publication_id")
  publication     SurveyPublication @relation(fields:[publicationId],references:[id],onDelete:Restrict)
  submissionId    String           @map("submission_id")
  payloadHash     String           @map("payload_hash")
  definitionDigest String          @map("definition_digest")
  resultsCipher   String           @map("results_cipher")
  resultsHash     String           @map("results_hash")
  completedAt     DateTime         @default(now()) @map("completed_at") @db.Timestamptz(6)
  interpretations SurveyInterpretationArtifact[]
  @@index([projectId,waveId,completedAt],map:"survey_finals_project_wave_time_idx")
  @@map("survey_wave_finals")
}



// Short-lived encrypted research exports. The platform admin cannot inherit
// Owner raw-data permissions; every download revalidates current grant + MFA.
model SurveySampleReview {
  attemptId  String            @id @map("attempt_id")
  projectId  String            @map("project_id")
  waveId     String            @map("wave_id")
  attempt    SurveyWaveAttempt @relation(fields:[attemptId,projectId,waveId],references:[id,projectId,waveId],onDelete:Restrict)
  verdict    String
  reason     String
  reviewerId String            @map("reviewed_by")
  revision   Int               @default(1)
  reviewedAt DateTime          @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  // Prisma needs an explicit unique tuple for this composite 1:1 relation.
  // attemptId is also the PK; the composite index preserves scope FK shape.
  @@unique([attemptId,projectId,waveId],map:"survey_sample_reviews_attempt_scope_unique")
  @@index([projectId,waveId,verdict],map:"survey_sample_reviews_scope_idx")
  @@map("survey_sample_reviews")
}

model SurveyExportTicket {
