      "items": [
        {
          "itemCode": "RSES10_EN_01",
          "content": "I feel that I'm a person of worth, at least on an equal plane with others.",
          "type": "single",
          "required": true,
          "sortOrder": 0,
          "responseSetKey": "rses10_en_agreement",
          "randomizeOptions": false
        },
        {
          "itemCode": "RSES10_EN_02",
          "content": "I feel that I have a number of good qualities.",
          "type": "single",
          "required": true,
          "sortOrder": 1,
          "responseSetKey": "rses10_en_agreement",
          "randomizeOptions": false
        },
        {
          "itemCode": "RSES10_EN_03",
          "content": "All in all, I am inclined to feel that I am a failure.",
          "type": "single",
          "required": true,
          "sortOrder": 2,
          "responseSetKey": "rses10_en_agreement",
          "randomizeOptions": false
        },
        {
          "itemCode": "RSES10_EN_04",
          "content": "I am able to do things as well as most other people.",
          "type": "single",
          "required": true,
          "sortOrder": 3,
          "responseSetKey": "rses10_en_agreement",
          "randomizeOptions": false
        },
        {
          "itemCode": "RSES10_EN_05",
          "content": "I feel I do not have much to be proud of.",
          "type": "single",
          "required": true,
          "sortOrder": 4,
          "responseSetKey": "rses10_en_agreement",
          "randomizeOptions": false
        },
        {
          "itemCode": "RSES10_EN_06",
          "content": "I take a positive attitude toward myself.",
          "type": "single",
          "required": true,
          "sortOrder": 5,
          "responseSetKey": "rses10_en_agreement",
          "randomizeOptions": false
        },
        {
          "itemCode": "RSES10_EN_07",
          "content": "On the whole, I am satisfied with myself.",
          "type": "single",
          "required": true,
          "sortOrder": 6,
          "responseSetKey": "rses10_en_agreement",
          "randomizeOptions": false
        },
        {
          "itemCode": "RSES10_EN_08",
          "content": "I wish I could have more respect for myself.",
          "type": "single",
          "required": true,
          "sortOrder": 7,
          "responseSetKey": "rses10_en_agreement",
          "randomizeOptions": false
        },
        {
          "itemCode": "RSES10_EN_09",
          "content": "I certainly feel useless at times.",
          "type": "single",
          "required": true,
          "sortOrder": 8,
          "responseSetKey": "rses10_en_agreement",
          "randomizeOptions": false
        },
        {
          "itemCode": "RSES10_EN_10",
          "content": "At times I think I am no good at all.",
          "type": "single",
          "required": true,
          "sortOrder": 9,
          "responseSetKey": "rses10_en_agreement",
          "randomizeOptions": false
        }
      ],
