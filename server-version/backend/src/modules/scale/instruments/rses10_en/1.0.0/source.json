        "interpretations": [
          {
            "scoreKey": "rses10_en_total",
            "headline": "Reading this self-esteem score in context",
            "source": {
              "type": "score_only"
            },
            "summary": "Your answers produce one total score between 0 and 30. A larger score reflects stronger agreement with positive statements about yourself after five negatively worded statements are reverse-scored. It is a description of how you answered these ten questions, not a measure of your value as a person. There is no universally validated high/low cutoff or population percentile attached to this report. Differences in current experiences, relationships, and interpretation of the statements can affect a result; a single questionnaire cannot determine their causes. This result is not a diagnosis or a prediction of future wellbeing or achievement.",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "Choose one statement that felt easy or difficult to answer. Consider a specific recent experience that may have shaped your response, without treating that experience as a verdict about your whole identity."
              },
              {
                "category": "strategy",
                "text": "When a global judgment comes to mind, separate the observable event from the conclusion you draw about yourself. One task that needs work is not evidence that every part of you lacks value."
              },
              {
                "category": "support",
                "text": "If worries about self-worth are persistent or distressing, consider discussing them with a trusted person or a qualified professional. You do not need to reach any score threshold before seeking support."
              }
            ]
          }
        ],
        "limitations": [
          "English RSES ten-item PhenX form only, with complete_required as a conservative local implementation rule rather than an author's missing-answer recommendation.",
          "No diagnostic cutoff, percentile or China K12 norm. A respondent's score and its possible 0–30 range are not a population rank.",
          "The recorded source permits reuse as public domain, but this candidate has not been installed, published or verified in the production scoring/report consumer."
        ],
        "disclaimer": "Descriptive research and adult self-reflection only; not for diagnosis, teacher accountability or high-stakes selection. Cite Rosenberg (1989 revised edition) and PhenX 180901.",
