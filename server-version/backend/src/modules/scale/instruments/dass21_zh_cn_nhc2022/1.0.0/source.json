      "items": [
        {
          "itemCode": "DASS21_01",
          "content": "我觉得很难让自己安静下来。",
          "type": "single",
          "required": true,
          "sortOrder": 0,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_02",
          "content": "我感到口干。",
          "type": "single",
          "required": true,
          "sortOrder": 1,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_03",
          "content": "我似乎不能积极乐观起来。",
          "type": "single",
          "required": true,
          "sortOrder": 2,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_04",
          "content": "我感到过呼吸困难（例如：在没有体力透支的情况下感到呼吸急促，喘不过气来）。",
          "type": "single",
          "required": true,
          "sortOrder": 3,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_05",
          "content": "我感到很难主动去开始工作。",
          "type": "single",
          "required": true,
          "sortOrder": 4,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_06",
          "content": "我对于所处的环境（情况）易反应过度。",
          "type": "single",
          "required": true,
          "sortOrder": 5,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_07",
          "content": "我曾有发抖的感觉（例如：手颤）。",
          "type": "single",
          "required": true,
          "sortOrder": 6,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_08",
          "content": "我觉得我在耗费很多精神。",
          "type": "single",
          "required": true,
          "sortOrder": 7,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_09",
          "content": "我会担心一些可能让自己恐慌或出丑的场合或情景。",
          "type": "single",
          "required": true,
          "sortOrder": 8,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_10",
          "content": "我感到我没什么可期待的。",
          "type": "single",
          "required": true,
          "sortOrder": 9,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_11",
          "content": "我发现我变得容易激动。",
          "type": "single",
          "required": true,
          "sortOrder": 10,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_12",
          "content": "我感到很难放松自己。",
          "type": "single",
          "required": true,
          "sortOrder": 11,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_13",
          "content": "我感到伤心和郁闷。",
          "type": "single",
          "required": true,
          "sortOrder": 12,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_14",
          "content": "阻碍我正在进行工作的事我会无法容忍。",
          "type": "single",
          "required": true,
          "sortOrder": 13,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_15",
          "content": "我感到惶恐不安。",
          "type": "single",
          "required": true,
          "sortOrder": 14,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_16",
          "content": "我对任何事都提不起兴趣。",
          "type": "single",
          "required": true,
          "sortOrder": 15,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_17",
          "content": "我觉得自己不怎么配做人。",
          "type": "single",
          "required": true,
          "sortOrder": 16,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_18",
          "content": "我感到我极容易因为小事而发火。",
          "type": "single",
          "required": true,
          "sortOrder": 17,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_19",
          "content": "即使没有体力活动我也感觉到心跳（如：有心跳加速或心律不正常的感觉）。",
          "type": "single",
          "required": true,
          "sortOrder": 18,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_20",
          "content": "我无缘无故地感到害怕。",
          "type": "single",
          "required": true,
          "sortOrder": 19,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        },
        {
          "itemCode": "DASS21_21",
          "content": "我感到生活毫无意义。",
          "type": "single",
          "required": true,
          "sortOrder": 20,
          "responseSetKey": "original_response",
          "randomizeOptions": false
        }
      ],
