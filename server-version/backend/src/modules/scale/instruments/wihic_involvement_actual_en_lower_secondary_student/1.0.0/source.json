            "guidance": [
              {
                "category": "reflection",
                "text": "When is it easiest for you to share an idea: in writing, with a partner or in a class discussion?"
              },
              {
                "category": "environment",
                "text": "Suggest one way to make room for different forms of participation, with support from a trusted adult."
              }
            ]
          }
        ],
        "limitations": [
          "Your answers describe your perspective in this particular class. They cannot establish a teacher’s quality, classmates’ intentions or the causes of an experience.",
