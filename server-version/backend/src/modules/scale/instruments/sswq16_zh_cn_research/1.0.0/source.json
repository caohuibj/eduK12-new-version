        "interpretations": [
          {
            "scoreKey": "school_wellbeing",
            "headline": "回顾最近的学校生活",
            "source": {
              "type": "score_only"
            },
            "summary": "这份回顾关注你过去一个月在学校的感受：学习有没有乐趣、能不能安心做自己、所学的东西有没有意义，以及你怎样看待自己的学习表现。这不是考试，也不会把你分成好学生或差学生。比如，同一个月里，你可能很喜欢某门课，却不太敢在同学面前发言；不同方面的体验可以同时存在。把它们分开看看，比只盯着一个总数更能帮助你找到想保留或改变的事情。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "最近一个月，学校里有哪些时刻让你轻松一些？又有什么最想改变？"
              },
              {
                "category": "strategy",
                "text": "选一个最想改善的小方面，与信任的人一起想一个可行的下一步。"
              }
            ]
          },
          {
            "scoreKey": "JL",
            "headline": "学习中有没有好奇和乐趣",
            "source": {
              "type": "score_only"
            },
            "summary": "这一部分关注你对学习活动的兴趣和享受，而不是你有没有每次都拿到好成绩。有时，一个想弄明白的问题、一项动手项目，或一次终于理解的瞬间，就能带来乐趣；忙碌和疲惫也可能暂时盖过这种感觉。回答越常肯定这些体验，表示最近学习中的积极感受越常出现。暂时缺少兴趣并不等于你不爱学习，也可能是内容、节奏或支持方式还不适合你。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "最近哪次学习让你愿意多问一个问题或多试一次？"
              },
              {
                "category": "strategy",
                "text": "从一个感兴趣的小问题、一次动手尝试或喜欢的主题开始，看看哪种方式更能吸引你。"
              }
            ]
          },
          {
            "scoreKey": "SC",
            "headline": "在学校能不能安心做自己",
            "source": {
              "type": "score_only"
            },
