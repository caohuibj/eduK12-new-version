      "items": [
        {
          "itemCode": "FFMQ15_01",
          "content": "洗澡或泡澡时，我会留意水接触身体的感觉。",
          "type": "single",
          "required": true,
          "sortOrder": 0,
          "responseSetKey": "ffmq15_1_5",
