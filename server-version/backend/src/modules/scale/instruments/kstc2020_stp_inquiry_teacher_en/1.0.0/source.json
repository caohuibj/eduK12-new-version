        "interpretations": [
          {
            "scoreKey": "stp_inquiry",
            "headline": "Teaching science inquiry: a record for reflection",
            "source": {
              "type": "score_only"
            },
            "summary": "This mean summarizes your own responses about teaching science inquiry. Higher values indicate more frequent self-report on the published response continuum; they do not establish the quality or effectiveness of your teaching. Statements about understanding and effectiveness remain personal judgments. The endpoints are 1 (rarely) and 5 (always); intermediate verbal labels were not published. The result is not a normative rank, proficiency level or diagnosis. A lower response may reflect limited opportunities or support as well as choices; a higher response does not show that students learned more.",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "In a recent inquiry task, what thinking did students do themselves, beyond following instructions?"
              },
              {
                "category": "strategy",
                "text": "Ask students to state one claim and the evidence that would support or challenge it. Keep one example of their reasoning and plan a follow-up question rather than counting questions alone."
              }
            ]
          }
        ],
        "limitations": [
          "Original study context: South Korean school science teachers; English publication wording is not a validated Chinese translation or independently validated standalone factor.",
          "No normative comparison, cutoff, teacher ranking, causal attribution or cross-factor/global total.",
          "A score is produced only when every item in this factor has a valid response. Missing or unavailable evidence is not zero; no imputation or prorating.",
          "The methods describe five frequency response positions and endpoint words only; intermediate numeric labels are a disclosed presentation choice."
        ],
        "disclaimer": "For teacher research and voluntary professional reflection. No diagnosis, appraisal, promotion or student-learning conclusion. If responses or evidence are insufficient, do not infer low competency.",
