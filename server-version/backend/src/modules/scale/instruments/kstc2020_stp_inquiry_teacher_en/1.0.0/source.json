      "items": [
        {
          "itemCode": "STP1.CL5",
          "content": "I effectively use small-group activities in science teaching.",
          "type": "single",
          "required": true,
          "sortOrder": 0,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.ST1",
          "content": "In science teaching, I provide appropriate opportunities for students to reason logically based on scientific evidence.",
          "type": "single",
          "required": true,
          "sortOrder": 1,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.ST2",
          "content": "In science teaching, I provide appropriate opportunities for students to demonstrate scientific creativity.",
          "type": "single",
          "required": true,
          "sortOrder": 2,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.ST3",
          "content": "In science teaching, I provide appropriate opportunities for students to utilize various areas of knowledge and skills in an integrative way.",
          "type": "single",
          "required": true,
          "sortOrder": 3,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.SE1",
          "content": "In science teaching, I provide appropriate opportunities for students to observe and explore things with scientific attitudes and curiosity.",
          "type": "single",
          "required": true,
          "sortOrder": 4,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.SE2",
          "content": "In science teaching, I encourage students to use scientific inquiry skills and knowledge in an integrative way so that they can effectively perform inquiry.",
          "type": "single",
          "required": true,
          "sortOrder": 5,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.SE3",
          "content": "In science teaching, I provide appropriate opportunities for students to undertake self-directed scientific inquiry.",
          "type": "single",
          "required": true,
          "sortOrder": 6,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.SE4",
          "content": "In science teaching, I provide appropriate opportunities for students to experience various types of exploration, such as experimentation, investigation, and discussion.",
          "type": "single",
          "required": true,
          "sortOrder": 7,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.SC2",
          "content": "In science teaching, I provide appropriate opportunities for students to use scientific terms and representations (graphs, tables, figures, etc.) effectively to represent science content.",
          "type": "single",
          "required": true,
          "sortOrder": 8,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.SC3",
          "content": "In science teaching, I provide appropriate opportunities for students to logically exchange their ideas and opinions and to understand each other in the content of science classes.",
          "type": "single",
          "required": true,
          "sortOrder": 9,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.SC4",
          "content": "In science teaching, I provide appropriate opportunities for students to work together in solving inquiry problems.",
          "type": "single",
          "required": true,
          "sortOrder": 10,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.SP1",
          "content": "In science teaching, I provide appropriate opportunities for students to find inquiry problems for themselves.",
          "type": "single",
          "required": true,
          "sortOrder": 11,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.SP2",
          "content": "In science teaching, I provide appropriate opportunities for students to solve everyday problems by applying scientific principles.",
          "type": "single",
          "required": true,
          "sortOrder": 12,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "STP1.SP4",
