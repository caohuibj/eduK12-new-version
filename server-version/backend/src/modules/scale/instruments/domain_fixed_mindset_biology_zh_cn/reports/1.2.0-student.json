        "scoreKey": "domain_fixed_mindset",
        "headline": "看不清时，可以换一种观察办法",
        "source": {
          "type": "shared_theoretical_range"
        },
        "summary": "观察叶片时，阿禾总把叶脉的分叉看成一团。他原本想把笔记合上，后来把纸上的轮廓分成左、中、右三块，一次只对照一小块。他补出了两条原来漏掉的线，也把一处仍不确定的地方圈了起来。\n\n这几道题记录你怎样看待生物学习天赋能否改变。分数越高，表示这次越认同它比较固定。回想一次真实的学习，分开记下原先的判断、换过的办法，以及后来能看清的一步。下一次要试的事，往往就藏在那一步里。",
        "bands": [
          {
            "key": "very_low",
            "label": "给同类图换一个观察顺序",
            "summary": "挑两张相似的生物图。第一张先看整体，第二张先找一个熟悉的结构，再对照自己能辨认出什么。",
            "guidance": []
          },
          {
            "key": "low",
            "label": "留下先前和现在的记录",
            "summary": "把两次观察画在纸的两边。圈出后来自己补上的一个细节，再给还拿不准的地方做一个小标记。",
            "guidance": []
          },
          {
            "key": "middle",
            "label": "把困难写到图上",
            "summary": "回到一张让你觉得自己不擅长的生物图。指着它写一句实际遇到的问题，例如“我分不清这两条线的走向”。",
            "guidance": []
          },
          {
            "key": "high",
            "label": "借一个示范，再画一处",
            "summary": "请同学示范如何辨认一个结构。合上示范，在另一张相近的图上找同一个结构，看自己能否说出依据。",
            "guidance": []
          },
          {
            "key": "very_high",
            "label": "带着两张图问一个问题",
            "summary": "把能看懂和没看懂的两份图放在一起，请老师或同学指出其中一处区别。下一次先练辨认这一处。",
            "guidance": []
          }
