        "interpretations": [
          {
            "scoreKey": "total",
            "headline": "留意当下的能力",
            "source": {
              "type": "score_only"
            },
            "summary": "反向计分后，分数越高表示你越多报告“留意当下、允许感受存在”；越低表示越多报告走神、评判自己或推开感受。这只是这一次作答的记录，不是能力评分。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "今天有没有一个时刻，你完全在注意眼前发生的事？那时你在做什么？"
              },
              {
                "category": "strategy",
                "text": "做一件日常小事（吃饭、走路、听歌）时，只留意它的声音、味道或身体感觉；走神了就轻轻拉回来，不用批评自己。"
              }
            ]
          }
        ],
        "limitations": [
