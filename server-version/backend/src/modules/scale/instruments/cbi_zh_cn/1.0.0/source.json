      "items": [
        {
          "itemCode": "CBI-P1",
          "content": "请结合自己的实际感受作答。前两部分关注整体疲惫和工作相关疲惫；第三部分关注与服务对象互动带来的疲惫。在学校情境中，服务对象可以指学生。各部分的选项不同，请留意选项文字。\n\n你多久会感到疲倦？",
          "type": "single",
          "required": false,
          "sortOrder": 0,
          "responseSetKey": "cbi_frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "CBI-P2",
          "content": "你多久会感到身体精疲力竭？",
          "type": "single",
          "required": false,
          "sortOrder": 1,
          "responseSetKey": "cbi_frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "CBI-P3",
          "content": "你多久会感到情绪上精疲力竭？",
          "type": "single",
          "required": false,
          "sortOrder": 2,
          "responseSetKey": "cbi_frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "CBI-P4",
          "content": "你多久会觉得：“我再也撑不下去了”？",
          "type": "single",
          "required": false,
          "sortOrder": 3,
          "responseSetKey": "cbi_frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "CBI-P5",
          "content": "你多久会感到筋疲力尽？",
          "type": "single",
          "required": false,
          "sortOrder": 4,
          "responseSetKey": "cbi_frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "CBI-P6",
          "content": "你多久会感到虚弱、容易生病？",
          "type": "single",
          "required": false,
          "sortOrder": 5,
          "responseSetKey": "cbi_frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "CBI-W1",
