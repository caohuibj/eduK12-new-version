        "interpretations": [
          {
            "scoreKey": "digital_resources",
            "headline": "好资源要经得起三问",
            "source": {
              "type": "score_only"
            },
            "summary": "这一部分问的是你如何找资源、改资源、保护敏感内容。判断一份材料能不能用，可以问三个问题：它从哪里来？学生能顺利使用吗？分享它会不会把不该公开的信息一起带出去？一份朴素、清楚又合适的材料，常比功能复杂的资源更有用。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "下次挑材料时，先看发布者和更新时间，再用学生最常用的设备打开一次。需要登录、字号太小或加载很慢，都可能让学生中途放弃。"
              },
              {
                "category": "strategy",
                "text": "改编一份讲义，从学生最容易卡住的一处入手，例如给操作步骤补一张示例。保留原作者和来源信息。"
              },
              {
                "category": "environment",
                "text": "把示例资料和真实数据分开。试卷、成绩和含个人信息的文件，存放在学校认可的受控位置，分享前核对权限。"
              }
            ],
            "scoreLabel": "数字资源合计分（试用版，0–12 分）",
            "provisional": true
          }
        ],
        "limitations": [
