      "items": [
        {
          "itemCode": "ACTSQ_01",
          "content": "…接纳令人不愉快的感受、想法或身体感觉，而不是与它们对抗。",
          "type": "single",
          "required": true,
          "sortOrder": 0,
          "responseSetKey": "actsq_applicability_0_4",
