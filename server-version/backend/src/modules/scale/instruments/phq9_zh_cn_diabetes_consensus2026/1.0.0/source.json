          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "PHQ9_8",
          "content": "行动或说话速度缓慢到别人已经察觉的程度或刚好相反，变得比平日更烦躁或坐立不安，动来动去",
          "type": "single",
          "required": true,
          "sortOrder": 7,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
