        "interpretations": [
          {
            "scoreKey": "development_barriers",
            "headline": "专业学习：哪些条件正在挡住参与",
            "source": {
              "type": "score_only"
            },
            "summary": "这部分回顾参加专业发展时的资格、费用、单位支持、家庭时间及活动机会障碍。1–4描述性均分越大，表示你更认同这些障碍存在，不表示缺乏学习意愿或专业追求。比如，想参加的培训与岗位需要相关，却因费用或家庭安排难以参与，反映的是需要协调的条件，不是个人不够努力。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "从这些方面挑一个最影响你的具体条件，写下最近一次希望参加却未参加的活动，看看真正卡住的是资格、费用、支持、时间还是单位提供相关活动的机会。"
              },
              {
                "category": "environment",
                "text": "与负责专业发展的同事或管理者讨论一项可协商支持，如费用安排、相关活动机会或获取适配的学习机会。家庭责任不要求个人隐瞒或独自克服；只分享你愿意分享的信息。"
              }
            ]
          }
        ],
