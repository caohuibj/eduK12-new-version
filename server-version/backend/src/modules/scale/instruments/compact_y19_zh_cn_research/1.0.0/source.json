        {
          "itemCode": "CY_02",
          "content": "我会设法让自己分心，把困难的想法和感受挡在外面。",
          "type": "single",
          "required": true,
          "sortOrder": 1,
          "responseSetKey": "compact_agree_0_6",
          "randomizeOptions": false
