          {
            "scoreKey": "total",
            "headline": "心理灵活性总分",
            "source": {
              "type": "score_only"
            },
            "summary": "负向题反向后求和，分数越高表示越多报告“允许感受在场、留意当下、朝重要的事行动”。数字不是等级，也不定义你。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "最近一次“感觉不太好但还是做了重要的事”是什么时候？"
              },
              {
                "category": "strategy",
                "text": "下次感觉不好时，先给感受起个名字，再问一句“此刻重要的事是什么”，然后做一小步。"
              }
            ]
          },
          {
            "scoreKey": "valued_action",
            "headline": "价值行动",
            "source": {
              "type": "score_only"
            },
            "summary": "分数越高，越多报告：清楚什么对自己重要，并把它体现在行动里。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "如果用一句话说“我在乎的事”，你会说什么？这周它出现在你的日程里了吗？"
              },
              {
                "category": "strategy",
                "text": "给在乎的事留一个固定的小时段，哪怕只有 10 分钟。"
              }
            ]
          },
          {
            "scoreKey": "openness_to_experience",
            "headline": "对体验的开放（反向后）",
            "source": {
              "type": "score_only"
            },
            "summary": "本项由六个负向题反向计分：分数越高，表示越少报告分心、回避和压制感受；越低表示越多报告这些做法。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "你通常怎样对待不请自来的情绪——欢迎、忽略，还是赶走？"
              },
              {
                "category": "strategy",
                "text": "试着让一种感受“在场”10 秒钟，不赶它也不跟随它，只是留意它的位置和大小。"
              }
            ]
          },
          {
            "scoreKey": "behavioural_awareness",
            "headline": "对行为的觉察（反向后）",
            "source": {
              "type": "score_only"
            },
            "summary": "本项由五个负向题反向计分：分数越高，表示越多报告做事时留意当下；越低表示越多报告“自动驾驶”。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "一天里哪个时刻你最容易“自动导航”？那时你在做什么？"
              },
              {
                "category": "strategy",
                "text": "挑一个常走神的活动，给它设一个“留意开关”：开始前深呼吸一次，提醒自己“现在开始留意”。"
              }
            ]
          }
