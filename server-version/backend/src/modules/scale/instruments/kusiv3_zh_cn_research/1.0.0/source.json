        "interpretations": [
          {
            "scoreKey": "interpersonal_trust",
            "headline": "你通常怎样看待别人的善意？",
            "source": {
              "type": "score_only"
            },
            "summary": "这三道题像一张小小的合影：记录你此刻对“别人一般能不能信任”的看法，不是给你贴上天真或多疑的标签。更愿意相信别人，可能让合作更容易开始；多留一点心，也可能是在保护自己的边界。合适的做法往往取决于眼前的人和事，而不是把信任越多当成越好。例如，和新同事分工时，可以先约定一件小任务，看看对方是否按时完成，再决定下一步合作。信任不必一次全给，也不必永远关门。分数越高，表示这次回答越倾向于认为他人通常可信，并不说明某个具体的人一定安全可靠。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "回想一次别人兑现承诺的经历，再想一次让你失望的经历：这两件事有哪些不同？"
              },
              {
                "category": "strategy",
                "text": "下一次合作先说清楚任务、时间和边界，用实际表现慢慢积累信任。 遇到借钱、隐私或安全问题，核实信息和保留拒绝权始终重要。"
              }
            ]
          }
        ],
        "limitations": [
