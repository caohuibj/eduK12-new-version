        {
          "itemCode": "SCI8_02",
          "content": "想一想过去一个月通常一晚的情况：如果你在夜里醒来，醒着的时间加起来一共有多长？（把各次醒着的时间相加）",
          "type": "single",
          "required": true,
          "sortOrder": 1,
          "responseSetKey": "sci8_item_2",
          "randomizeOptions": false
        },
        {
          "itemCode": "SCI8_03",
