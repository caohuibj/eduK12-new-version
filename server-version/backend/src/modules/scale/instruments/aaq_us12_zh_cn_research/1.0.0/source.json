          "itemCode": "AAQ_US12_01",
          "content": "参加考试时，我会陷入担忧，以至于很难专注在试题本身。",
          "type": "single",
          "required": false,
          "sortOrder": 0,
          "responseSetKey": "aaq_us_true_1_7",
