          {
            "scoreKey": "student_cohesiveness",
            "headline": "Student Cohesiveness: reflecting on this class",
            "source": {
              "type": "score_only"
            },
            "summary": "This describes how often you experience friendship and help among classmates. A higher mean means you reported these experiences more often; it does not measure your popularity or social worth. The displayed value is the mean of eight complete responses on a 1–5 frequency scale. There are no high/low categories or comparison norms.",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "Think of a moment when classmates helped one another. What made it easier to take part?"
              },
              {
                "category": "environment",
                "text": "With a trusted adult, suggest a small way to make help available to everyone, such as a shared question time."
              }
            ]
          }
        ],
        "limitations": [
          "Your answers describe your perspective in this particular class. They cannot establish a teacher’s quality, classmates’ intentions or the causes of an experience.",
