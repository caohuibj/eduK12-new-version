        "interpretations": [
          {
            "scoreKey": "ipip_positive_expressivity9",
            "headline": "积极情绪表达：从日常经历看自己的习惯",
            "source": {
              "type": "score_only"
            },
            "summary": "这份回答帮助你观察：开心和亲近的感受，通常会怎样被别人看见？它关注表达习惯，而不是你过得有多快乐。计分方向越高，表示你越常通过笑声、表情或亲近动作表达积极感受；较少外露也不代表冷漠或不在乎。例如，有人习惯笑出声，也有人更愿意说一句感谢；表达是否合适，还要看双方的意愿和关系边界。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "回想最近一次开心的事：你是笑出声、说出来，还是安静地享受？身边的人是否知道你的心情？"
              },
              {
                "category": "strategy",
                "text": "选一个自己舒服、对方也愿意接受的方式，分享一件小开心或说一句感谢；表达亲近不必依赖拥抱或身体接触。"
              }
            ]
          }
        ],
        "limitations": [
