        "interpretations": [
          {
            "scoreKey": "working_memory",
            "headline": "Working-memory difficulties (mean 1–5)",
            "source": {
              "type": "score_only"
            },
            "summary": "These answers describe your experience remembering instructions, arranging steps and planning activities. Higher means indicate more reported difficulties, not lower intelligence.",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "Think of one recent everyday situation and identify the step that was difficult."
              },
              {
                "category": "strategy",
                "text": "Try writing a short step-by-step checklist and look at the next step after finishing the current one."
              }
            ]
          },
          {
            "scoreKey": "inhibition",
            "headline": "Inhibition and self-regulation difficulties (mean 1–5)",
            "source": {
              "type": "score_only"
            },
            "summary": "These answers describe stopping preferred activities, starting and finishing tasks, and procrastination. This broad everyday experience is not equivalent to motor inhibition in a task.",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "Think of one recent everyday situation and identify the step that was difficult."
              },
              {
                "category": "strategy",
                "text": "Before starting homework, put your phone in a fixed place and choose a small first step."
              }
            ]
          }
        ],
        "limitations": [
          "Self-report for ages13–19, through the day before the20th birthday. Parent/teacher reports are distinct sources and cannot substitute for self-report.",
          "At ages18–19, choose either the adolescent version or the18+ adult version for the study context. Scores are not interchangeable.",
          "No age norms or validated diagnostic cutoffs are available from the author. This is not an IQ or ability grade.",
          "The working-memory factor uses9 items; inhibition uses11 items. Each is a mean from1 to5; higher means more reported difficulties.",
          "The2020 original sample comprised302 adolescents in Serbia and their parents. It was not a Swedish sample or a mainland Chinese validation.",
          "The2026 TC-TEXI study concerns a Taiwanese Traditional Chinese version, not validation of the separate Simplified Chinese translation.",
          "The original form does not specify a7-day or30-day recall window. The platform does not invent one.",
          "This is the English questionnaire and independent report. The Bundle adds Chinese descriptive text; that does not turn these items into a Chinese translation."
        ],
        "disclaimer": "This report supports reflection on everyday experiences. It does not diagnose executive-function deficits or calculate a combined ability score.",
