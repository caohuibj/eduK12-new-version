      "items": [
        {
          "itemCode": "PHQ9_1",
          "content": "做事没有兴趣或愉悦感",
          "type": "single",
          "required": true,
          "sortOrder": 0,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "PHQ9_2",
          "content": "感觉低落、郁闷或没有希望",
          "type": "single",
          "required": true,
          "sortOrder": 1,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "PHQ9_3",
          "content": "很难入睡或容易醒，或睡眠过多",
          "type": "single",
          "required": true,
          "sortOrder": 2,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "PHQ9_4",
          "content": "感觉疲劳或没有精力",
          "type": "single",
          "required": true,
          "sortOrder": 3,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "PHQ9_5",
          "content": "食欲不佳或饮食过量",
          "type": "single",
          "required": true,
          "sortOrder": 4,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "PHQ9_6",
          "content": "自我感觉差——或觉得自己很失败，或令自己或家人失望",
          "type": "single",
          "required": true,
          "sortOrder": 5,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "PHQ9_7",
          "content": "做事很难集中注意力，比如阅读报纸或看电视",
          "type": "single",
          "required": true,
          "sortOrder": 6,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "PHQ9_8",
          "content": "行动或说话过于迟缓，以致他人能够觉察到了，或正好相反——过于多动或不安分以致活动比平常要多得多",
          "type": "single",
          "required": true,
          "sortOrder": 7,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "PHQ9_9",
          "content": "觉得自己死掉会更好，或想以某种方式伤害自己",
          "type": "single",
          "required": true,
          "sortOrder": 8,
          "responseSetKey": "frequency",
          "randomizeOptions": false
        },
        {
          "itemCode": "PHQ9_FUNCTION",
          "content": "如果你对以上任一问题打钩，该问题对你完成工作、照料家事或与他人相处造成了多大困难？",
          "type": "single",
          "required": false,
          "sortOrder": 9,
          "responseSetKey": "function",
          "randomizeOptions": false,
          "purpose": "UNSCORED"
        }
