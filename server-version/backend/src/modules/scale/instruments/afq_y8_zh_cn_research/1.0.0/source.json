          "required": true,
          "sortOrder": 4,
          "responseSetKey": "afq_truth_0_4",
          "randomizeOptions": false
        },
        {
          "itemCode": "AFQY8_06",
          "content": "当我有让我难过的想法时，我在学校表现得更差。",
          "type": "single",
          "required": true,
          "sortOrder": 5,
          "responseSetKey": "afq_truth_0_4",
          "randomizeOptions": false
        },
