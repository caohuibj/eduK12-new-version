          {
            "scoreKey": "phone_use_difficulties",
            "scoreLabel": "手机使用相关困扰",
            "headline": "把手机用回自己想做的事",
            "source": {
              "type": "score_only"
            },
            "summary": "这次问卷记录手机使用与你的学习、计划、身体感受和人际联系之间的关系。十题按同意程度计分，总分是 10–60。分数越高，表示你更认同问卷描述的困扰。看结果时，可以先选一个最近受影响的片段，例如想查资料，却顺着消息看了很久。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "回想一次本来有明确目的、后来用得比预期久的经历。开始时你想做什么？当时哪件事被挤到了后面？"
              },
              {
                "category": "strategy",
                "text": "挑一段想留给学习或休息的时间，试着关掉不紧急的提醒，或把手机放远一点。保留必要的联络和学习功能，过几天再看这个安排适不适合你。"
              },
              {
                "category": "support",
                "text": "如果问题反复影响学习、休息或与你在意的人相处，可以从最近一次情境说起，与信任的人或学校支持人员一起想办法。"
              }
            ],
            "provisional": true
          }
