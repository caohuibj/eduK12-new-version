        "interpretations": [
          {
            "scoreKey": "assessment",
            "headline": "让评价接上下一步教学",
            "source": {
              "type": "score_only"
            },
            "summary": "这一部分问的是你如何用数字方式了解进展、发现可能需要帮助的学生，并给出可执行的反馈。一次小测能提示哪里值得追问，单次得分、出勤或在线活动记录都只能提供部分线索。结合学生的解释和实际困难，再决定要补讲、提供练习，还是单独沟通。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "用两道小题查看学生是否掌握本节课最重要的概念。若错在同一步，下节课先补一个例子，再做一次短练习。"
              },
              {
                "category": "strategy",
                "text": "把一句“还不够好”改成“你的结论已经清楚，下一版请补一条证据并注明来源”。给学生留出实际修改的时间。"
              },
              {
                "category": "environment",
                "text": "发现学习活动突然变化时，先和学生核实原因。只查看教学所需的信息，避免让系统记录代替沟通。"
              }
            ],
            "scoreLabel": "评价与反馈合计分（试用版，0–12 分）",
            "provisional": true
          }
        ],
        "limitations": [
          "所得分数是这一部分的原始合计分。现有证据不足以据此给出分档、判定 A1–C2 等级，或和其他教师作比较。",
          "本报告供高校教师回顾个人教学实践。工作职责、技术条件和学生需求都可能影响选项。",
          "中文为 EDUK12 根据 PeerJ 2024 高校教师英文问卷所做的试译。尚无中文版或分区单独施测的本地验证数据。"
        ],
        "disclaimer": "结果可用于个人教学反思。请勿将其用于诊断、教师绩效、学校排名或跨群体比较。缺答时本题区没有合计分。",
