        "interpretations": [
          {
            "scoreKey": "professional_engagement",
            "headline": "让常用的沟通渠道各有用处",
            "source": {
              "type": "score_only"
            },
            "summary": "这一部分问的是你怎样和学生、同事沟通，怎样一起工作，又怎样学习新的数字教法。渠道多不一定更省心。学生清楚去哪里找通知、同事知道在哪里接着改同一份材料，才说明工具发挥了作用。试着回想最近一次教学协作，看看哪一步因为用了数字工具而更顺畅。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "给一门课约定一个固定的通知渠道，再明确一个适合提问和讨论的地方。一周后问问学生，重要消息好不好找。"
              },
              {
                "category": "strategy",
                "text": "和一位同事共改一小段讲义，在同一份文档里留下修改理由。再决定这种合作方式值不值得保留。"
              },
              {
                "category": "environment",
                "text": "选一项与当前课程直接相关的在线培训。学完先试用一个方法，再记下对学生有什么具体帮助。"
              }
            ],
            "scoreLabel": "专业参与合计分（试用版，0–16 分）",
            "provisional": true
          }
        ],
