          {
            "scoreKey": "teaching_learning",
            "headline": "让数字工具留下看得见的学习证据",
            "source": {
              "type": "score_only"
            },
            "summary": "这一部分问的是数字工具怎样进入教学活动、支持小组协作，以及学生怎样用它们规划和回顾自己的学习。评价一次尝试时，可以看看学生能否更清楚地说出自己改了什么、为何要改。可回看的讨论、证据记录和版本变化，都能帮助你判断这项设计有没有用。",
            "bands": [],
            "guidance": [
              {
                "category": "reflection",
                "text": "小组作业增加一项简短要求：提交一条证据、来源和小组为什么采用它。用一份共享记录保留讨论和修改。"
              },
              {
                "category": "strategy",
                "text": "下课前请学生写两句：今天我弄明白了什么，下次我要先做什么。下次课再给他们一分钟回看。"
              },
              {
                "category": "environment",
                "text": "挑一个在线讨论贴，在学生卡住时补一个提示性问题。观察这条提示是否引出了不同的思路。"
              }
            ],
            "scoreLabel": "教学与学习合计分（试用版，0–16 分）",
            "provisional": true
          }
