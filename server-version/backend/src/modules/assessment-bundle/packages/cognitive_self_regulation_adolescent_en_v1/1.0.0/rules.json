          },
          {
            "op": "present",
            "evidenceKey": "gonogo.d_prime"
          },
          {
            "op": "present",
            "evidenceKey": "cpt.d_prime"
          },
          {
            "op": "present",
            "evidenceKey": "cpt.omission_rate"
          },
          {
            "op": "present",
            "evidenceKey": "cpt.commission_rate"
          },
          {
            "op": "present",
            "evidenceKey": "cpt.rt_icv"
          },
          {
            "op": "present",
            "evidenceKey": "flanker.flanker_effect_ms"
          },
          {
            "op": "present",
            "evidenceKey": "flanker.congruent_accuracy"
          },
