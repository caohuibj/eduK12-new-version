          "channels": [
            {
              "channelKey": "behavior",
              "purpose": "BEHAVIOR_TENDENCY",
              "responseType": "SINGLE_CHOICE",
              "scoredConstruct": "bfi2.assertiveness",
              "prompt": "如果是你，下一步最可能怎么做？",
              "options": [
