<hui-page title="{{title}}" description="{{description}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card><hui-status wx:if="{{resourceStatus}}" label="{{resourceStatus}}"/><hui-content text="{{content}}" facts="{{facts}}" images="{{images}}"/><hui-feedback wx:if="{{notice}}" message="{{notice}}"/><hui-card wx:if="{{ownSubmission}}" title="我的提交"><text>{{ownSubmission.content}}</text><hui-content facts="{{ownSubmission.facts}}" images="{{ownSubmission.images}}"/></hui-card><hui-button wx:for="{{actions}}" wx:key="key" secondary data-key="{{item.key}}" bindpress="action">{{item.label}}</hui-button></hui-card></hui-page>
