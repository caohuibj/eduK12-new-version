<hui-page title="{{title}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry"><hui-card wx:if="{{!submitted}}"><hui-content text="{{body}}" images="{{publishedImages}}"/><hui-field label="打卡内容" multiline maxlength="1000" value="{{content}}" disabled="{{status === 'submitting'}}" bindchange="change"/><hui-button secondary disabled="{{status === 'submitting' || images.length >= 9}}" bindpress="upload">添加图片（{{images.length}} / 9）</hui-button><hui-button wx:for="{{images}}" wx:key="assetId" data-index="{{index}}" secondary bindpress="remove">移除图片 {{index + 1}}</hui-button><hui-feedback kind="error" message="{{formError}}"/><hui-button loading="{{status === 'submitting'}}" bindpress="submit">提交打卡</hui-button></hui-card><hui-card wx:else><hui-feedback message="服务器已确认打卡完成"/><hui-button bindpress="home">返回</hui-button></hui-card></hui-page>