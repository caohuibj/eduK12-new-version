<hui-page title="{{title}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card wx:if="{{!result}}"><block wx:for="{{fields}}" wx:key="key"><hui-questions wx:if="{{item.type === 'questions'}}" value="{{item.value}}" disabled="{{sealed || status === 'submitting'}}" data-key="{{item.key}}" bindchange="change"/><hui-button wx:elif="{{item.selector}}" secondary data-key="{{item.key}}" disabled="{{status === 'submitting' || sealed}}" bindpress="choose">{{item.label}}：{{item.selectionLabel || '点击选择'}}</hui-button><hui-choice wx:elif="{{item.choices}}" label="{{item.label}}" choices="{{item.choices}}" value="{{item.value}}" multiple="{{item.multiple}}" disabled="{{sealed || status === 'submitting'}}" data-key="{{item.key}}" bindchange="change"/><hui-choice wx:elif="{{item.type === 'boolean'}}" label="{{item.label}}" value="{{item.value}}" choices="{{booleanChoices}}" disabled="{{sealed || status === 'submitting'}}" data-key="{{item.key}}" bindchange="change"/><hui-field wx:else label="{{item.label}}" value="{{item.value}}" type="{{item.type === 'number' ? 'number' : 'text'}}" password="{{item.password}}" multiline="{{item.multiline}}" maxlength="{{item.maxlength || 128}}" hint="{{item.dateTime ? '示例：2026-10-30T18:00:00+09:00' : ''}}" disabled="{{status === 'submitting' || sealed}}" data-key="{{item.key}}" bindchange="change"/></block><block wx:if="{{canUploadImages}}"><hui-button secondary disabled="{{sealed || status === 'submitting' || images.length >= 9}}" bindpress="upload">添加图片（{{images.length}} / 9）</hui-button><hui-button wx:for="{{images}}" wx:key="assetId" secondary data-index="{{index}}" bindpress="removeImage">移除图片 {{index + 1}}</hui-button></block><hui-feedback kind="error" message="{{formError}}"/><hui-button disabled="{{conflict}}" loading="{{status === 'submitting'}}" bindpress="confirm">核对并提交</hui-button></hui-card><hui-card wx:if="{{result}}"><hui-feedback message="{{result.message}}"/><hui-feedback wx:if="{{result.handoffFile}}" message="临时密码已写入受保护交接文件，请使用现有交接流程。"/><hui-content wx:if="{{result.code}}" text="{{result.code}}"/><hui-button wx:if="{{result.publicLink}}" secondary bindpress="copyLink">复制公开打卡链接</hui-button><hui-button bindpress="back">返回</hui-button></hui-card><hui-overlay open="{{confirmationOpen}}" title="核对操作" binddismiss="cancel"><hui-feedback message="{{confirmation}}"/><hui-button loading="{{status === 'submitting'}}" bindpress="submit">确认</hui-button><hui-button secondary disabled="{{status === 'submitting' || sealed}}" bindpress="cancel">取消</hui-button></hui-overlay></hui-page>
