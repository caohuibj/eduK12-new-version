<hui-page title="{{title}}" description="{{description}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card><text wx:if="{{instruction}}" class="body instructions">{{instruction}}</text><hui-card wx:if="{{unitTitle || unitInstruction}}" title="{{unitTitle}}"><text wx:if="{{unitInstruction}}" class="body instructions">{{unitInstruction}}</text></hui-card><hui-feedback message="{{notice}}"/><block wx:if="{{item}}"><hui-status label="题目 {{item.position}} / {{item.total}}"/><hui-content text="{{item.scenarioText}}"/><text class="heading">{{item.scenarioTitle}}</text><hui-choice wx:if="{{item.isChoice}}" label="{{item.label}}" value="{{item.choiceValue}}" choices="{{item.choices}}" multiple="{{item.multiple}}" disabled="{{item.locked || status === 'submitting'}}" bindchange="change"/><hui-field wx:else label="{{item.label}}" value="{{item.value}}" type="{{item.numeric ? 'digit' : 'text'}}" multiline="{{item.type === 'text_input'}}" maxlength="10000" disabled="{{item.locked || status === 'submitting'}}" bindchange="change"/><hui-button secondary disabled="{{item.position === 1 || status === 'submitting'}}" bindpress="previous">上一题</hui-button><hui-button secondary wx:if="{{item.position &lt; item.total}}" disabled="{{status === 'submitting'}}" bindpress="next">下一题</hui-button></block><hui-feedback kind="error" message="{{saveError}}"/><hui-button wx:if="{{saveError}}" secondary bindpress="save">重试保存草稿</hui-button><hui-feedback kind="error" message="{{submitError}}"/><hui-button wx:if="{{hasUnit}}" disabled="{{!canSubmit || saving}}" loading="{{status === 'submitting'}}" bindpress="submit">{{runtimeState === 'sealed' || runtimeState === 'recoverable' ? '重试原提交' : '提交当前单元'}}</hui-button><hui-button wx:if="{{canFinish}}" loading="{{status === 'submitting'}}" bindpress="finish">完成测评</hui-button><hui-button wx:if="{{canReport}}" bindpress="report">查看服务器报告</hui-button><hui-button wx:if="{{canDiscard}}" secondary bindpress="discard">核对后清理旧草稿</hui-button><hui-button wx:if="{{canRestart}}" secondary bindpress="restart">确认重启</hui-button><hui-button wx:if="{{runtimeState === 'conflict' || runtimeState === 'recoverable' || runtimeState === 'draftConflict'}}" secondary bindpress="retry">重新读取服务器状态</hui-button><hui-button wx:if="{{canWeb}}" secondary bindpress="web">使用正式网页测评</hui-button></hui-card></hui-page>
