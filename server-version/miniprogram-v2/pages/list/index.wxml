<hui-page title="{{title}}" description="{{description}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card><hui-field wx:if="{{domain === 'users' || domain === 'students' || domain === 'catalog'}}" label="搜索" bindchange="change"/><hui-button wx:if="{{domain === 'users' || domain === 'students' || domain === 'catalog'}}" secondary bindpress="search">搜索</hui-button><hui-button wx:for="{{actions}}" wx:key="key" secondary data-key="{{item.key}}" bindpress="action">{{item.label}}</hui-button><hui-list items="{{list}}" bindselect="select"/><hui-feedback wx:if="{{truncated}}" message="仅展示部分记录；完整历史请在 Web 查看。"/><hui-feedback wx:if="{{moreError}}" kind="error" message="{{moreError}}"/><hui-button wx:if="{{hasMore}}" secondary loading="{{status === 'submitting'}}" bindpress="more">加载更多</hui-button></hui-card></hui-page>
