<hui-page title="{{title}}" description="{{description}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card><hui-feedback message="{{notice}}"/><hui-feedback wx:if="{{result}}" message="{{result}}"/><hui-feedback kind="error" message="{{formError}}"/><hui-button wx:for="{{actions}}" wx:key="key" data-key="{{item.key}}" secondary disabled="{{status === 'submitting'}}" bindpress="action">{{item.label}}</hui-button><hui-list items="{{list}}" bindselect="select"/><hui-list items="{{tracks}}"/><hui-button wx:if="{{hasMore}}" secondary bindpress="more">加载更多</hui-button></hui-card><hui-card wx:if="{{fields}}" title="{{formTitle}}"><block wx:for="{{fields}}" wx:key="key"><hui-button wx:if="{{item.selector}}" data-key="{{item.key}}" secondary bindpress="choose">{{item.label}}：{{item.selectionLabel || '点击选择'}}</hui-button><hui-choice wx:elif="{{item.choices}}" label="{{item.label}}" value="{{item.value}}" choices="{{item.choices}}" data-key="{{item.key}}" bindchange="change"/><hui-field wx:else label="{{item.label}}" value="{{item.value}}" multiline="{{item.multiline}}" maxlength="5000" hint="{{item.dateTime ? '示例：2026-10-30T18:00:00+09:00' : ''}}" data-key="{{item.key}}" disabled="{{status === 'submitting'}}" bindchange="change"/></block><hui-button bindpress="confirm">核对并提交</hui-button></hui-card><hui-card wx:if="{{preview}}" title="服务器发布预览"><hui-content facts="{{previewFacts}}"/><hui-button bindpress="confirm">确认发布当前预览版本</hui-button></hui-card><hui-overlay open="{{confirmationOpen}}" title="核对操作" binddismiss="cancel"><hui-feedback message="{{preview ? '将按当前预览版本发布。服务器会重新检查范围和权限。' : confirmation}}"/><hui-button loading="{{status === 'submitting'}}" bindpress="submit">确认</hui-button><hui-button secondary disabled="{{status === 'submitting'}}" bindpress="cancel">取消</hui-button></hui-overlay><hui-button wx:if="{{webTarget}}" secondary bindpress="web">打开正式报告工作区</hui-button></hui-page>