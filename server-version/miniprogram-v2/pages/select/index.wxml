<hui-page title="选择{{title}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card><hui-field label="搜索" value="{{keyword}}" bindchange="change"/><hui-button secondary bindpress="search">搜索</hui-button><hui-list items="{{list}}" bindselect="select"/><hui-button wx:if="{{hasMore}}" secondary bindpress="more">加载更多</hui-button><hui-feedback message="已选：{{selectedLabel}}"/><hui-button bindpress="done">确认选择</hui-button><hui-feedback kind="error" message="{{formError}}"/></hui-card></hui-page>
