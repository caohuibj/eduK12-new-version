<hui-page title="{{title}}" description="{{description}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card><hui-feedback message="{{notice}}"/><hui-list wx:if="{{entries.length}}" items="{{entries}}" bindselect="select"/><block wx:for="{{contextFields}}" wx:key="key"><hui-choice wx:if="{{item.isChoice}}" label="{{item.label}}" choices="{{item.choices}}" value="{{item.value}}" data-key="{{item.key}}" bindchange="contextChange"/><hui-field wx:else label="{{item.label}}" value="{{item.value}}" data-key="{{item.key}}" bindchange="contextChange"/></block><hui-feedback kind="error" message="{{actionError}}"/><hui-button wx:if="{{canStart}}" loading="{{status === 'submitting'}}" bindpress="start">开始或继续测评</hui-button><hui-button wx:if="{{canReport}}" bindpress="report">查看报告</hui-button><hui-button wx:if="{{canWeb}}" secondary bindpress="web">使用正式网页</hui-button></hui-card></hui-page>
