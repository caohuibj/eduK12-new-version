<hui-page title="{{title}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card><hui-content text="{{content}}" facts="{{facts}}" images="{{images}}" bindimageerror="imageError"/><hui-button wx:if="{{images.length}}" secondary bindpress="retry">刷新记录与图片</hui-button><hui-content facts="{{answers}}"/><block wx:if="{{canGrade}}"><hui-field label="评语" value="{{comment}}" multiline maxlength="5000" bindchange="change"/><hui-button loading="{{status === 'submitting'}}" bindpress="grade">提交评语</hui-button></block><block wx:if="{{canRoster}}"><hui-button wx:if="{{canFreeze}}" secondary data-action="{{student.isFrozen ? 'unfreeze' : 'freeze'}}" bindpress="roster">{{student.isFrozen ? '解冻' : '冻结'}}账户</hui-button><hui-button wx:if="{{canResetPassword}}" secondary data-action="resetPassword" bindpress="roster">重置密码</hui-button><hui-button secondary data-action="remove" bindpress="roster">移出课程</hui-button></block><hui-button wx:if="{{publicLink}}" secondary bindpress="copyLink">复制公开打卡链接</hui-button><hui-button wx:if="{{publicLink}}" secondary bindpress="revokeToken">撤销公开链接</hui-button><block wx:if="{{canEditQuestion}}"><hui-field label="题目文字" multiline value="{{questionText}}" maxlength="10000" data-key="questionText" bindchange="questionChange"/><hui-field label="答题秒数" type="number" value="{{timeLimit}}" data-key="timeLimit" bindchange="questionChange"/><hui-button data-action="edit" loading="{{status === 'submitting'}}" bindpress="questionCommand">保存题目</hui-button></block><hui-button wx:if="{{canDeleteQuestion}}" secondary data-action="delete" loading="{{status === 'submitting'}}" bindpress="questionCommand">删除题目</hui-button><hui-feedback kind="error" message="{{questionError}}"/><hui-feedback kind="error" message="{{actionError}}"/></hui-card></hui-page>
