<hui-page title="修改密码" description="首次登录请先设置自己的密码" status="ready"><hui-card><hui-field label="原密码" password value="{{oldPassword}}" data-field="oldPassword" bindchange="change"/><hui-field label="新密码" password value="{{newPassword}}" hint="8–128 位，包含字母和数字" data-field="newPassword" bindchange="change"/><hui-field label="确认新密码" password value="{{confirmation}}" data-field="confirmation" bindchange="change"/><hui-feedback wx:if="errorMessage" kind="error" message="{{errorMessage}}"/><hui-button loading="{{status === 'submitting'}}" bindpress="submit">保存密码</hui-button><hui-button secondary disabled="{{status === 'submitting'}}" bindpress="logout">退出登录</hui-button></hui-card></hui-page>
