<hui-page title="登录 Huisurvey" description="使用与 Web 相同的账号" status="ready"><hui-card><hui-field label="账号" value="{{username}}" maxlength="320" data-field="username" bindchange="change"/><hui-field label="密码" value="{{password}}" password data-field="password" bindchange="change"/><hui-feedback wx:if="errorMessage" kind="error" message="{{errorMessage}}"/><hui-button loading="{{status === 'submitting'}}" bindpress="submit">登录</hui-button><hui-button secondary disabled="{{status === 'submitting'}}" bindpress="register">使用邀请码注册</hui-button></hui-card></hui-page>
