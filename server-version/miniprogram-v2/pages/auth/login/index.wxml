<hui-page title="登录 Training" description="使用 Training 学员账号，继续课程学习" status="ready"><hui-card><hui-field label="账号" disabled="{{status === 'submitting'}}" placeholder="请输入用户名" value="{{username}}" maxlength="320" data-field="username" bindchange="change"/><hui-field label="密码" disabled="{{status === 'submitting'}}" placeholder="请输入密码" value="{{password}}" password data-field="password" bindchange="change"/><hui-feedback wx:if="{{errorMessage}}" kind="error" message="{{errorMessage}}"/><hui-button loading="{{status === 'submitting'}}" bindpress="submit">登录</hui-button><hui-button secondary disabled="{{status === 'submitting'}}" bindpress="register">使用课程码注册</hui-button></hui-card></hui-page>
