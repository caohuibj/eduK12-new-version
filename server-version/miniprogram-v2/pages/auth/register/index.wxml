<hui-page title="邀请码注册" description="学生使用课程码，教师使用教师码。家长账号请联系管理员。" status="ready"><hui-card wx:if="{{!done}}"><hui-tabs items="{{tabs}}" active="{{kind}}" bindchange="select"/><hui-field label="账号" maxlength="20" value="{{username}}" data-field="username" bindchange="change"/><hui-field label="姓名" value="{{nickname}}" data-field="nickname" bindchange="change"/><hui-field label="密码" password value="{{password}}" hint="8–128 位，包含字母和数字" data-field="password" bindchange="change"/><hui-field label="{{kind === 'student' ? '课程码' : '教师码'}}" value="{{code}}" data-field="code" bindchange="change"/><hui-feedback wx:if="{{errorMessage}}" kind="error" message="{{errorMessage}}"/><hui-button loading="{{status === 'submitting'}}" bindpress="submit">注册</hui-button></hui-card><hui-card wx:else title="注册成功" subtitle="教师账号需要审核后才能登录。"><hui-button bindpress="login">返回登录</hui-button></hui-card></hui-page>
