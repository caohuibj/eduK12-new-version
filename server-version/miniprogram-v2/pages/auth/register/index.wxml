<hui-page title="学员注册" description="使用培训师提供的课程码创建学员账号。" status="ready"><hui-card wx:if="{{!done}}"><hui-field label="账号" maxlength="20" value="{{username}}" data-field="username" bindchange="change"/><hui-field label="姓名" value="{{nickname}}" data-field="nickname" bindchange="change"/><hui-field label="密码" password value="{{password}}" hint="8–128 位，包含字母和数字" data-field="password" bindchange="change"/><hui-field label="{{kind === 'student' ? '课程码' : '教师码'}}" value="{{code}}" data-field="code" bindchange="change"/><hui-feedback wx:if="{{errorMessage}}" kind="error" message="{{errorMessage}}"/><hui-button loading="{{status === 'submitting'}}" bindpress="submit">注册</hui-button></hui-card><hui-card wx:else title="注册成功" subtitle="请使用刚注册的学员账号登录。"><hui-button bindpress="login">返回登录</hui-button></hui-card></hui-page>
