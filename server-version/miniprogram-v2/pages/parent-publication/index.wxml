<hui-page title="{{title}}" description="{{description}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card><hui-feedback message="{{notice}}"/><hui-feedback kind="error" message="{{actionError}}"/><hui-list items="{{list}}" bindselect="select"/><hui-feedback wx:if="{{truncated}}" message="仅展示最近部分记录。"/><hui-card wx:if="{{preview}}" title="{{preview.title}}"><hui-card wx:for="{{blocks}}" wx:key="key" title="{{item.title}}"><hui-content text="{{item.text}}"/></hui-card><hui-button loading="{{status === 'submitting'}}" bindpress="publish">核对并发布</hui-button><hui-button secondary bindpress="consents">查看当前版本的学生同意</hui-button></hui-card><hui-list items="{{consents}}" bindselect="grant"/></hui-card></hui-page>
