<hui-page title="{{title}}" description="{{description}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card><hui-feedback message="这是测量工具的披露上限。每份报告仍需学生同意及独立授权；调高上限不会扩充已同意的报告。原始作答、单题信息与研究导出不开放。"/><hui-choice label="家长可见范围" value="{{mode}}" choices="{{choices}}" data-key="mode" bindchange="change"/><block wx:if="{{mode === 'INDIVIDUAL_SUMMARY'}}"><hui-field label="允许披露的指标编号（来自正式报告方案，逗号分隔）" value="{{metricKeys}}" data-key="metricKeys" bindchange="change"/><hui-field label="允许纵向展示的指标编号" value="{{longitudinalKeys}}" data-key="longitudinalKeys" bindchange="change"/></block><hui-feedback kind="error" message="{{formError}}"/><hui-button disabled="{{!canSave}}" bindpress="confirm">核对并保存</hui-button></hui-card><hui-overlay open="{{confirmationOpen}}" title="确认披露设置" binddismiss="cancel"><hui-feedback message="收紧设置会立即限制后续报告访问。放宽设置仍需正式家长报告内容与对应授权，不能使教师报告或草稿自动成为家长报告。"/><hui-button loading="{{status === 'submitting'}}" bindpress="save">确认保存</hui-button><hui-button secondary disabled="{{status === 'submitting'}}" bindpress="cancel">取消</hui-button></hui-overlay><hui-button wx:if="{{!canSave}}" bindpress="retry">刷新披露设置</hui-button></hui-page>