<hui-page title="{{title}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card title="{{nickname}}"><hui-field label="账号" value="{{username}}" disabled/><hui-button wx:if="{{canManageParentLinks}}" secondary bindpress="parentLinks">家长关联</hui-button><hui-button secondary bindpress="edit">编辑资料</hui-button><hui-button secondary bindpress="password">修改密码</hui-button><hui-button secondary loading="{{status === 'submitting'}}" bindpress="logout">退出登录</hui-button></hui-card></hui-page>
