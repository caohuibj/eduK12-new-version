<hui-page title="{{title}}" description="{{description}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card><hui-feedback message="{{notice}}"/><hui-status wx:if="{{completedAt}}" label="{{completedAt}}"/><hui-list wx:if="{{list}}" items="{{list}}" bindselect="select"/><hui-series-chart wx:for="{{series}}" wx:key="key" title="{{item.title}}" points="{{item.points}}"/><hui-card wx:for="{{blocks}}" wx:key="key" title="{{item.title}}"><hui-content text="{{item.text}}"/></hui-card><hui-button wx:if="{{canWeb}}" secondary bindpress="web">查看正式网页完整报告</hui-button></hui-card></hui-page>
