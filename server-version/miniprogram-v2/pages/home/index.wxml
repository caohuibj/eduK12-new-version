<hui-page title="{{title}}" description="{{description}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><block wx:if="{{training}}">
<view class="training-toolbar"><hui-button secondary bindpress="join">加入课程</hui-button><hui-button secondary bindpress="profile">我的账户</hui-button></view>
<view wx:if="{{!courses.length}}" class="training-welcome"><text class="training-eyebrow">开始你的学习旅程</text><text class="training-heading">第一门课程，从这里开始</text><text class="training-copy">向培训师获取课程码，加入后即可查看学习任务。</text><hui-button bindpress="join">输入课程码</hui-button><view class="training-steps"><text>01  加入课程</text><text>02  进入课程</text><text>03  完成练习、打卡与测评</text></view></view>
<view wx:for="{{courses}}" wx:key="id" class="training-course" data-id="{{item.id}}" bindtap="course" role="button" aria-label="{{'进入课程：' + item.title}}"><text class="training-eyebrow">已加入 · 课程</text><text class="training-heading">{{item.title}}</text><text class="training-copy">{{item.description}}</text><text class="training-course-action">进入学习 →</text></view>
<hui-feedback wx:if="{{moreError}}" kind="error" message="{{moreError}}"/>
<hui-button wx:if="{{nextCursor}}" secondary loading="{{moreLoading}}" bindpress="moreCourses">加载更多课程</hui-button>
</block><block wx:else><hui-card wx:for="{{blocks}}" wx:key="domain" title="{{item.title}}" subtitle="{{item.total === null ? '' : '共 ' + item.total + ' 项'}}"><hui-list items="{{item.list}}" bindselect="select"/><hui-button secondary data-domain="{{item.domain}}" bindpress="more">查看全部</hui-button></hui-card><hui-card wx:if="{{shortcuts.length}}" title="常用功能"><hui-button wx:for="{{shortcuts}}" wx:key="key" secondary data-key="{{item.key}}" bindpress="shortcut">{{item.label}}</hui-button></hui-card><hui-button secondary bindpress="scan">扫码进入</hui-button></block></hui-page>
