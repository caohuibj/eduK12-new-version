<hui-page title="{{title}}" description="{{description}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card wx:for="{{blocks}}" wx:key="domain" title="{{item.title}}" subtitle="{{item.total === null ? '' : '共 ' + item.total + ' 项'}}"><hui-list items="{{item.list}}" bindselect="select"/><hui-button secondary data-domain="{{item.domain}}" bindpress="more">查看全部</hui-button></hui-card><hui-card wx:if="{{shortcuts.length}}" title="常用功能"><hui-button wx:for="{{shortcuts}}" wx:key="key" secondary data-key="{{item.key}}" bindpress="shortcut">{{item.label}}</hui-button></hui-card><hui-button secondary bindpress="scan">扫码进入</hui-button></hui-page>
