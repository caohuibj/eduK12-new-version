<hui-page title="{{title}}" description="{{description}}" status="{{status}}" error-message="{{errorMessage}}" nav-items="{{navItems}}" bindretry="retry" bindnavigate="navigate"><hui-card wx:if="{{joinReady}}"><hui-field label="六位课堂码" maxlength="6" value="{{code}}" bindchange="changeCode"/><hui-button loading="{{status === 'submitting'}}" bindpress="join">加入课堂</hui-button></hui-card><hui-card wx:else><hui-feedback message="{{notice}}"/><hui-feedback wx:if="{{pollError}}" kind="error" message="{{pollError}}"/><hui-button wx:if="{{pollError}}" bindpress="retry">刷新课堂</hui-button><hui-content wx:if="{{question}}" text="{{questionText}}"/><hui-status wx:if="{{question}}" label="剩余时间" value="{{remaining + ' 秒'}}"/><block wx:if="{{canSubmit}}"><hui-choice wx:if="{{choices.length}}" choices="{{choices}}" multiple="{{multiple}}" value="{{answer}}" disabled="{{status === 'submitting'}}" bindchange="changeAnswer"/><hui-field wx:else label="答案" multiline maxlength="10000" value="{{answer}}" disabled="{{status === 'submitting'}}" bindchange="changeAnswer"/><hui-button loading="{{status === 'submitting'}}" bindpress="submit">提交答案</hui-button></block><hui-content facts="{{statsFacts}}"/><hui-content facts="{{optionStats}}"/><hui-list wx:if="{{canStart}}" items="{{questions}}" bindselect="start"/><hui-button wx:if="{{canEnd}}" secondary loading="{{status === 'submitting'}}" bindpress="end">结束当前题目</hui-button><hui-button wx:if="{{canClose}}" secondary bindpress="close">结束课堂</hui-button><hui-button wx:if="{{canLeave}}" secondary bindpress="leave">离开课堂</hui-button></hui-card><hui-feedback kind="error" message="{{commandError}}"/></hui-page>