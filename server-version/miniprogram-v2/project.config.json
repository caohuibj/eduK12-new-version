{
  "appid": "touristappid",
  "projectname": "Training-student-native",
  "description": "Training 原生学员客户端（开发验收）",
  "compileType": "miniprogram",
  "miniprogramRoot": "./",
  "libVersion": "3.7.12",
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "minified": true
  },
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "scripts"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": "package.json"
      },
      {
        "type": "file",
        "value": "project.private.config.json"
      }
    ]
  }
}
