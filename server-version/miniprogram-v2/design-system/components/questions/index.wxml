<view><hui-card wx:for="{{questions}}" wx:key="id" title="题目 {{index + 1}}"><hui-field label="题目" multiline maxlength="10000" value="{{item.question}}" disabled="{{disabled}}" data-q="{{index}}" data-key="question" bindchange="change"/><hui-choice label="题型" choices="{{types}}" value="{{item.type}}" disabled="{{disabled}}" data-q="{{index}}" data-key="type" bindchange="change"/><block wx:if="{{item.type !== 'text'}}"><view wx:for="{{item.options}}" wx:for-item="option" wx:for-index="optionIndex" wx:key="key"><hui-field label="选项 {{option.key}}" value="{{option.text}}" disabled="{{disabled}}" data-q="{{index}}" data-option="{{optionIndex}}" data-key="text" bindchange="option"/><hui-field label="该选项分值" type="digit" value="{{option.points}}" disabled="{{disabled}}" data-q="{{index}}" data-option="{{optionIndex}}" data-key="points" bindchange="option"/><hui-button secondary data-q="{{index}}" data-option="{{optionIndex}}" disabled="{{disabled}}" bindpress="removeOption">移除选项</hui-button></view><hui-button secondary data-q="{{index}}" disabled="{{disabled}}" bindpress="addOption">添加选项</hui-button></block><hui-button secondary data-q="{{index}}" disabled="{{disabled}}" bindpress="remove">移除题目</hui-button></hui-card><hui-button secondary disabled="{{disabled}}" bindpress="add">添加作业题目</hui-button></view>