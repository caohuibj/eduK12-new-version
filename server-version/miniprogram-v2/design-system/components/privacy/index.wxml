<view wx:if="{{open}}" class="backdrop privacy-backdrop" catchtouchmove="stop"><view class="overlay"><text class="title">图片隐私授权</text><text class="body">选择图片前，请阅读并同意小程序隐私保护指引。</text><button class="button secondary" bindtap="contract">{{contractName}}</button><text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text><button id="hui-privacy-agree" class="button" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agree">同意并继续选图</button><button class="button secondary" bindtap="decline">暂不同意</button></view></view>
