<view class="list"><view wx:for="{{items}}" wx:key="id" class="row" data-id="{{item.id}}" data-domain="{{item.domain}}" data-open="{{item.canOpen}}" bindtap="select"><view><text class="body">{{item.title}}</text><text wx:if="{{item.detail}}" class="muted">{{item.detail}}</text></view><text class="badge">{{item.status}}</text></view><text wx:if="{{!items.length}}" class="muted">暂无内容</text></view>
