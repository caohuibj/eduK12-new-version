@import "../tokens/index.wxss";
:host { display: block; }
.page { padding: var(--space-lg); padding-bottom: calc(var(--size-nav) + env(safe-area-inset-bottom) + var(--space-lg)); }
.heading { display: flex; flex-direction: column; gap: var(--space-sm); margin-bottom: var(--space-md); }
.title { font-size: var(--type-title); font-weight: 600; }
.card { background: var(--color-surface); padding: var(--space-lg); margin-bottom: var(--space-md); border-radius: var(--radius-card); }
.card .heading { font-size: var(--type-heading); font-weight: 600; }
.muted { display: block; font-size: var(--type-small); color: var(--color-muted); margin: var(--space-sm) 0; }
.error { display: block; color: var(--color-error); font-size: var(--type-body); }
.button { background: var(--color-primary); color: var(--color-surface); min-height: var(--size-control); display: flex; align-items: center; justify-content: center; border-radius: var(--radius-control); font-size: var(--type-body); margin-top: var(--space-md); padding: var(--space-sm) var(--space-md); }
.button::after, .nav-button::after, .tab::after { border: none; }
.button[disabled] { opacity: .55; }
.secondary { background: var(--color-soft); color: var(--color-primary); }
.field { margin-bottom: var(--space-md); }
.label { display: block; font-size: var(--type-small); margin-bottom: var(--space-sm); }
.input { background: var(--color-background); min-height: var(--size-control); border: 1rpx solid var(--color-border); border-radius: var(--radius-control); padding: 0 var(--space-md); font-size: var(--type-body); }
.row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); padding: var(--space-md) 0; border-bottom: 1rpx solid var(--color-border); }
.body { display: block; font-size: var(--type-body); word-break: break-all; }
.badge { font-size: var(--type-small); color: var(--color-primary); background: var(--color-soft); border-radius: var(--radius-control); padding: var(--space-xs) var(--space-sm); flex-shrink: 0; }
.feedback { padding: var(--space-md) 0; }
.skeleton { height: var(--size-control); background: var(--color-border); border-radius: var(--radius-control); margin: var(--space-md) 0; }
.navigation { position: fixed; bottom: 0; left: 0; right: 0; background: var(--color-surface); display: flex; border-top: 1rpx solid var(--color-border); padding-bottom: env(safe-area-inset-bottom); }
.nav-button { flex: 1; min-height: var(--size-nav); background: var(--color-surface); color: var(--color-primary); padding: var(--space-sm) 0; font-size: var(--type-small); display: flex; align-items: center; justify-content: center; }
.tabs { display: flex; gap: var(--space-sm); }
.tab { flex: 1; background: var(--color-background); color: var(--color-muted); font-size: var(--type-body); border-radius: var(--radius-control); }
.selected { color: var(--color-primary); background: var(--color-soft); }
.backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.35); display: flex; align-items: center; justify-content: center; }
.overlay { background: var(--color-surface); border-radius: var(--radius-card); padding: var(--space-lg); margin: var(--space-lg); }
.sheet { align-self: flex-end; width: 100%; padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom)); }

.textarea { min-height: calc(var(--size-control) * 3); padding-top: var(--space-md); }
.media { width: 100%; margin-top: var(--space-md); border-radius: var(--radius-control); }
