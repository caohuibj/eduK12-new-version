# ==========================================
# eduK12 / PTool Docker Baseline 环境变量
# 复制本文件为 .env 并填写数据库、JWT、加密、CORS 和 seed 凭据后再运行 compose
# ==========================================

# --- Postgres 服务专用 ---
# 注意：DB_* 只注入 postgres 容器（POSTGRES_USER/PASSWORD/DB），
# 不是后端变量；DATABASE_URL 仍需单独填写，并且必须与这些值匹配。
DB_USER=
DB_PASSWORD=
DB_NAME=ptool

# --- 应用数据库连接（完整 URL；用户名/密码中的 reserved character 必须 percent-encode）---
# 例如密码 p@ss:word 要写成 p%40ss%3Aword。
DATABASE_URL=postgresql://ptool:URL_ENCODED_DB_PASSWORD@postgres:5432/ptool?schema=public
# Prisma runtime pool settings; explicit DATABASE_URL query parameters take precedence.
PRISMA_CONNECTION_POOL_SIZE=10
PRISMA_POOL_TIMEOUT=30
# --- 可选 monitoring overlay 的 exporter 连接（同样使用已编码凭据）---
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://ptool:URL_ENCODED_DB_PASSWORD@postgres:5432/ptool?sslmode=disable

# --- 应用（backend / frontend 共用，经 compose 注入容器） ---
NODE_ENV=production
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Local HTTP Compose uses false; set true when the frontend is served over HTTPS.
COOKIE_SECURE=false
# Separate HMAC key for asset URLs; generate a random 32-byte hex value.
ASSET_SIGNING_SECRET=

# 生产必需：64 位十六进制（32 字节）。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# AssessmentContext 快照指纹密钥（可选；建议使用独立的 64 位十六进制密钥）。
# 未设置时由 backend 从 DATA_ENCRYPTION_KEY 派生域隔离 HMAC 密钥。
ASSESSMENT_CONTEXT_HASH_KEY=

# Bundle 新建/发布默认关闭；既有作答和报告保持可读。
BUNDLE_PRODUCTS_ENABLED=false
# 声明式 Bundle 审批专用密钥（至少 32 字符）；不填时禁止新发布/准入。
# 必须由受信审批流程保管，不能写入内容包或版本库。
BUNDLE_REVIEW_SIGNING_KEY=

# Cognitive 模块开关（严格 true/false；Release v1 默认开启）。
# 设为 true 时生产环境必须同时配置 DATA_PSEUDONYM_KEY；legacy-only 环境可显式设为 false。
# 路由级网关在 D3+ 接入。
COGNITIVE_MODULE_ENABLED=true
# 前端构建期认知模块开关；Release v1 与后端同时开启。
VITE_COGNITIVE_MODULE_ENABLED=true
MATERIAL_GRANTS_ENABLED=true
# Cognitive 参与者假名化密钥：64 位十六进制（32 字节），独立于 DATA_ENCRYPTION_KEY。
# 用途：participantKey = HMAC-SHA256(userId, DATA_PSEUDONYM_KEY)，保证加密密钥轮换不改变参与者身份。
# 生成方式：openssl rand -hex 32
DATA_PSEUDONYM_KEY=

# Redis（Docker 内唯一变量；不再使用 REDIS_HOST / REDIS_PORT）
REDIS_URL=redis://redis:6379
# Production Compose defaults this to true. Set false only for local/test
# single-process development where cross-process classroom broadcasts are not used.
SOCKET_REDIS_REQUIRED=true

# 上传目录（容器内绝对路径，挂载 uploads_data 卷）
UPLOAD_DIR=/app/uploads
# Keep legacy /uploads available during the reversible local migration window.
ASSET_MIGRATION_COMPLETE=false
CREDENTIAL_HANDOFF_TTL_HOURS=24

# 生产环境必须显式设置为实际前端 origin（不要使用 *）
CORS_ORIGIN=https://your-frontend.example.com
TRUST_PROXY_HOPS=2

# --- Bounded admission conservative defaults ---
# These values are safe pre-measurement starting points, NOT a 4C4G capacity certification.
# Replace them only from the production measurement pass.
UNIT_SUBMIT_ADMISSION_LIMIT=7
UNIT_SUBMIT_ADMISSION_QUEUE=16
UNIT_SUBMIT_ADMISSION_TIMEOUT_MS=500
UNIT_SUBMIT_RETRY_AFTER_SECONDS=1
AGGREGATE_FINALIZATION_ADMISSION_LIMIT=3
AGGREGATE_FINALIZATION_ADMISSION_QUEUE=4
AGGREGATE_FINALIZATION_ADMISSION_TIMEOUT_MS=250
AGGREGATE_FINALIZATION_RETRY_AFTER_SECONDS=1
# Legacy questionnaire completion gate (still coexists; aggregate uses COMPLETION_BUSY for clients).
QUESTIONNAIRE_COMPLETION_ADMISSION_LIMIT=8
QUESTIONNAIRE_COMPLETION_ADMISSION_QUEUE=64
QUESTIONNAIRE_COMPLETION_ADMISSION_TIMEOUT_MS=1500
QUESTIONNAIRE_COMPLETION_RETRY_AFTER_SECONDS=1

# --- Public assessment rate limiter (multi-budget: IP + start-token + recovery; not a cascade) ---
PUBLIC_ASSESSMENT_EXPECTED_CLASS_SIZE=60
PUBLIC_ASSESSMENT_EXPECTED_START_TOKEN_AUDIENCE=500
PUBLIC_ASSESSMENT_GETS_PER_STUDENT=40
PUBLIC_ASSESSMENT_FINALS_PER_STUDENT=8
PUBLIC_ASSESSMENT_NAT_SHARE_FACTOR=50
PUBLIC_ASSESSMENT_WINDOW_MS=900000
# Optional absolute ceilings (omit to use formula defaults: IP=N×G|F×NAT, token=A×G|F, recovery=G|F).
# PUBLIC_ASSESSMENT_IP_GET_LIMIT=
# PUBLIC_ASSESSMENT_IP_FINAL_LIMIT=
# PUBLIC_ASSESSMENT_TOKEN_GET_LIMIT=
# PUBLIC_ASSESSMENT_TOKEN_FINAL_LIMIT=
# PUBLIC_ASSESSMENT_RECOVERY_GET_LIMIT=
# PUBLIC_ASSESSMENT_RECOVERY_FINAL_LIMIT=

# 导出资源限制
EXPORT_MAX_RECORDS=10000
EXPORT_MAX_TRIALS=100000
EXPORT_MAX_FIELDS=2000
EXPORT_MAX_BYTES=52428800
EXPORT_RETENTION_HOURS=24
EXPORT_DIR=/app/exports

# Worker/media/export resource knobs. All are validated at process startup.
# Final concurrency values remain MEASUREMENT REQUIRED on the target 4C4G host.
VIDEO_LOW_POWER_MODE=true
VIDEO_RESOLUTION=480p
VIDEO_PRESET=veryfast
VIDEO_CRF=26
VIDEO_BITRATE=800k
VIDEO_AUDIO_BITRATE=96k
VIDEO_SMART_COMPRESSION=true
VIDEO_CONCURRENCY=1
VIDEO_TIMEOUT=1800
IMAGE_CONCURRENCY=1
IMAGE_TIMEOUT=30
EXPORT_CONCURRENCY=1
EXPORT_TIMEOUT=1800
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
# Canonical Compose API defaults this to false; the worker service is the
# consumer (BACKGROUND_WORKERS_ENABLED=true, smaller Prisma pool).
# Non-Compose `node dist/index.js` still defaults true outside NODE_ENV=test.
BACKGROUND_WORKERS_ENABLED=false
WORKER_PRISMA_CONNECTION_POOL_SIZE=4

# --- 管理员账号（运行 ops seed 时必须显式设置）---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- 可选监控栈 ---
# 启动 docker-compose.monitoring.yml 时必须显式设置
GRAFANA_PASSWORD=

# Pre-measurement 4C4G starting envelope; values must be confirmed on target hardware.
POSTGRES_CPUS=1.0
POSTGRES_MEM_LIMIT=1024m
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_MAX_CONNECTIONS=80
REDIS_CPUS=0.25
REDIS_MEM_LIMIT=256m
REDIS_MAXMEMORY=128mb
# noeviction is deliberate: Bull/limiter state must never be silently evicted.
BACKEND_CPUS=1.75
BACKEND_MEM_LIMIT=1024m
BACKEND_NODE_HEAP_MB=640
WORKER_CPUS=0.75
WORKER_MEM_LIMIT=768m
WORKER_NODE_HEAP_MB=192
FRONTEND_CPUS=0.25
FRONTEND_MEM_LIMIT=128m
# Host TLS proxy is the public ingress; nginx port is loopback only by default.
FRONTEND_BIND_ADDRESS=127.0.0.1
REGISTRATION_IP_LIMIT=3000
REGISTRATION_RESOURCE_LIMIT=3000
REGISTRATION_ACCOUNT_LIMIT=10
REGISTRATION_TEACHER_CODE_LIMIT=120
LOGIN_PASSWORD_MAX_CONCURRENT=4
LOGIN_PASSWORD_MAX_QUEUE=32
PASSWORD_CHANGE_REQUEST_LIMIT=10
UPLOAD_MAX_CONCURRENT=2
UPLOAD_REQUEST_LIMIT=30
UPLOAD_BYTE_BUDGET=629145600

REGISTRATION_MAX_CONCURRENT=2
REGISTRATION_MAX_QUEUE=16
REGISTRATION_MAX_WAIT_MS=3000

UPLOAD_IMAGE_MAX_PIXELS=16000000
LOGIN_IP_REQUEST_LIMIT=3000
LOGIN_PASSWORD_MAX_WAIT_MS=30000

REGISTRATION_GLOBAL_LIMIT=6000
