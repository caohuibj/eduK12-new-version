# ==========================================
# eduK12 / PTool Docker Baseline 环境变量
# 复制本文件为 .env 并填写 JWT_SECRET 与 DATA_ENCRYPTION_KEY 后再运行 compose
# ==========================================

# --- Postgres 服务专用 ---
# 注意：DB_* 只注入 postgres 容器（POSTGRES_USER/PASSWORD/DB），
# 不是后端变量，不要写进后端 .env.example 当后端配置用。
DB_USER=ptool
DB_PASSWORD=ptool123
DB_NAME=ptool

# --- 应用（backend / frontend 共用，经 compose 注入容器） ---
NODE_ENV=production
JWT_SECRET=your-secret-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=7d

# 生产必需：64 位十六进制（32 字节）。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cognitive 模块开关（严格 true/false 仅；Milestone D 完整验收前缺省 false）。
# 设为 true 时生产环境必须同时配置 DATA_PSEUDONYM_KEY；设为 false 时旧 eduK12 系统独立正常运行。
# 路由级网关在 D3+ 接入。
COGNITIVE_MODULE_ENABLED=false
# Cognitive 参与者假名化密钥：64 位十六进制（32 字节），独立于 DATA_ENCRYPTION_KEY。
# 用途：participantKey = HMAC-SHA256(userId, DATA_PSEUDONYM_KEY)，保证加密密钥轮换不改变参与者身份。
# 生成方式：openssl rand -hex 32
DATA_PSEUDONYM_KEY=

# Redis（Docker 内唯一变量；不再使用 REDIS_HOST / REDIS_PORT）
REDIS_URL=redis://redis:6379

# 上传目录（容器内绝对路径，挂载 uploads_data 卷）
UPLOAD_DIR=/app/uploads

# Socket.IO CORS（默认同源 *）
CORS_ORIGIN=*

# 视频处理低配优化（可选覆盖）
VIDEO_LOW_POWER_MODE=true
VIDEO_RESOLUTION=480p

# --- 管理员账号（seed 从环境变量读取；缺失时使用以下默认值）---
# 默认凭据仅用于本地演示，生产部署务必修改为强密码。
ADMIN_USERNAME=rateK12admin
ADMIN_PASSWORD=2026coding
