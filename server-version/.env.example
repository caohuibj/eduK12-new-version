# ==========================================
# eduK12 / PTool Docker Baseline 环境变量
# 复制本文件为 .env 并填写数据库、JWT、加密、CORS 和 seed 凭据后再运行 compose
# ==========================================

# --- Postgres 服务专用 ---
# 注意：DB_* 只注入 postgres 容器（POSTGRES_USER/PASSWORD/DB），
# 不是后端变量；DATABASE_URL 仍需单独填写，并且必须与这些值匹配。
DB_USER=
DB_PASSWORD=
DB_NAME=ptool

# --- 应用数据库连接（完整 URL；用户名/密码中的 reserved character 必须 percent-encode）---
# 例如密码 p@ss:word 要写成 p%40ss%3Aword。
DATABASE_URL=postgresql://ptool:URL_ENCODED_DB_PASSWORD@postgres:5432/ptool?schema=public
# --- 可选 monitoring overlay 的 exporter 连接（同样使用已编码凭据）---
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://ptool:URL_ENCODED_DB_PASSWORD@postgres:5432/ptool?sslmode=disable

# --- 应用（backend / frontend 共用，经 compose 注入容器） ---
NODE_ENV=production
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 生产必需：64 位十六进制（32 字节）。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# Cognitive 模块开关（严格 true/false；Release v1 默认开启）。
# 设为 true 时生产环境必须同时配置 DATA_PSEUDONYM_KEY；legacy-only 环境可显式设为 false。
# 路由级网关在 D3+ 接入。
COGNITIVE_MODULE_ENABLED=true
# 前端构建期认知模块开关；Release v1 与后端同时开启。
VITE_COGNITIVE_MODULE_ENABLED=true
MATERIAL_GRANTS_ENABLED=true
# Cognitive 参与者假名化密钥：64 位十六进制（32 字节），独立于 DATA_ENCRYPTION_KEY。
# 用途：participantKey = HMAC-SHA256(userId, DATA_PSEUDONYM_KEY)，保证加密密钥轮换不改变参与者身份。
# 生成方式：openssl rand -hex 32
DATA_PSEUDONYM_KEY=

# Redis（Docker 内唯一变量；不再使用 REDIS_HOST / REDIS_PORT）
REDIS_URL=redis://redis:6379

# 上传目录（容器内绝对路径，挂载 uploads_data 卷）
UPLOAD_DIR=/app/uploads
# Keep legacy /uploads available during the reversible local migration window.
ASSET_MIGRATION_COMPLETE=false

# 生产环境必须显式设置为实际前端 origin（不要使用 *）
CORS_ORIGIN=https://your-frontend.example.com
TRUST_PROXY_HOPS=1

# 导出资源限制
EXPORT_MAX_RECORDS=10000
EXPORT_MAX_TRIALS=100000
EXPORT_MAX_FIELDS=2000
EXPORT_MAX_BYTES=52428800
EXPORT_RETENTION_HOURS=24

# 视频处理低配优化（可选覆盖）
VIDEO_LOW_POWER_MODE=true
VIDEO_RESOLUTION=480p

# --- 管理员账号（运行 ops seed 时必须显式设置）---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- 可选监控栈 ---
# 启动 docker-compose.monitoring.yml 时必须显式设置
GRAFANA_PASSWORD=
