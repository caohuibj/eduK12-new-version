# PTool 监控配置

# 告警阈值
CPU_THRESHOLD=80
MEM_THRESHOLD=85
DISK_THRESHOLD=90
LOAD_THRESHOLD=4
CONN_THRESHOLD=15

# ==========================================
# 告警通知配置
# ==========================================

# 企业微信Webhook (推荐)
# 获取方式: 企业微信群 -> 群设置 -> 添加群机器人 -> 复制Webhook地址
# WECHAT_WEBHOOK="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxx"

# 钉钉Webhook
# 获取方式: 钉钉群 -> 群设置 -> 智能群助手 -> 添加机器人 -> 复制Webhook地址
# DINGTALK_WEBHOOK="https://oapi.dingtalk.com/robot/send?access_token=xxxxx"

# Slack Webhook
# ALERT_WEBHOOK="https://hooks.slack.com/services/..."

# 邮件告警
# ALERT_EMAIL="admin@example.com"

# 安全告警专用Webhook (可选，如不设置则使用上面的配置)
# SECURITY_WEBHOOK=""
# PERF_WEBHOOK=""
# BACKUP_WEBHOOK=""

# API检查配置
API_URL="http://localhost"
API_TIMEOUT=10

# 自动封禁配置
AUTO_BLOCK_IP=false
MAX_FAILED_LOGIN=5
LOGIN_WINDOW=300

# 数据库配置
DB_NAME="ptool"
DB_USER="ptool"

# SSL域名 (可选)
# DOMAIN="your-domain.com"
