[Unit]
Description=eduK12 daily backup, attachment verification and joint recovery
After=docker.service
[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /opt/eduk12-ops/current/cycle.py
TimeoutStartSec=7500
UMask=0077
StateDirectory=eduk12-ops
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
Nice=19
IOSchedulingClass=idle
CPUQuota=20%
MemoryMax=128M
TasksMax=32
