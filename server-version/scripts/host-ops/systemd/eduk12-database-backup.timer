[Unit]
Description=Daily eduK12 database and server configuration backup

[Timer]
# 03:20 Tokyo = 02:20 Beijing. Explicit timezone, independent of host settings.
OnCalendar=*-*-* 03:20:00 Asia/Tokyo
RandomizedDelaySec=120
Persistent=true
Unit=eduk12-database-backup.service

[Install]
WantedBy=timers.target
