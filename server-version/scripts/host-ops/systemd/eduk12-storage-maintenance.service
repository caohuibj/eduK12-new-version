[Unit]
Description=eduK12 bounded maintenance and inventory
After=docker.service
[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /opt/eduk12-ops/current/storage.py --apply
TimeoutStartSec=600
UMask=0077
StateDirectory=eduk12-ops
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/eduk12-ops /opt/eduk12-new/deploy /var/lib/eduk12-backups /var/lib/eduk12-attachments
Nice=19
IOSchedulingClass=idle
CPUQuota=30%
MemoryMax=256M
TasksMax=64
