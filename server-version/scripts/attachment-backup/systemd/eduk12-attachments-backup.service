[Unit]
Description=eduK12 attachment backup backup
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/eduk12-attachments/current/runner.py backup
TimeoutStartSec=45min
TimeoutStopSec=60s
Nice=19
IOSchedulingClass=idle
MemoryMax=192M
TasksMax=32
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/eduk12-attachments
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
