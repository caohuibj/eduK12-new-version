.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #f7f8fa 100%);
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(91, 192, 222, 0.2);
  border-top-color: #5bc0de;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.list-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 问卷卡片 - 优化版 */
.questionnaire-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(91, 192, 222, 0.08);
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.questionnaire-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #5bc0de, #4a9ec2);
  opacity: 0;
  transition: opacity 0.25s ease;
}

.questionnaire-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(91, 192, 222, 0.12);
}

.questionnaire-card:active::before {
  opacity: 1;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  letter-spacing: 0.5rpx;
}

.new-badge {
  background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(40, 167, 69, 0.3);
}

.card-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-info {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #888;
  background: #f8f9fa;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.info-icon {
  font-size: 26rpx;
}

.card-footer {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.status-tag.completed {
  background: linear-gradient(135deg, rgba(40, 167, 69, 0.1) 0%, rgba(32, 201, 151, 0.1) 100%);
  color: #28a745;
}

.status-tag.pending {
  background: linear-gradient(135deg, rgba(91, 192, 222, 0.15) 0%, rgba(74, 158, 194, 0.15) 100%);
  color: #5bc0de;
}

.status-tag.in-progress {
  background: linear-gradient(135deg, rgba(255, 193, 7, 0.15) 0%, rgba(212, 153, 7, 0.15) 100%);
  color: #d97706;
}

.status-icon {
  font-size: 24rpx;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  letter-spacing: 1rpx;
}
