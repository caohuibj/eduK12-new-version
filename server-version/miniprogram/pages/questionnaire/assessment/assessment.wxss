.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
  padding-bottom: 200rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #5bc0de;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.retry-btn {
  padding: 20rpx 60rpx;
  background: #5bc0de;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 整体进度 */
.overall-progress {
  background: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #666;
}

.scale-name {
  font-size: 24rpx;
  color: #5bc0de;
  font-weight: 500;
}

.progress-track {
  height: 8rpx;
  background: #e8e8e8;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5bc0de, #4a9ec2);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 当前量表进度 */
.scale-progress {
  background: #fff;
  padding: 20rpx 32rpx;
  margin-bottom: 24rpx;
}

.scale-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.scale-progress-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.scale-progress-count {
  font-size: 26rpx;
  color: #5bc0de;
  font-weight: 600;
}

.scale-progress-track {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.scale-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5bc0de, #4a9ec2);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 题目卡片 */
.question-card {
  background: #fff;
  margin: 0 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.question-header {
  margin-bottom: 24rpx;
}

.question-number {
  font-size: 24rpx;
  color: #999;
  background: #f5f7fa;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.question-content {
  margin-bottom: 40rpx;
}

.question-text {
  font-size: 34rpx;
  color: #1a1a1a;
  line-height: 1.6;
  font-weight: 500;
}

/* 选项 */
.options-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #f8f9fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.option-item.selected {
  background: rgba(91, 192, 222, 0.1);
  border-color: #5bc0de;
}

.option-item:active {
  transform: scale(0.98);
}

.option-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.option-item.selected .option-value {
  color: #5bc0de;
}

.option-label {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.option-item.selected .option-label {
  color: #5bc0de;
}

/* 导航按钮 */
.nav-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.nav-btn {
  min-width: 200rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.prev-btn {
  background: #f5f5f5;
  color: #666;
}

.prev-btn.disabled {
  opacity: 0.5;
}

.next-btn {
  background: linear-gradient(135deg, #5bc0de 0%, #4a9ec2 100%);
  color: #fff;
}

.submit-btn {
  background: linear-gradient(135deg, #28a745 0%, #20903a 100%);
  color: #fff;
  min-width: 280rpx;
}

/* 题目导航 */
.question-nav {
  background: #fff;
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.nav-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.nav-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.nav-toggle {
  font-size: 24rpx;
  color: #5bc0de;
}

.nav-grid {
  display: none;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.nav-grid.show {
  display: flex;
}

.nav-item {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.nav-item.answered {
  background: rgba(91, 192, 222, 0.15);
  color: #5bc0de;
}

.nav-item.current {
  background: #5bc0de;
  color: #fff;
  font-weight: 600;
}
