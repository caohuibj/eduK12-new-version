.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #f7f8fa 100%);
}

/* 用户头部 - 优化版 */
.user-header {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #5bc0de 0%, #4a9ec2 100%);
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.user-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 80%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  background: linear-gradient(135deg, #fff, #f0f7ff);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  position: relative;
}

.user-info {
  flex: 1;
  position: relative;
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.username {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 表单区域 - 优化版 */
.form-section, .settings-section {
  background: #fff;
  padding: 32rpx;
  margin: 0 24rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 24rpx;
  background: linear-gradient(180deg, #5bc0de, #4a9ec2);
  border-radius: 3rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.save-btn {
  width: 100%;
  background: linear-gradient(135deg, #5bc0de, #4a9ec2);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(91, 192, 222, 0.3);
}

.save-btn:active {
  transform: scale(0.98);
}

/* 菜单项 - 优化版 */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.25s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f8f9fa;
  margin: 0 -16rpx;
  padding: 28rpx 16rpx;
  border-radius: 12rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 退出登录区域 */
.logout-section {
  padding: 32rpx;
  margin-top: 16rpx;
}

.logout-btn {
  width: 100%;
  border: 2rpx solid #dc3545;
  color: #dc3545;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: #fff;
}

.logout-btn:active {
  background: rgba(220, 53, 69, 0.05);
}
