/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #f7f8fa 100%);
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(91, 192, 222, 0.2);
  border-top-color: #5bc0de;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 课程信息卡片 */
.course-info {
  background: linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
  padding: 32rpx;
  margin: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(91, 192, 222, 0.12);
}

.course-header {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.course-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #5bc0de 0%, #4a9ec2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-text {
  font-size: 40rpx;
}

.course-content {
  flex: 1;
}

.course-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.course-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.course-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

/* Tab 切换 */
.tabs-container {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tabs {
  display: flex;
  padding: 8rpx;
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
  position: relative;
  transition: all 0.3s ease;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  transition: color 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #5bc0de 0%, #4a9ec2 100%);
  box-shadow: 0 4rpx 12rpx rgba(91, 192, 222, 0.3);
}

.tab-item.active .tab-text {
  color: #fff;
  font-weight: 600;
}

/* 角标 */
.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.tab-item.active .tab-badge {
  background: rgba(255, 255, 255, 0.9);
  color: #5bc0de;
}

/* 列表容器 */
.list-container {
  padding: 24rpx;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 卡片样式 */
.item-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.item-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.item-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  line-height: 1.4;
}

.item-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-deadline {
  font-size: 24rpx;
  color: #999;
}

.item-deadline.overdue {
  color: #dc3545;
}

.item-meta {
  font-size: 24rpx;
  color: #999;
}

/* 新任务角标 */
.new-badge {
  background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 状态标签 */
.tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.tag-icon {
  font-size: 20rpx;
}

.tag-success {
  background: rgba(40, 167, 69, 0.1);
  color: #28a745;
}

.tag-warning {
  background: rgba(91, 192, 222, 0.1);
  color: #5bc0de;
}

.tag-primary {
  background: rgba(91, 192, 222, 0.15);
  color: #5bc0de;
}

.tag-disabled {
  background: rgba(153, 153, 153, 0.1);
  color: #999;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
