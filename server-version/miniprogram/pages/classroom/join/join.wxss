.container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 40rpx;
}

/* 加载中 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 错误提示 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin-top: 100rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.error-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.error-message {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

/* 输入课堂码 */
.input-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin-top: 100rpx;
}

.icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  background-color: #5bc0de;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.icon {
  font-size: 60rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.input-wrapper {
  width: 100%;
  margin-bottom: 40rpx;
}

.code-input {
  width: 100%;
  height: 88rpx;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  text-align: center;
  letter-spacing: 4rpx;
}

.btn-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  background-color: #5bc0de;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary[disabled] {
  background-color: #ccc;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  background-color: #fff;
  color: #5bc0de;
  border: 2rpx solid #5bc0de;
  border-radius: 12rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-full {
  width: 100%;
  margin-top: 40rpx;
}

/* 课堂信息 */
.classroom-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.classroom-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.classroom-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin: 20rpx 0 10rpx;
}

.classroom-code {
  font-size: 28rpx;
  color: #999;
}

.classroom-info {
  margin-bottom: 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.status-active {
  color: #52c41a;
}

.tip-container {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx;
  background-color: #e6f7ff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 32rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #1890ff;
}
