.container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 30rpx;
}

/* 等待题目 */
.waiting-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin-top: 100rpx;
}

.waiting-icon {
  font-size: 100rpx;
  margin-bottom: 40rpx;
}

.waiting-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.waiting-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

/* 答题已结束 */
.finished-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin-top: 100rpx;
}

.finished-icon {
  font-size: 100rpx;
  margin-bottom: 40rpx;
}

.finished-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 60rpx;
}

/* 倒计时 */
.countdown-container {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 30rpx;
  background-color: #e6f7ff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.countdown-warning {
  background-color: #fff1f0;
}

.countdown-label {
  font-size: 32rpx;
  color: #1890ff;
}

.countdown-warning .countdown-label {
  color: #ff4d4f;
}

.countdown-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
}

.countdown-warning .countdown-value {
  color: #ff4d4f;
}

/* 题目容器 */
.question-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.question-number {
  font-size: 32rpx;
  font-weight: bold;
  color: #5bc0de;
}

.question-type {
  font-size: 26rpx;
  color: #fff;
  background-color: #5bc0de;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.question-content {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
}

/* 选项容器 */
.options-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.option-item:last-child {
  margin-bottom: 0;
}

.option-selected {
  background-color: #e6f7ff;
  border-color: #5bc0de;
}

.option-disabled {
  opacity: 0.6;
}

.option-label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.option-check {
  font-size: 40rpx;
  color: #5bc0de;
  margin-left: 20rpx;
}

/* 提交按钮 */
.submit-container {
  margin-top: 40rpx;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  background-color: #5bc0de;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}

.submitted-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 30rpx;
  background-color: #f6ffed;
  border-radius: 12rpx;
}

.submitted-icon {
  font-size: 40rpx;
}

.submitted-text {
  font-size: 32rpx;
  color: #52c41a;
  font-weight: 500;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  background-color: #5bc0de;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}

.btn-exit {
  width: 100%;
  height: 88rpx;
  background-color: #fff;
  color: #999;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
}
