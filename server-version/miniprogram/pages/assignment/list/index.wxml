<view class="page-container">
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{assignments.length === 0}}" class="empty-container">
    <view class="empty-text">暂无作业</view>
  </view>

  <view wx:else class="assignment-list">
    <view 
      class="assignment-card" 
      wx:for="{{assignments}}" 
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onAssignmentTap"
    >
      <view class="assignment-title">{{item.title}}</view>
      <view class="assignment-course">{{item.course && item.course.title ? item.course.title : ''}}</view>
      <view class="assignment-footer">
        <text class="deadline">截止: {{item.deadline || '无截止时间'}}</text>
        <text class="tag tag-{{item.statusInfo.class}}">{{item.statusInfo.text}}</text>
      </view>
    </view>
  </view>
</view>
