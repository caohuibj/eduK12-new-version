.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 120rpx;
}

.checkin-header {
  background-color: var(--card-bg);
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.deadline {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.content-section, .images-section, .submitted-info {
  background-color: var(--card-bg);
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  box-sizing: border-box;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: var(--text-secondary);
}

.add-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.image-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
}

.submitted-time {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.media-section {
  background-color: var(--card-bg);
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.video-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.video-external {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: var(--bg-color);
  border-radius: var(--radius-sm);
}

.video-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--primary-color);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.video-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-color);
}

.video-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.video-link {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.video-player {
  width: 100%;
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-list .image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.view-others-section {
  padding: 0 32rpx 16rpx;
}

.others-section {
  background-color: var(--card-bg);
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.others-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.others-card {
  background-color: var(--bg-color);
  border-radius: var(--radius-sm);
  padding: 24rpx;
}

.others-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.others-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.others-info {
  flex: 1;
}

.others-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-color);
}

.others-time {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.others-content {
  font-size: 28rpx;
  color: var(--text-color);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.others-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.others-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
}

.others-empty {
  text-align: center;
  padding: 40rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: var(--card-bg);
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.submit-section .btn {
  width: 100%;
}

/* 过期提示 */
.expired-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 48rpx 32rpx;
  background-color: var(--card-bg);
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.expired-icon {
  font-size: 64rpx;
}

.expired-text {
  font-size: 32rpx;
  color: #dc3545;
  font-weight: 500;
}
