<view class="page-container">
  <view class="form-section">
    <view class="form-item">
      <view class="form-label">原密码</view>
      <view class="input-wrapper">
        <input 
          class="input" 
          type="{{showOldPassword ? 'text' : 'password'}}"
          placeholder="请输入原密码"
          value="{{oldPassword}}"
          bindinput="onOldPasswordInput"
        />
        <text class="toggle-btn" bindtap="toggleOldPassword">
          {{showOldPassword ? '隐藏' : '显示'}}
        </text>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">新密码</view>
      <view class="input-wrapper">
        <input 
          class="input" 
          type="{{showNewPassword ? 'text' : 'password'}}"
          placeholder="请输入新密码（至少6位）"
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
        />
        <text class="toggle-btn" bindtap="toggleNewPassword">
          {{showNewPassword ? '隐藏' : '显示'}}
        </text>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">确认新密码</view>
      <input 
        class="input" 
        type="password"
        placeholder="请再次输入新密码"
        value="{{confirmPassword}}"
        bindinput="onConfirmPasswordInput"
      />
    </view>
  </view>

  <view class="submit-section">
    <button class="btn btn-primary" bindtap="onSubmit" loading="{{submitting}}">
      确认修改
    </button>
  </view>
</view>
