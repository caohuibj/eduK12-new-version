      "dim": "extraversion"
    },
    {
      "code": "IPIP50-42",
      "zh": "我能感受到他人的情绪。",
      "en": "Feel others' emotions.",
      "reverse": false,
      "dim": "agreeableness"
    },
    {
      "code": "IPIP50-43",
      "zh": "我按日程安排做事。",
      "en": "Follow a schedule.",
