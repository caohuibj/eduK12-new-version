      "dim": "extraversion"
    },
    {
      "code": "IPIP50-32",
      "zh": "我并不怎么对他人感兴趣。",
      "en": "Am not really interested in others.",
      "reverse": true,
      "dim": "agreeableness"
    },
    {
      "code": "IPIP50-33",
      "zh": "我喜欢井然有序。",
