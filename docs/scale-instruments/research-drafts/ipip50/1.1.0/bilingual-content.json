      "reverse": true,
      "dim": "emotional_stability"
    },
    {
      "code": "IPIP50-35",
      "zh": "我理解事情很快。",
      "en": "Am quick to understand things.",
      "reverse": false,
      "dim": "intellect_imagination"
    },
    {
      "code": "IPIP50-36",
      "zh": "我不喜欢让别人注意到我。",
