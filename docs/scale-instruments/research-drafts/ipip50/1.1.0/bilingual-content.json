      "dim": "extraversion"
    },
    {
      "code": "IPIP50-27",
      "zh": "我心肠软。",
      "en": "Have a soft heart.",
      "reverse": false,
      "dim": "agreeableness"
    },
    {
      "code": "IPIP50-28",
      "zh": "我常忘记把东西放回它们应放的位置。",
      "en": "Often forget to put things back in their proper place.",
      "reverse": true,
      "dim": "conscientiousness"
    },
    {
      "code": "IPIP50-29",
      "zh": "我容易心烦。",
      "en": "Get upset easily.",
      "reverse": true,
      "dim": "emotional_stability"
    },
    {
      "code": "IPIP50-30",
      "zh": "我的想象力不太好。",
      "en": "Do not have a good imagination.",
      "reverse": true,
      "dim": "intellect_imagination"
    },
