  "items": [
    {
      "code": "IPIP50-01",
      "zh": "我是聚会中活跃气氛的人。",
      "en": "Am the life of the party.",
      "reverse": false,
      "dim": "extraversion"
    },
    {
      "code": "IPIP50-02",
      "zh": "我很少关心别人。",
      "en": "Feel little concern for others.",
      "reverse": true,
      "dim": "agreeableness"
    },
    {
      "code": "IPIP50-03",
      "zh": "我总是做好准备。",
      "en": "Am always prepared.",
      "reverse": false,
      "dim": "conscientiousness"
    },
    {
      "code": "IPIP50-04",
      "zh": "我容易感到压力很大。",
      "en": "Get stressed out easily.",
      "reverse": true,
      "dim": "emotional_stability"
    },
    {
      "code": "IPIP50-05",
      "zh": "我的词汇丰富。",
      "en": "Have a rich vocabulary.",
      "reverse": false,
      "dim": "intellect_imagination"
    },
    {
      "code": "IPIP50-06",
      "zh": "我的话不多。",
      "en": "Don't talk a lot.",
      "reverse": true,
      "dim": "extraversion"
    },
    {
      "code": "IPIP50-07",
      "zh": "我对他人感兴趣。",
      "en": "Am interested in people.",
      "reverse": false,
      "dim": "agreeableness"
    },
    {
      "code": "IPIP50-08",
      "zh": "我把自己的东西随处放。",
      "en": "Leave my belongings around.",
      "reverse": true,
      "dim": "conscientiousness"
    },
    {
      "code": "IPIP50-09",
      "zh": "我大多数时候都很放松。",
      "en": "Am relaxed most of the time.",
      "reverse": false,
      "dim": "emotional_stability"
    },
    {
      "code": "IPIP50-10",
      "zh": "我理解抽象概念有困难。",
      "en": "Have difficulty understanding abstract ideas.",
      "reverse": true,
      "dim": "intellect_imagination"
    },
    {
      "code": "IPIP50-11",
      "zh": "和他人在一起时，我感到自在。",
      "en": "Feel comfortable around people.",
      "reverse": false,
      "dim": "extraversion"
    },
    {
      "code": "IPIP50-12",
      "zh": "我会侮辱别人。",
      "en": "Insult people.",
      "reverse": true,
      "dim": "agreeableness"
    },
    {
      "code": "IPIP50-13",
      "zh": "我留意细节。",
      "en": "Pay attention to details.",
      "reverse": false,
      "dim": "conscientiousness"
    },
    {
      "code": "IPIP50-14",
      "zh": "我会为各种事情担忧。",
      "en": "Worry about things.",
      "reverse": true,
      "dim": "emotional_stability"
    },
    {
      "code": "IPIP50-15",
      "zh": "我的想象力很生动。",
      "en": "Have a vivid imagination.",
      "reverse": false,
      "dim": "intellect_imagination"
    },
    {
      "code": "IPIP50-16",
      "zh": "我保持低调，不让自己引人注目。",
      "en": "Keep in the background.",
      "reverse": true,
      "dim": "extraversion"
    },
    {
      "code": "IPIP50-17",
      "zh": "我体谅他人的感受。",
      "en": "Sympathize with others' feelings.",
      "reverse": false,
      "dim": "agreeableness"
    },
    {
      "code": "IPIP50-18",
      "zh": "我把事情弄得一团糟。",
      "en": "Make a mess of things.",
      "reverse": true,
      "dim": "conscientiousness"
    },
    {
      "code": "IPIP50-19",
      "zh": "我很少感到低落。",
      "en": "Seldom feel blue.",
      "reverse": false,
      "dim": "emotional_stability"
    },
    {
      "code": "IPIP50-20",
      "zh": "我对抽象概念不感兴趣。",
      "en": "Am not interested in abstract ideas.",
      "reverse": true,
      "dim": "intellect_imagination"
    },
    {
      "code": "IPIP50-21",
      "zh": "我主动开始交谈。",
      "en": "Start conversations.",
      "reverse": false,
      "dim": "extraversion"
    },
    {
      "code": "IPIP50-22",
      "zh": "我对别人的问题不感兴趣。",
