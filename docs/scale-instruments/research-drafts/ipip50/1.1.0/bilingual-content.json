    {
      "code": "IPIP50-44",
      "zh": "我容易烦躁。",
      "en": "Get irritated easily.",
      "reverse": true,
      "dim": "emotional_stability"
    },
    {
      "code": "IPIP50-45",
      "zh": "我会花时间反思事情。",
