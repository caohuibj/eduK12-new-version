      "code": "IPIP_NFC10_01",
      "zh": "我喜欢解决复杂的问题。",
      "en": "Like to solve complex problems.",
      "reverse": false,
      "dim": "need_for_cognition"
    },
    {
      "code": "IPIP_NFC10_02",
      "zh": "别人只需解释一次，我就能明白。",
      "en": "Need things explained only once.",
      "reverse": false,
      "dim": "need_for_cognition"
    },
    {
      "code": "IPIP_NFC10_03",
      "zh": "我能处理大量信息。",
      "en": "Can handle a lot of information.",
      "reverse": false,
      "dim": "need_for_cognition"
