    "items": [
      {
        "number": 1,
        "text": "我很善于识别我痛苦时的感受",
        "facet": "recognizing_suffering",
        "reverse": false
      },
      {
        "number": 2,
        "text": "我知道每个人都会在生命中的某些阶段经历痛苦",
        "facet": "understanding_universality",
        "reverse": false
      },
      {
        "number": 3,
        "text": "当我经历困难时，我会善待自己",
        "facet": "feeling_for_self",
        "reverse": false
      },
      {
        "number": 4,
        "text": "当我情绪低落时，我试着敞开心扉接受自己的感受，而不是回避它们",
        "facet": "tolerating_feelings",
        "reverse": false
      },
      {
        "number": 5,
        "text": "当我苦恼时，我尽量让自己感觉好一点，即使我对此无能为力",
        "facet": "acting_to_alleviate",
        "reverse": false
      },
      {
        "number": 6,
        "text": "我会注意到我正在经历的痛苦",
        "facet": "recognizing_suffering",
        "reverse": false
      },
      {
        "number": 7,
        "text": "我明白偶尔感到不安是人生常态",
        "facet": "understanding_universality",
        "reverse": false
      },
      {
        "number": 8,
        "text": "当我遭遇不幸时，我会关心自己",
        "facet": "feeling_for_self",
        "reverse": false
      },
      {
        "number": 9,
        "text": "我与自己的痛苦持联结，而不是让它压倒我。",
        "facet": "tolerating_feelings",
        "reverse": false
      },
      {
        "number": 10,
        "text": "遇到困难时，我会尽量照顾好自己",
        "facet": "acting_to_alleviate",
        "reverse": false
      },
      {
        "number": 11,
        "text": "我很快就注意到自己痛苦的早期迹象",
        "facet": "recognizing_suffering",
        "reverse": false
      },
      {
        "number": 12,
        "text": "我知道其他人也像我一样在生活中会经历挣扎",
        "facet": "understanding_universality",
        "reverse": false
      },
      {
        "number": 13,
        "text": "当我心烦意乱时，我试着调整我的感受",
        "facet": "feeling_for_self",
        "reverse": false
      },
      {
        "number": 14,
        "text": "我与自己的痛苦保持联结，而不是批判自己",
        "facet": "tolerating_feelings",
        "reverse": false
      },
      {
        "number": 15,
        "text": "当我感到不安时，我尽量做对自己最有利的事",
        "facet": "acting_to_alleviate",
        "reverse": false
      },
      {
        "number": 16,
        "text": "我能识别自己的痛苦迹象",
        "facet": "recognizing_suffering",
        "reverse": false
      },
      {
        "number": 17,
        "text": "我知道当生活中的事情进展不顺利时，我们都会感到痛苦",
        "facet": "understanding_universality",
        "reverse": false
      },
      {
        "number": 18,
        "text": "即使我对自己很失望，我也能在困境中善待自己",
        "facet": "feeling_for_self",
        "reverse": false
      },
      {
        "number": 19,
        "text": "当我心烦意乱时，我会让情绪顺其自然而不受它控制",
        "facet": "tolerating_feelings",
        "reverse": false
      },
      {
        "number": 20,
        "text": "当情绪低落时，我尽力照顾好自己",
        "facet": "acting_to_alleviate",
        "reverse": false
      }
    ]
  },
