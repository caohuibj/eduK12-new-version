+/** New picker discovery only. Recovery never enters this helper: its exact
+ * original selection is returned from the preparation and rechecked as pinned.
+ * A broad grant contributes only the resource currently required by this item. */
+async function discoverLicenses(tx:Tx,c:EducationAssessmentContext,resourceIds:string[],pinned:License[]=[]):Promise<License[]|null>{
+ const ids=[...new Set(resourceIds)].sort(),fixed=new Map(pinned.map(value=>[value.resourceId,value.grantId]))
+ if(ids.length>1000)fail('EDUCATION_ASSESSMENT_CANDIDATE_BOUND')
+ const rows=await tx.$queryRaw<Array<{id:string;resource_keys:string[]}>>(Prisma.sql`SELECT id,resource_keys FROM content_capability_grants
+  WHERE subject_id=${c.principal.userId} AND product=${c.product} AND scope_kind='ORGANIZATION'
+   AND scope_id=${c.organizationId} AND resource_kind='material' AND 'material.distribute'=ANY(capabilities)
+   AND resource_keys && ${ids}::text[] AND revoked_at IS NULL
+   AND valid_from<=(clock_timestamp() AT TIME ZONE 'UTC') AND expires_at>(clock_timestamp() AT TIME ZONE 'UTC')
+  ORDER BY id LIMIT 1001`)
+ if(rows.length>1000)fail('EDUCATION_ASSESSMENT_CANDIDATE_BOUND')
+ const licenses:License[]=[]
+ for(const resourceId of ids){
+  const options=fixed.has(resourceId)?[fixed.get(resourceId)!]:rows.filter(row=>row.resource_keys.includes(resourceId)).map(row=>row.id)
+  let accepted:License|undefined
+  for(const grantId of options){
+   try{
+    await assertEducationAssessmentDistribution(tx,{...c,actorId:c.principal.userId,resourceIds:[resourceId],selection:[{resourceId,grantId}]})
+    accepted={resourceId,grantId};break
+   }catch(error){if(!(error instanceof ContentAuthorityError))throw error}
+  }
+  if(!accepted)return null
+  licenses.push(accepted)
+ }
+ return licenses
+}
+export function pickerSourceUnavailable(error:unknown){
+ // Account contention must roll back the transaction, never masquerade as an
+ // unavailable candidate; database/unknown errors likewise propagate.
+ if(error instanceof Error&&'code'in error&&error.code==='EDUCATION_ASSESSMENT_AUTHORITY_BUSY')return false
+ if(error instanceof InstrumentFinalSubmitError)return error.code==='FORM_ANSWER_INVALID'&&error.statusCode===400
+ return error instanceof z.ZodError||error instanceof ContentReleaseError||error instanceof CompositeServiceError
+  ||error instanceof EducationAssessmentManagementError||error instanceof EducationAssessmentSourceError
+}
