  "items": [
    {
      "code": "IPIP_ATTENDING_EMOTIONS10_01",
      "english": "Think about the causes of my emotions.",
      "chinese": "我会思考自己产生情绪的原因。",
      "key": "positive",
      "conclusion": "与官方题序、键向和研究包对应，中文基本保留题意；待独立译审。"
    },
    {
      "code": "IPIP_ATTENDING_EMOTIONS10_02",
      "english": "Pay a lot of attention to my feelings.",
      "chinese": "我很关注自己的感受。",
      "key": "positive",
      "conclusion": "与官方题序、键向和研究包对应，中文基本保留题意；待独立译审。"
    },
    {
      "code": "IPIP_ATTENDING_EMOTIONS10_03",
      "english": "Am usually aware of the way that I'm feeling.",
      "chinese": "我通常能觉察到自己当下的感受。",
      "key": "positive",
      "conclusion": "与官方题序、键向和研究包对应，中文基本保留题意；待独立译审。 中文“当下”较原文显式限定当前时刻，作为工作译稿记录供人工审阅，不静默修改。"
    },
    {
      "code": "IPIP_ATTENDING_EMOTIONS10_04",
      "english": "Notice my emotions.",
      "chinese": "我会留意自己的情绪。",
      "key": "positive",
      "conclusion": "与官方题序、键向和研究包对应，中文基本保留题意；待独立译审。"
    },
    {
      "code": "IPIP_ATTENDING_EMOTIONS10_05",
      "english": "Often stop to analyze how I'm feeling.",
      "chinese": "我常常停下来分析自己的感受。",
      "key": "positive",
      "conclusion": "与官方题序、键向和研究包对应，中文基本保留题意；待独立译审。"
    },
    {
      "code": "IPIP_ATTENDING_EMOTIONS10_06",
      "english": "Rarely think about how I feel.",
      "chinese": "我很少思考自己有什么感受。",
      "key": "negative",
      "conclusion": "与官方题序、键向和研究包对应，中文基本保留题意；待独立译审。"
    },
    {
      "code": "IPIP_ATTENDING_EMOTIONS10_07",
      "english": "Rarely analyze my emotions.",
      "chinese": "我很少分析自己的情绪。",
      "key": "negative",
      "conclusion": "与官方题序、键向和研究包对应，中文基本保留题意；待独立译审。"
    },
    {
      "code": "IPIP_ATTENDING_EMOTIONS10_08",
      "english": "Am not in touch with my feelings.",
      "chinese": "我不太能觉察到自己的感受。",
      "key": "negative",
      "conclusion": "与官方题序、键向和研究包对应，中文基本保留题意；待独立译审。 中文“不太能觉察”对原文“不与感受相接触”有解释性和程度语气，供独立译审，不静默改题。"
    },
    {
      "code": "IPIP_ATTENDING_EMOTIONS10_09",
      "english": "Often ignore my feelings.",
      "chinese": "我经常忽略自己的感受。",
      "key": "negative",
      "conclusion": "与官方题序、键向和研究包对应，中文基本保留题意；待独立译审。"
    },
    {
      "code": "IPIP_ATTENDING_EMOTIONS10_10",
      "english": "Rarely notice my emotional reactions.",
      "chinese": "我很少留意自己的情绪反应。",
      "key": "negative",
      "conclusion": "与官方题序、键向和研究包对应，中文基本保留题意；待独立译审。"
    }
