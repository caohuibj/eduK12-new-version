prisma:query SELECT c.id,c.ended_at AS "endedAt"
        FROM courses c JOIN users u ON u.id=$1
        WHERE c.id=$2 AND c.course_type='TRAINING_COURSE' AND NOT c.is_library AND c.status::text='PUBLISHED'
        AND 
  u.account_domain IN ('LEGACY','TRAINING') AND u.is_active AND NOT u.is_frozen AND NOT u.must_change_password
  AND (u.expires_at IS NULL OR u.expires_at>statement_timestamp())
  AND (EXISTS(SELECT 1 FROM admin_entry_grants g WHERE g.user_id=u.id AND g.entry='TRAINING' AND g.revoked_at IS NULL)
    OR (u.role::text='TEACHER' AND u.teacher_approved AND c.creator_id=u.id)) FOR SHARE OF c,u

