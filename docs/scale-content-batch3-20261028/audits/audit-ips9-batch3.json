      "items": [
        {
          "number": 1,
          "code": "IPS_01",
          "english": "I put things off so long that my well-being or efficiency unnecessarily suffers",
          "published_chinese": "我把事情拖得太久, 以至于我的幸福感或效率受到了不必要的负面影响",
          "runtime": "我把事情拖得太久, 以至于我的幸福感或效率受到了不必要的负面影响",
          "exact": true,
          "transform": "identity"
        },
        {
          "number": 2,
          "code": "IPS_02",
          "english": "If there is something I should do, I get to it before attending to lesser tasks",
          "published_chinese": "如果有我该做的事情, 我会先去做这件事, 然后再去处理其它次要的任务",
          "runtime": "如果有我该做的事情, 我会先去做这件事, 然后再去处理其它次要的任务",
          "exact": true,
          "transform": "reverse"
        },
        {
          "number": 3,
          "code": "IPS_03",
          "english": "My life would be better if I did some activities or tasks earlier",
          "published_chinese": "如果我早点儿开始做某些活动或任务的话, 我的生活会更好",
          "runtime": "如果我早点儿开始做某些活动或任务的话, 我的生活会更好",
          "exact": true,
          "transform": "identity"
        },
        {
          "number": 4,
          "code": "IPS_04",
          "english": "When I should be doing one thing, I will do another",
          "published_chinese": "当我应该做某件事情时, 我反而会去做另一件事",
          "runtime": "当我应该做某件事情时, 我反而会去做另一件事",
          "exact": true,
          "transform": "identity"
        },
        {
          "number": 5,
          "code": "IPS_05",
          "english": "At the end of the day, I know I could have spent the time better",
          "published_chinese": "回顾当天, 我知道我本可以更好地使用我的时间",
          "runtime": "回顾当天, 我知道我本可以更好地使用我的时间",
          "exact": true,
          "transform": "identity"
        },
        {
          "number": 6,
          "code": "IPS_06",
          "english": "I spend my time wisely",
          "published_chinese": "我明智地利用我的时间",
          "runtime": "我明智地利用我的时间",
          "exact": true,
