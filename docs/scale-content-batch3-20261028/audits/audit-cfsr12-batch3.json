  "items": [
    {
      "code": "CFSR_01",
      "english": "I can stop using a coping strategy that has made the situation worse.",
      "chinese": "如果一种应对方式让情况变得更糟，我能够停止使用它。",
      "dimension": "abandonment",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    },
    {
      "code": "CFSR_02",
      "english": "I can stop using a failed coping strategy.",
      "chinese": "如果某种应对方式已经失败，我能够停止使用它。",
      "dimension": "abandonment",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    },
    {
      "code": "CFSR_03",
      "english": "I do not repeat using a coping strategy that made the situation worse.",
      "chinese": "我不会反复使用曾让情况变得更糟的应对方式。",
      "dimension": "abandonment",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    },
    {
      "code": "CFSR_04",
      "english": "I can stop using a coping strategy that has been ineffective.",
      "chinese": "如果一种应对方式没有效果，我能够停止使用它。",
      "dimension": "abandonment",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    },
    {
      "code": "CFSR_05",
      "english": "If the situation has not improved, I consider a different coping strategy.",
      "chinese": "如果情况没有改善，我会考虑换一种应对方式。",
      "dimension": "recoping",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    },
    {
      "code": "CFSR_06",
      "english": "If I did not cope well, I use an alternative coping strategy.",
      "chinese": "如果之前应对得不好，我会使用另一种应对方式。",
      "dimension": "recoping",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    },
    {
      "code": "CFSR_07",
      "english": "Even if the stressful situation has worsened, I can cope by using another strategy.",
      "chinese": "即使压力情境变得更糟，我也能换一种方式来应对。",
      "dimension": "recoping",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    },
    {
      "code": "CFSR_08",
      "english": "Even if I fail to cope with stress, I can come up with a new coping strategy.",
      "chinese": "即使没能应对好压力，我也能够想出新的应对办法。",
      "dimension": "recoping",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    },
    {
      "code": "CFSR_09",
      "english": "I know which coping strategies are effective and which strategies are ineffective.",
      "chinese": "我知道哪些应对方式有效，哪些没有效果。",
      "dimension": "metacoping",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    },
    {
      "code": "CFSR_10",
      "english": "I know if a coping strategy has been successful or unsuccessful.",
      "chinese": "我能判断一种应对方式是否成功。",
      "dimension": "metacoping",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    },
    {
      "code": "CFSR_11",
      "english": "I cope with stress by establishing clear objectives.",
      "chinese": "我通过确立清晰的目标来应对压力。",
      "dimension": "metacoping",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    },
    {
      "code": "CFSR_12",
      "english": "I can grasp if a coping strategy that I have used has been working well.",
      "chinese": "我能够判断自己用过的应对方式是否起了作用。",
      "dimension": "metacoping",
      "key": "identity",
      "conclusion": "与作者论文Table 1英文呈现及1.0.1双语记录对应；原研究施测为日语，独立中文尚待译审。"
    }
