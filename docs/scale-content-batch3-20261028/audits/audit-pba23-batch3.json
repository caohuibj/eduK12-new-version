  "three_parts": {
    "items_instruction": {
      "items": [
        {
          "number": 1,
          "code": "EX1",
          "english": "I feel completely run down by my role as a parent",
          "chinese": "作为父母，我感到自己已经完全筋疲力尽。",
          "runtime": "下面的问题关注你作为父母的感受，而不是评价孩子。请根据自己的实际体验，选择每种感受出现的频率。没有对错答案，不愿作答时可以暂停或退出。爱孩子和感到疲惫可以同时存在。\n\n作为父母，我感到自己已经完全筋疲力尽。",
          "transform": "identity",
          "review": "与固定英中材料相符；独立中文工作译稿待人工译审。"
        },
        {
          "number": 2,
          "code": "EX2",
          "english": "I have the sense that I'm really worn out as a parent",
          "chinese": "我感觉自己作为父母真的已经累垮了。",
          "runtime": "我感觉自己作为父母真的已经累垮了。",
          "transform": "identity",
          "review": "与固定英中材料相符；独立中文工作译稿待人工译审。"
        },
        {
          "number": 3,
          "code": "EX3",
          "english": "I'm so tired out by my role as a parent that sleeping doesn't seem like enough",
          "chinese": "做父母让我累得似乎连睡觉都不足以恢复过来。",
          "runtime": "做父母让我累得似乎连睡觉都不足以恢复过来。",
          "transform": "identity",
          "review": "与固定英中材料相符；独立中文工作译稿待人工译审。"
        },
        {
          "number": 4,
          "code": "EX4",
          "english": "When I get up in the morning and have to face another day with my child(ren), I feel exhausted before I've even started",
          "chinese": "早上起床，想到又要和孩子度过一天，我还没开始就已经觉得精疲力尽了。",
          "runtime": "早上起床，想到又要和孩子度过一天，我还没开始就已经觉得精疲力尽了。",
          "transform": "identity",
          "review": "与固定英中材料相符；独立中文工作译稿待人工译审。"
        },
        {
          "number": 5,
          "code": "EX5",
          "english": "I find it exhausting just thinking of everything I have to do for my child(ren)",
          "chinese": "只要想到要为孩子做的所有事情，我就觉得疲惫不堪。",
          "runtime": "只要想到要为孩子做的所有事情，我就觉得疲惫不堪。",
          "transform": "identity",
          "review": "与固定英中材料相符；独立中文工作译稿待人工译审。"
        },
        {
          "number": 6,
          "code": "EX6",
          "english": "I have zero energy for looking after my child(ren)",
          "chinese": "我一点照顾孩子的精力都没有了。",
          "runtime": "我一点照顾孩子的精力都没有了。",
          "transform": "identity",
          "review": "与固定英中材料相符；独立中文工作译稿待人工译审。"
        },
        {
          "number": 7,
          "code": "EX7",
          "english": "My role as a parent uses up all my resources",
          "chinese": "做父母这件事耗尽了我所有可以调动的资源。",
          "runtime": "做父母这件事耗尽了我所有可以调动的资源。",
