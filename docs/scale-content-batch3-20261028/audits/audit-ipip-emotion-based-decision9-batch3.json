  "items": [
    {
      "code": "IPIP_EMOTION_BASED_DECISION9_01",
      "english": "Listen to my feelings when making important decisions.",
      "chinese": "做重要决定时，我会听从自己的感受。",
      "key": "positive",
      "conclusion": "官方原文、顺序、归属与键向匹配；中文工作译稿基本保留意思，待独立译审。 “听从”相较 listen to 有较强服从意味，提交独立译审，不静默改题。"
    },
    {
      "code": "IPIP_EMOTION_BASED_DECISION9_02",
      "english": "Base my goals in life on inspiration, rather than logic.",
      "chinese": "我设定人生目标时，依据的是灵感，而不是逻辑。",
      "key": "positive",
      "conclusion": "官方原文、顺序、归属与键向匹配；中文工作译稿基本保留意思，待独立译审。"
    },
    {
      "code": "IPIP_EMOTION_BASED_DECISION9_03",
      "english": "Plan my life based on how I feel.",
      "chinese": "我会根据自己的感受规划生活。",
      "key": "positive",
      "conclusion": "官方原文、顺序、归属与键向匹配；中文工作译稿基本保留意思，待独立译审。"
    },
    {
      "code": "IPIP_EMOTION_BASED_DECISION9_04",
      "english": "Believe emotions give direction to life.",
      "chinese": "我相信情绪能为生活指引方向。",
      "key": "positive",
      "conclusion": "官方原文、顺序、归属与键向匹配；中文工作译稿基本保留意思，待独立译审。"
    },
    {
      "code": "IPIP_EMOTION_BASED_DECISION9_05",
      "english": "Listen to my heart rather than my brain.",
      "chinese": "相比理性思考，我更听从内心的感受。",
      "key": "positive",
      "conclusion": "官方原文、顺序、归属与键向匹配；中文工作译稿基本保留意思，待独立译审。 heart/brain 译为内心感受/理性思考是对比性意译，供独立译审。"
    },
    {
      "code": "IPIP_EMOTION_BASED_DECISION9_06",
      "english": "Plan my life logically.",
      "chinese": "我会按照逻辑规划自己的生活。",
      "key": "negative",
      "conclusion": "官方原文、顺序、归属与键向匹配；中文工作译稿基本保留意思，待独立译审。"
    },
    {
      "code": "IPIP_EMOTION_BASED_DECISION9_07",
      "english": "Believe important decisions should be based on logical reasoning.",
      "chinese": "我认为重要决定应当以逻辑推理为依据。",
      "key": "negative",
      "conclusion": "官方原文、顺序、归属与键向匹配；中文工作译稿基本保留意思，待独立译审。"
    },
    {
      "code": "IPIP_EMOTION_BASED_DECISION9_08",
      "english": "Listen to my brain rather than my heart.",
      "chinese": "相比内心感受，我更听从理性思考。",
      "key": "negative",
      "conclusion": "官方原文、顺序、归属与键向匹配；中文工作译稿基本保留意思，待独立译审。 heart/brain 译为内心感受/理性思考是对比性意译，供独立译审。"
    },
    {
      "code": "IPIP_EMOTION_BASED_DECISION9_09",
      "english": "Make decisions based on facts, not feelings.",
      "chinese": "我依据事实而不是感受做决定。",
      "key": "negative",
      "conclusion": "官方原文、顺序、归属与键向匹配；中文工作译稿基本保留意思，待独立译审。"
    }
  ],
  "threePartConclusions": {
    "content": "九题按官方当前情绪导向决策分量表顺序，01–05正向、06–09反向一致；五点符合度对应官方五锚点，中点不等于不知道。官方表当前9题，括号10为优化前题数，不混淆。题01听从和05/08心脑意译供独立译审，不擅改。",
    "scoring": "每题1–5，正向x、反向6−x，9题权重均为1，求和9–45；无均分或分母。所有9题必答、不插补是项目选择，非官方缺失规则。无经验分档和运行参考：references=[]，referencePolicy none；英文女性N432 alpha .73、男性N317 alpha .67仅原英文统计，不外推本中文版或个体精确度。",
    "report": "version 1.0.0、zh-CN、ADULT_SELF/student技术角色，非儿童适用；score_only、higher_is_more、无bands和常模阈值。方向清楚，反思并列事实及感受、行动具体，明确不是决策能力判断，无须强改报告正文。score.description目前英文，公开结果可透传；catalog.construct.constructDefinition也为英文且可作量表描述，影响中文受众，可做等义本地化。"
  },
