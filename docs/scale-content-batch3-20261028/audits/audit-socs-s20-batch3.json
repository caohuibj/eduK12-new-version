        },
        {
          "number": 17,
          "code": "SOCSS_17",
          "published_text": "我知道当生活中的事情进展不顺利时，我们都会感到痛苦",
          "runtime": "我知道当生活中的事情进展不顺利时，我们都会感到痛苦",
