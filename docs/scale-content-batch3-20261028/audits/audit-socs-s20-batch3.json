          "facet": "recognizing_suffering",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 2,
          "code": "SOCSS_02",
          "published_text": "我知道每个人都会在生命中的某些阶段经历痛苦",
          "runtime": "我知道每个人都会在生命中的某些阶段经历痛苦",
          "exact": true,
          "facet": "understanding_universality",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 3,
          "code": "SOCSS_03",
          "published_text": "当我经历困难时，我会善待自己",
          "runtime": "当我经历困难时，我会善待自己",
          "exact": true,
          "facet": "feeling_for_self",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 4,
          "code": "SOCSS_04",
          "published_text": "当我情绪低落时，我试着敞开心扉接受自己的感受，而不是回避它们",
          "runtime": "当我情绪低落时，我试着敞开心扉接受自己的感受，而不是回避它们",
          "exact": true,
          "facet": "tolerating_feelings",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 5,
          "code": "SOCSS_05",
          "published_text": "当我苦恼时，我尽量让自己感觉好一点，即使我对此无能为力",
          "runtime": "当我苦恼时，我尽量让自己感觉好一点，即使我对此无能为力",
          "exact": true,
          "facet": "acting_to_alleviate",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 6,
          "code": "SOCSS_06",
          "published_text": "我会注意到我正在经历的痛苦",
          "runtime": "我会注意到我正在经历的痛苦",
          "exact": true,
          "facet": "recognizing_suffering",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 7,
          "code": "SOCSS_07",
          "published_text": "我明白偶尔感到不安是人生常态",
          "runtime": "我明白偶尔感到不安是人生常态",
          "exact": true,
          "facet": "understanding_universality",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 8,
          "code": "SOCSS_08",
          "published_text": "当我遭遇不幸时，我会关心自己",
          "runtime": "当我遭遇不幸时，我会关心自己",
          "exact": true,
          "facet": "feeling_for_self",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 9,
          "code": "SOCSS_09",
          "published_text": "我与自己的痛苦持联结，而不是让它压倒我。",
          "runtime": "我与自己的痛苦持联结，而不是让它压倒我。",
          "exact": true,
          "facet": "tolerating_feelings",
          "transform": "identity",
          "review": "固定已发表题文“持联结”疑似缺字；保留来源证据，若修为“保持联结”须协调版本。"
        },
        {
          "number": 10,
          "code": "SOCSS_10",
          "published_text": "遇到困难时，我会尽量照顾好自己",
          "runtime": "遇到困难时，我会尽量照顾好自己",
          "exact": true,
          "facet": "acting_to_alleviate",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 11,
          "code": "SOCSS_11",
          "published_text": "我很快就注意到自己痛苦的早期迹象",
          "runtime": "我很快就注意到自己痛苦的早期迹象",
          "exact": true,
          "facet": "recognizing_suffering",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 12,
          "code": "SOCSS_12",
          "published_text": "我知道其他人也像我一样在生活中会经历挣扎",
          "runtime": "我知道其他人也像我一样在生活中会经历挣扎",
          "exact": true,
          "facet": "understanding_universality",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 13,
          "code": "SOCSS_13",
          "published_text": "当我心烦意乱时，我试着调整我的感受",
          "runtime": "当我心烦意乱时，我试着调整我的感受",
          "exact": true,
          "facet": "feeling_for_self",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 14,
          "code": "SOCSS_14",
          "published_text": "我与自己的痛苦保持联结，而不是批判自己",
          "runtime": "我与自己的痛苦保持联结，而不是批判自己",
          "exact": true,
