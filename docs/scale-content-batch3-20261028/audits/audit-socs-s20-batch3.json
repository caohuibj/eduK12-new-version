          "facet": "acting_to_alleviate",
          "transform": "identity",
          "review": "与固定2023中文材料逐题对应；未冒称平台新译。"
        },
        {
          "number": 16,
          "code": "SOCSS_16",
          "published_text": "我能识别自己的痛苦迹象",
