  },
  "items": [
    {
      "code": "FFMQ15_01",
      "english": "When I take a shower or a bath, I stay alert to the sensations of water on my body.",
      "chinese": "洗澡或泡澡时，我会留意水接触身体的感觉。",
      "facet": "observe",
      "reverse": false,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_02",
      "english": "I’m good at finding words to describe my feelings.",
      "chinese": "我很会找到词语来描述自己的感受。",
      "facet": "describe",
      "reverse": false,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_03",
      "english": "I don’t pay attention to what I’m doing because I’m daydreaming, worrying, or otherwise distracted.",
      "chinese": "因为在做白日梦、担心事情或被其他事分心，我没有注意自己正在做什么。",
      "facet": "act_aware",
      "reverse": true,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_04",
      "english": "I believe some of my thoughts are abnormal or bad and I shouldn’t think that way.",
      "chinese": "我认为自己的一些想法不正常或不好，觉得不该那样想。",
      "facet": "nonjudge",
      "reverse": true,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_05",
      "english": "When I have distressing thoughts or images, I “step back” and am aware of the thought or image without getting taken over by it.",
      "chinese": "当出现令人苦恼的想法或画面时，我会“退后一步”，觉察它们，而不被它们带着走。",
      "facet": "nonreact",
      "reverse": false,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_06",
      "english": "I notice how foods and drinks affect my thoughts, bodily sensations, and emotions.",
      "chinese": "我会注意食物和饮料怎样影响自己的想法、身体感觉和情绪。",
      "facet": "observe",
      "reverse": false,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_07",
      "english": "I have trouble thinking of the right words to express how I feel about things.",
      "chinese": "我很难想到合适的词语，来表达自己对事情的感受。",
      "facet": "describe",
      "reverse": true,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_08",
      "english": "I do jobs or tasks automatically without being aware of what I’m doing.",
      "chinese": "我会自动地做事或完成任务，却没有意识到自己正在做什么。",
      "facet": "act_aware",
      "reverse": true,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_09",
      "english": "I think some of my emotions are bad or inappropriate and I shouldn’t feel them.",
      "chinese": "我认为自己的某些情绪不好或不合适，觉得不该有这些感受。",
      "facet": "nonjudge",
      "reverse": true,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_10",
      "english": "When I have distressing thoughts or images I am able just to notice them without reacting.",
      "chinese": "当出现令人苦恼的想法或画面时，我能够只是注意到它们，而不作出反应。",
      "facet": "nonreact",
      "reverse": false,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_11",
      "english": "I pay attention to sensations, such as the wind in my hair or sun on my face.",
      "chinese": "我会留意一些感觉，比如风吹动头发，或阳光照在脸上的感觉。",
      "facet": "observe",
      "reverse": false,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_12",
      "english": "Even when I’m feeling terribly upset I can find a way to put it into words.",
      "chinese": "即使心烦意乱，我也能找到用语言表达感受的方式。",
      "facet": "describe",
      "reverse": false,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。 原文terribly程度在中文不明显，留待译审，不静默改题。"
    },
    {
      "code": "FFMQ15_13",
      "english": "I find myself doing things without paying attention.",
      "chinese": "我发现自己做事时没有留意。",
      "facet": "act_aware",
      "reverse": true,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_14",
      "english": "I tell myself I shouldn’t be feeling the way I’m feeling.",
      "chinese": "我会告诉自己，不该有现在这样的感受。",
      "facet": "nonjudge",
      "reverse": true,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    },
    {
      "code": "FFMQ15_15",
      "english": "When I have distressing thoughts or images I just notice them and let them go.",
      "chinese": "当出现令人苦恼的想法或画面时，我只是注意到它们，然后让它们过去。",
      "facet": "nonreact",
      "reverse": false,
      "conclusion": "与作者2018题本及固定双语映射一致，中文待专家译审。"
    }
  ],
  "threePartConclusions": {
    "content": "15题顺序、5级频率与作者题本相符，反向03/04/07/08/09/13/14；12题terribly强度在中文不明显，需独立译审。",
    "scoring": "五维各3题求和3–15；observe 01/06/11、describe 02/07/12、act_aware 03/08/13、nonjudge 04/09/14、nonreact 05/10/15，反向6−x，无总分；每维完整与不完整总体不解释是项目政策，无阈值。1.0.1修正旧版统一称三题反向的说明，计分1.0.1，保留1.0.0历史。",
    "report": "report1.0.0、成人SELF/student技术角色，五维自然反思和可选行动，不能判断疗效或能力，没有经验分档，沿用。"
  },
  "instruction": {
    "text": "请根据平时的情况，选择下面每句话有多符合你。选项从“从不或极少符合”到“非常经常或总是符合”。例如，经常符合可选4，有时符合可选3。没有对错，请按自己的实际情况作答。",
