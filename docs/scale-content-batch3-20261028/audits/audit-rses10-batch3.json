  "threePartConclusions": {
    "content": "按PhenX顺序十题，中文工作译稿与源英语和运行时基本对应；正向1/2/4/6/7，反向3/5/8/9/10。四点同意选项0–3，与1–4或另一顺序版不可混用；第8题语义保留反向，需译审而非自行改键。",
    "scoring": "单总分，正向原值、反向3−x，等权求和0–30；缺任一complete_required为项目政策，无插补或均分分母。无经验证中国常模/临床界值或通用分档，referencePolicy none。",
    "report": "报告1.0.1方向正确，解释为自述而非客观价值，具体建议聚焦具体事件和真实的小事实，不诊断或排名。成人自评，student是技术角色；instrument/scoring/localization=1.0.0，report=1.0.1。"
  },
  "items": [
    {
      "number": 1,
      "itemCode": "RSES10_01",
      "en": "I feel that I'm a person of worth, at least on an equal plane with others.",
      "zh": "我觉得自己是一个有价值的人，至少与其他人同样有价值。",
      "key": "positive",
      "assessment": "固定双语与运行时一致，含义基本对应；待译审。"
    },
    {
      "number": 2,
      "itemCode": "RSES10_02",
      "en": "I feel that I have a number of good qualities.",
      "zh": "我觉得自己有不少好的品质。",
      "key": "positive",
      "assessment": "固定双语与运行时一致，含义基本对应；待译审。"
    },
    {
      "number": 3,
      "itemCode": "RSES10_03",
      "en": "All in all, I am inclined to feel that I am a failure.",
      "zh": "总的来说，我倾向于觉得自己是个失败者。",
      "key": "reverse",
      "assessment": "固定双语与运行时一致，含义基本对应；待译审。"
    },
    {
      "number": 4,
      "itemCode": "RSES10_04",
      "en": "I am able to do things as well as most other people.",
      "zh": "我做事情能和大多数其他人做得一样好。",
      "key": "positive",
      "assessment": "固定双语与运行时一致，含义基本对应；待译审。"
    },
    {
      "number": 5,
      "itemCode": "RSES10_05",
      "en": "I feel I do not have much to be proud of.",
      "zh": "我觉得自己没有多少值得自豪的地方。",
      "key": "reverse",
      "assessment": "固定双语与运行时一致，含义基本对应；待译审。"
    },
    {
      "number": 6,
      "itemCode": "RSES10_06",
      "en": "I take a positive attitude toward myself.",
      "zh": "我对自己持积极的态度。",
      "key": "positive",
      "assessment": "固定双语与运行时一致，含义基本对应；待译审。"
    },
    {
      "number": 7,
      "itemCode": "RSES10_07",
      "en": "On the whole, I am satisfied with myself.",
      "zh": "总体而言，我对自己感到满意。",
      "key": "positive",
      "assessment": "固定双语与运行时一致，含义基本对应；待译审。"
    },
    {
      "number": 8,
      "itemCode": "RSES10_08",
      "en": "I wish I could have more respect for myself.",
      "zh": "我希望自己能更尊重自己一些。",
      "key": "reverse",
      "assessment": "固定双语与运行时一致，含义基本对应；待译审。"
    },
    {
      "number": 9,
      "itemCode": "RSES10_09",
      "en": "I certainly feel useless at times.",
      "zh": "有时候，我确实觉得自己没有用。",
      "key": "reverse",
      "assessment": "固定双语与运行时一致，含义基本对应；待译审。"
    },
    {
      "number": 10,
      "itemCode": "RSES10_10",
      "en": "At times I think I am no good at all.",
      "zh": "有时候，我觉得自己一无是处。",
