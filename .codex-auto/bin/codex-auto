#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
env_file="$project_root/.codex-auto/.env"
runtime="$project_root/.codex-auto/runtime/bin/codex-auto"

if [ -f "$env_file" ]; then
  set -a
  . "$env_file"
  set +a
fi

if [ ! -x "$runtime" ]; then
  echo "codex-auto project runtime is missing: $runtime" >&2
  echo "Install it with the command in docs/CODEX_AUTO_LOCAL_WORKFLOW.md." >&2
  exit 2
fi

exec "$runtime" "$@"
